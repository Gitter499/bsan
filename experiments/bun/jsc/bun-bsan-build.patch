diff --git a/scripts/build/bsan.ts b/scripts/build/bsan.ts
new file mode 100644
index 00000000..b7dd360a
--- /dev/null
+++ b/scripts/build/bsan.ts
@@ -0,0 +1,69 @@
+/**
+ * BorrowSanitizer (BSan) instrumentation of the Rust half of bun.
+ * Enabled with BUN_BSAN=1 (local experiment, not upstream). Mirrors what
+ * cargo-bsan injects (bsan/cargo-bsan/src/phases.rs): BSan rustflags +
+ * the LLVM pass plugin for every target Rust unit (std included, since bun
+ * already builds std with -Zbuild-std), and the two runtime archives in the
+ * final link. C/C++ stays uninstrumented. Requires asan=off (the two
+ * sanitizer runtimes conflict) and no UBSan.
+ */
+export const bsanEnabled = process.env.BUN_BSAN === "1";
+const lib = process.env.BSAN_LIB_DIR ?? "/root/.rustup/toolchains/bsan/lib";
+const debuginfo = process.env.BSAN_RUST_DEBUGINFO ?? "1";
+
+export function bsanRustflags(): string[] {
+  if (!bsanEnabled) return [];
+  return [
+    "--cfg=bsan",
+    "--check-cfg=cfg(bsan)",
+    "-Copt-level=0",
+    "-Zmir-opt-level=0",
+    "-Zcodegen-emit-retag",
+    "-Cforce-frame-pointers=yes",
+    "-Zmir-preserve-ub",
+    "-Zinline-llvm=no",
+    `-Cdebuginfo=${debuginfo}`,
+    "-Zmir-enable-passes=-CheckAlignment,-CheckNull,-CheckEnums",
+    `-Zllvm-plugins=${lib}/libbsan_plugin.so`,
+    // The bsan toolchain is a newer nightly than rust-toolchain.toml pins; don't let new lints
+    // (workspace has warnings=deny) fail the build.
+    "--cap-lints=warn",
+  ];
+}
+
+export function bsanLinkFlags(): string[] {
+  if (!bsanEnabled) return [];
+  return [
+    `-L${lib}`,
+    "-Wl,--whole-archive",
+    `${lib}/libclang_rt.bsan-x86_64.a`,
+    "-Wl,--no-whole-archive",
+    `${lib}/libbsan_rt.a`,
+    "-Wl,-u,__bsan_preinit_anchor",
+    "-Wl,--push-state,--no-as-needed",
+    ...["pthread", "rt", "m", "dl", "resolv", "c"].map(l => `-l${l}`),
+    "-Wl,--pop-state",
+  ];
+}
+
+/**
+ * Crates compiled WITHOUT the BSan pass (comma list in BSAN_SKIP_CRATES, crate target names). Used for crates whose
+ * instrumented O0 codegen does not fit in this machine's memory (e.g. bun_css peaks at >13 GB in one CGU). They
+ * keep --cfg=bsan so allocator selection stays consistent; calls into/out of them behave like calls to C.
+ */
+const skipCrates = new Set((process.env.BSAN_SKIP_CRATES ?? "").split(",").map(s => s.trim().replace(/-/g, "_")).filter(Boolean));
+const instrumentOnly = new Set(["-Zcodegen-emit-retag", "-Zmir-preserve-ub", "-Zinline-llvm=no", "-Zmir-opt-level=0",
+  "-Zmir-enable-passes=-CheckAlignment,-CheckNull,-CheckEnums"]);
+/**
+ * Crates compiled WITH the BSan pass (provenance propagation, OOB/UAF checks) but WITHOUT retags
+ * (BSAN_NORETAG_CRATES): no Tree Borrows tags/protectors are created in them, so a known pervasive aliasing
+ * pattern can be set aside while still keeping shadow provenance consistent (unlike BSAN_SKIP_CRATES, see FP1).
+ */
+const noRetagCrates = new Set((process.env.BSAN_NORETAG_CRATES ?? "").split(",").map(s => s.trim().replace(/-/g, "_")).filter(Boolean));
+export function bsanFilterRustflags(crate: string, flags: string[]): string[] {
+  if (!bsanEnabled) return flags;
+  const c = crate.replace(/-/g, "_");
+  if (skipCrates.has(c)) return flags.filter(f => !instrumentOnly.has(f) && !f.startsWith("-Zllvm-plugins="));
+  if (noRetagCrates.has(c)) return flags.filter(f => f !== "-Zcodegen-emit-retag");
+  return flags;
+}
