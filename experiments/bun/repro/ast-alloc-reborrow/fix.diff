+    /// Raw-pointer variant: touches only `bump_cursor` and derives the result from the
+    /// Box's provenance, without a `&mut Self` covering `bump_chunk`.
+    unsafe fn bump_alloc_raw(this: *mut Self, size: usize, align: usize) -> Option<*mut u8> {
+        unsafe {
+            let cursor = (*this).bump_cursor;
+            let cur = (&raw mut (*this).bump_chunk).cast::<u8>().add(cursor);
+            let remaining = BUMP_CHUNK - cursor;
+            let pad = cur.align_offset(align);
+            if pad <= remaining && size <= remaining - pad {
+                (*this).bump_cursor = cursor + pad + size;
+                Some(cur.add(pad))
+            } else {
+                None
+            }
+        }
+    }
 }
 
