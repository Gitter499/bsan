+// BSan repro: the parser's AST allocation pattern (js_parser visit_expr.rs `e_call` -> `e_binary`).
+use bun_alloc::ast_alloc::{AstAlloc, AstVec, ScopedAstAlloc};
+use bun_alloc::MimallocArena;
+
+fn visit(e: &mut [u64; 2]) {
+    let mut more: AstVec<[u64; 2]> = AstAlloc::vec_with_capacity(4); // visiting allocates AST data
+    more.push(*e);
+    *e = [e[0] + 1, e[1]]; // `*e = current`
+}
+
+#[test]
+fn ast_vec_write_after_alloc() {
+    let arena = MimallocArena::new();
+    let _scope = ScopedAstAlloc::with_spill(arena.heap_ptr());
+    let mut args: AstVec<[u64; 2]> = AstAlloc::vec_with_capacity(2);
+    args.push([1, 0]);
+    args.push([2, 0]);
+    for arg in args.iter_mut() {
+        visit(arg);
+    }
+}
