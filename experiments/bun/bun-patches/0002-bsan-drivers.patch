+//! BorrowSanitizer drivers for bun_picohttp (instrumented picohttpparser). Not part of Bun's suite.
+use bun_picohttp::{phr_chunked_decoder, phr_decode_chunked, Header, ParseResponseError, Response};
+
+const RESP: &[u8] = b"HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nX-Bun: borrow-sanitizer\r\nSet-Cookie: a=b; Path=/\r\nTransfer-Encoding: chunked\r\n\r\nbody";
+
+/// http/lib.rs handle_on_data_headers: parse_parts into a shared header array, incremental.
+#[test]
+fn parse_response_incremental() {
+    let mut headers = [Header::ZERO; 64];
+    for cut in 16..RESP.len() {
+        let mut amount_read = 0usize;
+        match Response::parse_parts(&RESP[..cut], &mut headers, Some(&mut amount_read)) {
+            Ok(r) => {
+                assert_eq!(r.status_code, 200);
+                assert_eq!(r.status, b"OK");
+                assert_eq!(r.headers.get(b"x-bun"), Some(&b"borrow-sanitizer"[..]));
+                assert_eq!(&RESP[r.bytes_read..cut], &b"body"[..cut - r.bytes_read]);
+            }
+            Err(ParseResponseError::ShortRead) => {}
+            Err(e) => panic!("cut={cut}: {e:?}"),
+        }
+    }
+}
+
+#[test]
+fn parse_response_errors_and_limits() {
+    let mut few = [Header::ZERO; 2];
+    assert!(Response::parse(RESP, &mut few).is_err());
+    let mut headers = [Header::ZERO; 8];
+    assert!(Response::parse(b"HTTP/1.1 200 OK\r\nA: b\r\n continued\r\n\r\n", &mut headers).is_err());
+    assert!(Response::parse(b"HTTX/1.1 200 OK\r\n\r\n", &mut headers).is_err());
+}
+
+/// http/lib.rs chunked body decoding: in-place phr_decode_chunked across packets.
+#[test]
+fn chunked_decode_multi_packet() {
+    let wire: &[u8] = b"5\r\nhello\r\n1a;ext=1\r\nabcdefghijklmnopqrstuvwxyz\r\n0\r\nTrailer: x\r\n\r\n";
+    for split in 1..wire.len() {
+        let mut dec: phr_chunked_decoder = unsafe { core::mem::zeroed() };
+        dec.consume_trailer = 1;
+        let mut body: Vec<u8> = Vec::new();
+        let mut done = false;
+        for part in [&wire[..split], &wire[split..]] {
+            let start = body.len();
+            body.extend_from_slice(part);
+            let mut n = part.len();
+            // SAFETY: body[start..] is initialized and exclusively borrowed.
+            let ret = unsafe { phr_decode_chunked(&raw mut dec, body.as_mut_ptr().add(start), &raw mut n) };
+            body.truncate(start + n);
+            assert!(ret != -1, "split={split}");
+            if ret >= 0 { done = true; }
+        }
+        assert!(done, "split={split}");
+        assert_eq!(body, b"helloabcdefghijklmnopqrstuvwxyz");
+    }
+}
diff --git a/src/zlib/tests/bsan_drivers.rs b/src/zlib/tests/bsan_drivers.rs
