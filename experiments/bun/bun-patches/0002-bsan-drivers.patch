--- /dev/null
+++ b/src/libarchive/tests/fixtures/gen.py
@@ -0,0 +1,42 @@
+#!/usr/bin/env python3
+"""Generates the tarball fixtures used by tests/bsan_drivers.rs (run from this directory)."""
+import gzip, io, tarfile
+
+def add(t, name, data=b"", type=tarfile.REGTYPE, linkname="", mode=0o644):
+    ti = tarfile.TarInfo(name); ti.type = type; ti.linkname = linkname; ti.mode = mode; ti.mtime = 1700000000
+    if type == tarfile.REGTYPE:
+        ti.size = len(data); t.addfile(ti, io.BytesIO(data))
+    else:
+        t.addfile(ti)
+
+def build(fmt):
+    b = io.BytesIO()
+    with tarfile.open(fileobj=b, mode="w", format=fmt) as t:
+        add(t, "package/", type=tarfile.DIRTYPE, mode=0o755)
+        add(t, "package/package.json", b'{"name":"bsan-fixture","version":"1.0.0"}\n')
+        add(t, "package/lib/index.js", b"module.exports = 42;\n" * 200)
+        add(t, "package/lib/empty.js", b"")
+        add(t, "package/" + "d" * 90 + "/" + "f" * 120 + ".js", b"long name\n")  # pax/GNU long name
+        add(t, "package/bin/cli", b"#!/usr/bin/env node\n", mode=0o755)
+        add(t, "package/big.bin", bytes((i * 7) & 0xff for i in range(300_000)))  # multi-block
+        add(t, "package/link-rel", type=tarfile.SYMTYPE, linkname="lib/index.js")
+        add(t, "package/link-escape", type=tarfile.SYMTYPE, linkname="../../../../etc/passwd")
+        add(t, "package/link-abs", type=tarfile.SYMTYPE, linkname="/etc/passwd")
+        add(t, "package/hard", type=tarfile.LNKTYPE, linkname="package/lib/index.js")
+        add(t, "package/../escape.js", b"traversal\n")
+        add(t, "/abs.js", b"absolute\n")
+        add(t, "package/./dot/../norm.js", b"normalize\n")
+        add(t, "package/café/snow ☃.js", b"utf8\n")
+        add(t, "package/fifo", type=tarfile.FIFOTYPE)
+    return b.getvalue()
+
+for fmt, name in [(tarfile.PAX_FORMAT, "pax"), (tarfile.GNU_FORMAT, "gnu")]:
+    data = build(fmt)
+    open(f"{name}.tar", "wb").write(data)
+    open(f"{name}.tgz", "wb").write(gzip.compress(data, 6, mtime=0))
+d = open("pax.tar", "rb").read()
+open("truncated.tar", "wb").write(d[: len(d) // 3 + 100])
+c = bytearray(d)
+for i in range(600, len(c), 997):
+    c[i] ^= 0xFF
+open("corrupt.tar", "wb").write(bytes(c))
