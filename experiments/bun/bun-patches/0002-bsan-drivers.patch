@@ -0,0 +1,49 @@
+//! BorrowSanitizer drivers for bun_libdeflate_sys (instrumented libdeflate). Not part of Bun's suite.
+use bun_libdeflate_sys::libdeflate::{Encoding, OwnedCompressor, OwnedDecompressor, Status};
+
+fn payload(n: usize) -> Vec<u8> {
+    (0..n).map(|i| (b"libdeflate bun sanitizer "[i % 25]).wrapping_add((i / 997) as u8)).collect()
+}
+
+/// http/compress_body.rs (libdeflate fast path) and Bun.gzipSync with libdeflate.
+#[test]
+fn roundtrip_all_encodings() {
+    bun_libdeflate_sys::libdeflate::load();
+    let input = payload(40_000);
+    for level in [1, 6, 12] {
+        let mut comp = OwnedCompressor::new(level).unwrap();
+        let mut dec = OwnedDecompressor::new().unwrap();
+        for enc in [Encoding::Deflate, Encoding::Zlib, Encoding::Gzip] {
+            let mut out = Vec::new();
+            let r = comp.compress_to_vec(&input, &mut out, enc).unwrap();
+            assert!(r.status == Status::Success);
+            let mut fixed = vec![0u8; comp.max_bytes_needed(&input, enc)];
+            let r2 = comp.compress(&input, &mut fixed, enc);
+            assert!(r2.status == Status::Success);
+            assert_eq!(&fixed[..r2.written], &out[..]);
+            // Exact-size output, then the doubling retry from a tiny buffer.
+            let mut plain = Vec::with_capacity(input.len());
+            assert!(dec.decompress_to_vec(&out, &mut plain, enc).status == Status::Success);
+            assert_eq!(plain, input);
+            let mut grown = Vec::with_capacity(16);
+            let r = dec.decompress_to_vec_grow(&out, &mut grown, enc, 1 << 20).unwrap();
+            assert!(r.status == Status::Success);
+            assert_eq!(grown, input);
+        }
+    }
+}
+
+#[test]
+fn bad_data_and_short_output() {
+    let input = payload(20_000);
+    let mut comp = OwnedCompressor::new(6).unwrap();
+    let mut dec = OwnedDecompressor::new().unwrap();
+    let mut out = Vec::new();
+    comp.compress_to_vec(&input, &mut out, Encoding::Gzip).unwrap();
+    let mut small = vec![0u8; 100];
+    assert!(dec.decompress(&out, &mut small, Encoding::Gzip).status != Status::Success);
+    let mut bad = out.clone();
+    for b in bad.iter_mut().skip(10).step_by(3) { *b ^= 0x77; }
+    let mut plain = Vec::with_capacity(input.len());
+    assert!(dec.decompress_to_vec(&bad, &mut plain, Encoding::Gzip).status != Status::Success);
+}
