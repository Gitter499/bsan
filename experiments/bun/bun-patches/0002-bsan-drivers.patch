index 00000000..eb18ab68
--- /dev/null
+++ b/src/zlib/tests/bsan_drivers.rs
@@ -0,0 +1,283 @@
+//! BorrowSanitizer drivers for bun_zlib. Each test mirrors a production caller's use of the
+//! wrapper (parameters copied from the call site named in its doc comment) so the unsafe FFI
+//! paths run against an instrumented zlib-ng. Not part of Bun's suite.
+use bun_zlib::{
+    DeflateEncoder, FlushValue, InflateDecoder, Options, ReturnCode, ZlibCompressorArrayList,
+    ZlibError, ZlibReaderArrayList,
+};
+
+/// Compressible but non-trivial payload (exercises deflate_medium/slow and match finding).
+fn payload(n: usize) -> Vec<u8> {
+    let words: [&[u8]; 6] = [b"bun ", b"borrow ", b"sanitizer ", b"zlib ", b"deflate ", b"\x00\xff"];
+    let mut v = Vec::with_capacity(n);
+    let mut x: u32 = 0x12345678;
+    while v.len() < n {
+        x ^= x << 13;
+        x ^= x >> 17;
+        x ^= x << 5;
+        v.extend_from_slice(words[(x % 6) as usize]);
+        if x % 7 == 0 {
+            v.push((x >> 8) as u8);
+        }
+    }
+    v.truncate(n);
+    v
+}
+
+/// zlib-format fixture from zlib's own one-shot `compress2` (no Rust-side z_stream), so inflate
+/// paths can be driven independently of the DeflateEncoder/ZlibCompressorArrayList findings.
+fn fixture_zlib(input: &[u8], level: i32) -> Vec<u8> {
+    let mut dest = vec![0u8; input.len() + input.len() / 1000 + 64];
+    let mut dest_len = dest.len() as bun_zlib::uLongf;
+    // SAFETY: dest/input valid for their lengths; compress2 writes at most dest_len bytes.
+    let rc = unsafe {
+        bun_zlib::compress2(dest.as_mut_ptr(), &mut dest_len, input.as_ptr(), input.len() as _, level)
+    };
+    assert_eq!(rc, 0, "compress2");
+    dest.truncate(dest_len as usize);
+    dest
+}
+/// Raw deflate: strip the 2-byte zlib header and 4-byte adler32 trailer.
+fn fixture_raw(input: &[u8], level: i32) -> Vec<u8> {
+    let z = fixture_zlib(input, level);
+    z[2..z.len() - 4].to_vec()
+}
+/// gzip member (RFC 1952) around a raw deflate stream.
+fn fixture_gzip(input: &[u8], level: i32) -> Vec<u8> {
+    let mut g = vec![0x1f, 0x8b, 8, 0, 0, 0, 0, 0, 0, 0xff];
+    g.extend(fixture_raw(input, level));
+    g.extend(bun_zlib::crc32_bytes(0, input).to_le_bytes());
+    g.extend((input.len() as u32).to_le_bytes());
+    g
+}
+
+/// http/compress_body.rs `compress_zlib_streaming`: one-shot `step(.., Finish)` loop.
+fn http_compress(input: &[u8], gzip: bool, level: i32) -> Vec<u8> {
+    let window_bits = if gzip { 15 + 16 } else { 15 };
+    let mut encoder = DeflateEncoder::new(level, window_bits, 8, 0).expect("deflateInit2");
+    let mut out = Vec::new();
+    let mut remaining = input;
+    loop {
+        let reserve = if out.capacity() == out.len() { 64 * 1024 } else { 0 };
+        let (consumed, rc) = encoder.step(remaining, &mut out, reserve, FlushValue::Finish);
+        remaining = &remaining[consumed..];
+        match rc {
+            ReturnCode::StreamEnd => return out,
+            ReturnCode::Ok => continue,
+            rc => panic!("deflate failed: {rc:?}"),
+        }
+    }
+}
+
+/// http/Decompressor.rs: InflateDecoder fed one body chunk at a time.
+fn http_decompress(compressed: &[u8], window_bits: i32, chunk: usize) -> Vec<u8> {
+    let mut dec = InflateDecoder::new(window_bits).expect("inflateInit2");
+    let mut out = Vec::new();
+    let chunks: Vec<&[u8]> = compressed.chunks(chunk).collect();
+    for (i, c) in chunks.iter().enumerate() {
+        let is_done = i + 1 == chunks.len();
+        match dec.decompress(c, &mut out, usize::MAX, is_done) {
+            Ok(_) | Err(ZlibError::ShortRead) => {}
+            Err(e) => panic!("inflate failed: {e:?}"),
+        }
+    }
+    out
+}
+
+#[test]
+fn http_body_deflate_roundtrip() {
+    let input = payload(200_000);
+    for level in [1, 6, 9] {
+        let z = http_compress(&input, false, level);
+        assert_eq!(http_decompress(&z, 15, 1500), input);
+    }
+}
+
+#[test]
+fn http_body_gzip_roundtrip_and_store() {
+    let input = payload(70_000);
+    let gz = http_compress(&input, true, 6);
+    assert_eq!(http_decompress(&gz, 15 + 16, 997), input);
+    // Level 0 → deflate_stored, which writes `s->strm->next_out` directly.
+    let stored = http_compress(&input, true, 0);
+    assert_eq!(http_decompress(&stored, 15 + 32, 4096), input);
+}
+
+#[test]
+fn gzip_multi_member_body() {
+    let a = payload(5000);
+    let b = payload(9000);
+    let mut body = http_compress(&a, true, 6);
+    body.extend(http_compress(&b, true, 6));
+    let mut expected = a.clone();
+    expected.extend(&b);
+    assert_eq!(http_decompress(&body, 15 + 16, 333), expected);
+}
+
+/// http_jsc/websocket_client/WebSocketDeflate.rs: permessage-deflate with context takeover —
+/// one raw-deflate encoder reused across messages with SyncFlush, one raw inflater.
+#[test]
+fn websocket_permessage_deflate_context_takeover() {
+    const COMPRESSION_BUFFER_SIZE: usize = 4096;
+    let mut enc = DeflateEncoder::new(-1, -15, 8, 0).expect("deflateInit2");
+    let mut dec = InflateDecoder::new(-15).expect("inflateInit2");
+    for msg_no in 0..8 {
+        let msg = payload(1000 + msg_no * 3000);
+        let mut out = Vec::new();
+        let mut remaining: &[u8] = &msg;
+        loop {
+            let (consumed, rc) =
+                enc.step(remaining, &mut out, COMPRESSION_BUFFER_SIZE, FlushValue::SyncFlush);
+            remaining = &remaining[consumed..];
+            assert!(matches!(rc, ReturnCode::Ok | ReturnCode::BufError), "{rc:?}");
+            if remaining.is_empty() && enc.avail_out() > 0 {
+                break;
+            }
+        }
+        // RFC 7692 §7.2.1: strip the trailing 00 00 ff ff, re-append before inflating.
+        assert!(out.ends_with(&[0, 0, 0xff, 0xff]));
+        out.truncate(out.len() - 4);
+        let mut wire = out.clone();
+        wire.extend_from_slice(&[0, 0, 0xff, 0xff]);
+        let mut plain = Vec::new();
+        let mut remaining: &[u8] = &wire;
+        loop {
+            let (consumed, rc) =
+                dec.step(remaining, &mut plain, COMPRESSION_BUFFER_SIZE, FlushValue::NoFlush);
+            remaining = &remaining[consumed..];
+            match rc {
+                ReturnCode::Ok if remaining.is_empty() && dec.avail_out() > 0 => break,
+                ReturnCode::Ok => continue,
+                ReturnCode::BufError => break,
+                rc => panic!("inflate failed: {rc:?}"),
+            }
+        }
+        assert_eq!(plain, msg);
+    }
+    assert_eq!(enc.reset(), ReturnCode::Ok);
+}
+
+/// runtime/api/BunObject.rs Bun.deflateSync/gzipSync (ZlibCompressorArrayList) and
+/// Bun.inflateSync/gunzipSync (ZlibReaderArrayList), including the caller's pre-reserve.
+#[test]
+fn bun_sync_apis_roundtrip() {
+    let input = payload(123_456);
+    for gzip in [false, true] {
+        let mut compressed = Vec::new();
+        let opts = Options { gzip, ..Default::default() };
+        let mut c = ZlibCompressorArrayList::init(&input, &mut compressed, opts).expect("init");
+        c.read_all().expect("deflate");
+        drop(c);
+        assert!(!compressed.is_empty());
+
+        let mut list = Vec::new();
+        list.try_reserve_exact(compressed.len().max(32)).unwrap();
+        let window_bits = if gzip { 15 + 16 } else { -15 };
+        let opts = Options { window_bits, ..Default::default() };
+        let mut r = ZlibReaderArrayList::init_with_options(&compressed, &mut list, opts).expect("init");
+        r.read_all(true).expect("inflate");
+        drop(r);
+        assert_eq!(list, input);
+    }
+}
+
+/// StandaloneModuleGraph / `bun create`: ZlibReaderArrayList::init (auto-detect header) on
+/// truncated and corrupt input must error cleanly.
+#[test]
+fn reader_truncated_and_corrupt() {
+    let input = payload(50_000);
+    let gz = http_compress(&input, true, 6);
+    let mut list = Vec::with_capacity(16384);
+    let mut r = ZlibReaderArrayList::init(&gz[..gz.len() / 2], &mut list).expect("init");
+    assert!(r.read_all(true).is_err());
+    drop(r);
+
+    let mut bad = gz.clone();
+    for b in bad.iter_mut().skip(20).step_by(7) {
+        *b ^= 0x5a;
+    }
+    let mut list = Vec::with_capacity(16384);
+    let mut r = ZlibReaderArrayList::init(&bad, &mut list).expect("init");
+    let res = r.read_all(true);
+    assert!(res.is_err());
+    let _ = r.error_message();
+}
+
+#[test]
+fn crc32_matches_reference() {
+    assert_eq!(bun_zlib::crc32_bytes(0, b"123456789"), 0xCBF4_3926);
+}
+
+// ── inflate paths, driven with compress2 fixtures ─────────────────────────────
+
+#[test]
+fn inflate_http_body_zlib_and_gzip() {
+    let input = payload(200_000);
+    assert_eq!(http_decompress(&fixture_zlib(&input, 6), 15, 1500), input);
+    assert_eq!(http_decompress(&fixture_gzip(&input, 9), 15 + 16, 997), input);
+    assert_eq!(http_decompress(&fixture_gzip(&input, 0), 15 + 32, 4096), input);
+}
+
+#[test]
+fn inflate_gzip_multi_member_split_at_boundary() {
+    let a = payload(5000);
+    let b = payload(9000);
+    let ga = fixture_gzip(&a, 6);
+    let gb = fixture_gzip(&b, 1);
+    let mut body = ga.clone();
+    body.extend(&gb);
+    let mut expected = a.clone();
+    expected.extend(&b);
+    assert_eq!(http_decompress(&body, 15 + 16, 333), expected);
+    // Member boundary exactly at a chunk boundary (the State::End resume path).
+    assert_eq!(http_decompress(&body, 15 + 16, ga.len()), expected);
+}
+
+#[test]
+fn inflate_websocket_raw_messages() {
+    let mut dec = InflateDecoder::new(-15).expect("inflateInit2");
+    for msg_no in 0..6 {
+        let msg = payload(700 + msg_no * 2500);
+        let wire = fixture_raw(&msg, 6);
+        let mut plain = Vec::new();
+        let mut remaining: &[u8] = &wire;
+        loop {
+            let (consumed, rc) = dec.step(remaining, &mut plain, 4096, FlushValue::NoFlush);
+            remaining = &remaining[consumed..];
+            match rc {
+                ReturnCode::StreamEnd => break,
+                ReturnCode::Ok => continue,
+                rc => panic!("inflate failed: {rc:?}"),
+            }
+        }
+        assert_eq!(plain, msg);
+        assert_eq!(dec.reset(), ReturnCode::Ok);
+    }
+}
+
+#[test]
+fn inflate_sync_reader_and_errors() {
+    let input = payload(123_456);
+    for (fx, wb) in [(fixture_zlib(&input, 6), 15), (fixture_gzip(&input, 6), 15 + 16), (fixture_raw(&input, 6), -15)] {
+        let mut list = Vec::new();
+        list.try_reserve_exact(fx.len().max(32)).unwrap();
+        let opts = Options { window_bits: wb, ..Default::default() };
+        let mut r = ZlibReaderArrayList::init_with_options(&fx, &mut list, opts).expect("init");
+        r.read_all(true).expect("inflate");
+        drop(r);
+        assert_eq!(list, input);
+    }
+    let gz = fixture_gzip(&input, 6);
+    let mut list = Vec::with_capacity(16384);
+    let mut r = ZlibReaderArrayList::init(&gz[..gz.len() / 2], &mut list).expect("init");
+    assert!(r.read_all(true).is_err());
+    drop(r);
+    let mut bad = gz.clone();
+    for b in bad.iter_mut().skip(20).step_by(7) {
+        *b ^= 0x5a;
+    }
+    let mut list = Vec::with_capacity(16384);
+    let mut r = ZlibReaderArrayList::init(&bad, &mut list).expect("init");
+    assert!(r.read_all(true).is_err());
+    let _ = r.error_message();
+}
diff --git a/src/zstd/tests/bsan_drivers.rs b/src/zstd/tests/bsan_drivers.rs
new file mode 100644
index 00000000..3fc78ea2
--- /dev/null
+++ b/src/zstd/tests/bsan_drivers.rs
@@ -0,0 +1,89 @@
+//! BorrowSanitizer drivers for bun_zstd (instrumented libzstd). Not part of Bun's suite.
+use bun_zstd::{StreamingDecoder, ZstdError};
+
+fn payload(n: usize) -> Vec<u8> {
+    let mut v = Vec::with_capacity(n);
+    let mut x: u32 = 0x9e3779b9;
+    while v.len() < n {
+        x ^= x << 13; x ^= x >> 17; x ^= x << 5;
+        v.extend_from_slice(match x % 4 { 0 => &b"bun zstd "[..], 1 => b"borrow ", 2 => b"\x00\x01\x02", _ => b"sanitizer\n" });
+    }
+    v.truncate(n);
+    v
+}
+
+fn compress(input: &[u8], level: i32) -> Vec<u8> {
+    let mut out = Vec::with_capacity(bun_zstd::compress_bound(input.len()));
+    match bun_zstd::compress_append(&mut out, input, Some(level)) {
+        bun_zstd::Result::Success(n) => assert_eq!(n, out.len()),
+        bun_zstd::Result::Err(e) => panic!("compress: {}", String::from_utf8_lossy(e.as_bytes())),
+    }
+    out
+}
+
+/// Bun.zstdCompressSync / zstdDecompressSync: compress_append + decompress_alloc (known size).
+#[test]
+fn sync_roundtrip_known_size() {
+    let input = payload(40_000);
+    for level in [1, 3, 19] {
+        let c = compress(&input, level);
+        assert_eq!(bun_zstd::decompress_alloc(&c).unwrap(), input);
+    }
+    let mut dest = vec![0u8; bun_zstd::compress_bound(input.len())];
+    match bun_zstd::compress(&mut dest, &input, None) {
+        bun_zstd::Result::Success(n) => assert_eq!(bun_zstd::decompress_alloc(&dest[..n]).unwrap(), input),
+        bun_zstd::Result::Err(e) => panic!("{}", String::from_utf8_lossy(e.as_bytes())),
+    }
+}
+
+/// Unknown content size → decompress_alloc's ZstdReaderArrayList streaming path. A frame
+/// produced by the streaming decoder's peer (HTTP `Content-Encoding: zstd`) has no size; build
+/// one by concatenating two frames (findDecompressedSize sums them) and one skippable frame.
+#[test]
+fn sync_multi_frame_and_skippable() {
+    let a = payload(9_000);
+    let b = payload(13_000);
+    let mut c = compress(&a, 3);
+    // Skippable frame (magic 0x184D2A50, 4-byte LE length, payload).
+    c.extend_from_slice(&[0x50, 0x2a, 0x4d, 0x18, 3, 0, 0, 0, 1, 2, 3]);
+    c.extend(compress(&b, 3));
+    let mut expected = a.clone();
+    expected.extend(&b);
+    assert_eq!(bun_zstd::decompress_alloc(&c).unwrap(), expected);
+}
+
+/// http/Decompressor.rs: StreamingDecoder fed per body chunk, with a max_output window.
+#[test]
+fn http_streaming_chunks() {
+    let input = payload(60_000);
+    let c = compress(&input, 5);
+    for chunk in [1usize, 7, 512, 4096] {
+        let mut dec = StreamingDecoder::new().unwrap();
+        let mut out = Vec::new();
+        let chunks: Vec<&[u8]> = c.chunks(chunk).collect();
+        for (i, ch) in chunks.iter().enumerate() {
+            let mut rest: &[u8] = ch;
+            loop {
+                let max = out.len() + 8192;
+                match dec.decompress(rest, &mut out, max, i + 1 == chunks.len()) {
+                    Ok(n) => { rest = &rest[n..]; if rest.is_empty() { break; } }
+                    Err(ZstdError::ShortRead) => break,
+                    Err(e) => panic!("chunk={chunk}: {e:?}"),
+                }
+            }
+        }
+        assert_eq!(out, input, "chunk={chunk}");
+    }
+}
+
+#[test]
+fn corrupt_and_truncated() {
+    let c = compress(&payload(20_000), 3);
+    assert!(bun_zstd::decompress_alloc(&c[..c.len() / 2]).is_err());
+    let mut bad = c.clone();
+    for b in bad.iter_mut().skip(12).step_by(5) { *b ^= 0xa5; }
+    assert!(bun_zstd::decompress_alloc(&bad).is_err());
+    let mut dec = StreamingDecoder::new().unwrap();
+    let mut out = Vec::new();
+    assert!(dec.decompress(&bad, &mut out, usize::MAX, true).is_err());
+}
