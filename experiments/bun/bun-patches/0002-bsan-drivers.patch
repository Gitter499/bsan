diff --git a/src/brotli/tests/bsan_drivers.rs b/src/brotli/tests/bsan_drivers.rs
new file mode 100644
index 00000000..d553a6e5
--- /dev/null
+++ b/src/brotli/tests/bsan_drivers.rs
@@ -0,0 +1,74 @@
+//! BorrowSanitizer drivers for bun_brotli (instrumented brotli). Not part of Bun's suite.
+use bun_brotli::{c, DecoderOptions, StreamingDecoder};
+
+fn payload(n: usize) -> Vec<u8> {
+    let mut v = Vec::with_capacity(n);
+    let mut x: u32 = 0x1234_5678;
+    while v.len() < n {
+        x ^= x << 13; x ^= x >> 17; x ^= x << 5;
+        v.extend_from_slice(match x % 3 { 0 => &b"<div class=\"bun\">"[..], 1 => b"brotli ", _ => b"</div>\n" });
+    }
+    v.truncate(n);
+    v
+}
+
+/// http/compress_body.rs compress_brotli: encode into a shared buffer, else encode_append.
+fn encode(input: &[u8], quality: i32) -> Vec<u8> {
+    let bound = c::BrotliEncoderMaxCompressedSize(input.len());
+    let mut shared = vec![0u8; bound];
+    let n = bun_brotli::encode(quality, c::BROTLI_DEFAULT_WINDOW, c::BrotliEncoderMode::generic, input, &mut shared).expect("encode");
+    let mut appended = Vec::with_capacity(bound);
+    let m = bun_brotli::encode_append(quality, c::BROTLI_DEFAULT_WINDOW, c::BrotliEncoderMode::generic, input, &mut appended).expect("encode_append");
+    assert_eq!(&shared[..n], &appended[..m]);
+    appended
+}
+
+fn decode(data: &[u8], chunk: usize) -> Vec<u8> {
+    let mut dec = StreamingDecoder::new(&DecoderOptions::default()).unwrap();
+    let mut out = Vec::new();
+    let chunks: Vec<&[u8]> = data.chunks(chunk).collect();
+    for (i, ch) in chunks.iter().enumerate() {
+        match dec.decompress(ch, &mut out, usize::MAX, i + 1 == chunks.len()) {
+            Ok(_) | Err(bun_brotli::Error::ShortRead) => {}
+            Err(e) => panic!("{e:?}"),
+        }
+    }
+    out
+}
+
+#[test]
+fn http_body_roundtrip() {
+    let input = payload(30_000);
+    for q in [1, 5, 11] {
+        let e = encode(&input, q);
+        assert_eq!(decode(&e, 1000), input);
+        assert_eq!(decode(&e, 1), input);
+    }
+}
+
+/// max_output windowing (Decompressor drains in bounded steps).
+#[test]
+fn bounded_output_window() {
+    let input = payload(50_000);
+    let e = encode(&input, 4);
+    let mut dec = StreamingDecoder::new(&DecoderOptions::default()).unwrap();
+    let mut out = Vec::new();
+    let mut rest: &[u8] = &e;
+    loop {
+        let max = out.len() + 3000;
+        let n = dec.decompress(rest, &mut out, max, true).expect("decompress");
+        rest = &rest[n..];
+        if !dec.is_inflating() && out.len() == input.len() { break; }
+        if rest.is_empty() && out.len() >= input.len() { break; }
+    }
+    assert_eq!(out, input);
+}
+
+#[test]
+fn corrupt_input() {
+    let mut e = encode(&payload(10_000), 5);
+    for b in e.iter_mut().skip(3).step_by(4) { *b ^= 0x3c; }
+    let mut dec = StreamingDecoder::new(&DecoderOptions::default()).unwrap();
+    let mut out = Vec::new();
+    assert!(dec.decompress(&e, &mut out, usize::MAX, true).is_err());
+}
diff --git a/src/css/tests/bsan_drivers.rs b/src/css/tests/bsan_drivers.rs
new file mode 100644
index 00000000..ad13bb15
--- /dev/null
+++ b/src/css/tests/bsan_drivers.rs
@@ -0,0 +1,73 @@
+//! BorrowSanitizer drivers for bun_css: the bundler's parse → minify → print pipeline
+//! (bundler/transpiler.rs) over real-world stylesheets from Bun's own CSS test corpus.
+//! Pure Rust, but far too slow for Miri at this size. Not part of Bun's suite.
+use bun_alloc::Arena;
+
+fn corpus(name: &str) -> Vec<u8> {
+    let p = format!("{}/../../test/js/bun/css/files/{name}", env!("CARGO_MANIFEST_DIR"));
+    std::fs::read(&p).unwrap_or_else(|e| panic!("{p}: {e}"))
+}
+
+/// bundler/transpiler.rs: parse, minify, to_css (pretty and minified).
+fn pipeline(code: &[u8], css_modules: bool, minify: bool) -> Vec<u8> {
+    let arena = Arena::new();
+    // SAFETY: as in transpiler.rs — the AST is dropped before `arena` (only `code` escapes).
+    let alloc: &'static Arena = unsafe { bun_ptr::detach_lifetime_ref::<Arena>(&arena) };
+    let mut opts = bun_css::ParserOptions::default(None);
+    if css_modules {
+        opts.filename = b"input.module.css";
+        opts.css_modules = Some(bun_css::CssModuleConfig::default());
+    }
+    let (mut sheet, extra) = bun_css::StyleSheet::<bun_css::DefaultAtRule>::parse(alloc, code, opts, None, bun_ast::Index::source(0u32))
+        .unwrap_or_else(|e| panic!("parse: {e}"));
+    if let Err(e) = sheet.minify(alloc, &bun_css::MinifyOptions::default(), &extra) {
+        panic!("minify: {}", e.kind);
+    }
+    let symbols = bun_ast::symbol::Map::init_list(vec![extra.symbols]);
+    let out = sheet
+        .to_css(alloc, &bun_css::PrinterOptions { minify, ..bun_css::PrinterOptions::default() }, None, None, &symbols)
+        .unwrap_or_else(|e| panic!("print: {e}"));
+    drop(sheet);
+    out.code
+}
+
+#[test]
+fn small_stylesheets() {
+    for f in ["normalize.css", "hint.css", "random-gradients.css", "trainer-gallery-holo.css"] {
+        let code = corpus(f);
+        let pretty = pipeline(&code, false, false);
+        let min = pipeline(&code, false, true);
+        assert!(!pretty.is_empty() && min.len() <= pretty.len(), "{f}");
+        // Printer output must re-parse.
+        let _ = pipeline(&min, false, true);
+    }
+}
+
+#[test]
+fn css_modules() {
+    let code = corpus("hint.css");
+    let out = pipeline(&code, true, true);
+    assert!(!out.is_empty());
+}
+
+#[test]
+fn framework_stylesheets() {
+    for f in ["animate.css", "pico.css", "tachyons.css"] {
+        let code = corpus(f);
+        let out = pipeline(&code, false, true);
+        assert!(!out.is_empty(), "{f}");
+    }
+}
+
+#[test]
+fn malformed_input_recovers() {
+    let inputs: [&[u8]; 6] = [
+        b"a{color:red", b"@media (min-width: {", b"a{b:c}}}}{{{", b"\xff\xfe\x00a{}",
+        b"@import url(", b".x{background:url(\"unterminated",
+    ];
+    for code in inputs {
+        let arena = Arena::new();
+        let alloc: &'static Arena = unsafe { bun_ptr::detach_lifetime_ref::<Arena>(&arena) };
+        let _ = bun_css::StyleSheet::<bun_css::DefaultAtRule>::parse(alloc, code, bun_css::ParserOptions::default(None), None, bun_ast::Index::source(0u32));
+    }
+}
diff --git a/src/libarchive/tests/bsan_drivers.rs b/src/libarchive/tests/bsan_drivers.rs
new file mode 100644
index 00000000..a3e1e71f
--- /dev/null
+++ b/src/libarchive/tests/bsan_drivers.rs
@@ -0,0 +1,130 @@
+//! BorrowSanitizer drivers for bun_libarchive (instrumented libarchive + zlib-ng). Each test
+//! mirrors a production caller. Fixtures come from tests/fixtures (generated with Python's
+//! tarfile: pax + GNU long names, symlinks incl. escaping/absolute ones, hardlink, `..` and
+//! absolute entries, a FIFO, a multi-block file, UTF-8 names). Not part of Bun's suite.
+use bun_libarchive::lib::{ArchiveIterator, IteratorResult};
+use bun_libarchive::{ArchiveAppender, Archiver, Context, ExtractOptions};
+use std::os::fd::AsRawFd;
+
+const PAX: &[u8] = include_bytes!("fixtures/pax.tar");
+const GNU: &[u8] = include_bytes!("fixtures/gnu.tar");
+const PAX_TGZ: &[u8] = include_bytes!("fixtures/pax.tgz");
+const TRUNC: &[u8] = include_bytes!("fixtures/truncated.tar");
+const CORRUPT: &[u8] = include_bytes!("fixtures/corrupt.tar");
+
+fn tmpdir(tag: &str) -> (std::path::PathBuf, std::fs::File) {
+    let p = std::env::temp_dir().join(format!("bsan-libarchive-{tag}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&p);
+    std::fs::create_dir_all(&p).unwrap();
+    let f = std::fs::File::open(&p).unwrap();
+    (p, f)
+}
+
+fn fd(f: &std::fs::File) -> bun_sys::Fd {
+    bun_sys::Fd::from_native(f.as_raw_fd())
+}
+
+/// install/extract_tarball.rs, npm registry tarballs: depth 1, regular files only.
+#[test]
+fn bun_install_npm_extract() {
+    for (tag, tar) in [("pax", PAX), ("gnu", GNU), ("tgz", PAX_TGZ)] {
+        let (p, dir) = tmpdir(tag);
+        let n = Archiver::extract_to_dir(tar, fd(&dir), None, &mut (), ExtractOptions { depth_to_skip: 1, npm: true, ..Default::default() })
+            .unwrap_or_else(|e| panic!("{tag}: {e:?}"));
+        assert!(n > 0, "{tag}");
+        assert_eq!(std::fs::read(p.join("package.json")).unwrap(), b"{\"name\":\"bsan-fixture\",\"version\":\"1.0.0\"}\n");
+        assert_eq!(std::fs::read(p.join("big.bin")).unwrap().len(), 300_000);
+        assert!(!p.parent().unwrap().join("escape.js").exists());
+        let _ = std::fs::remove_dir_all(&p);
+    }
+}
+
+/// install/extract_tarball.rs, GitHub tarballs: depth 1, all kinds, first-dirname callback.
+#[test]
+fn bun_install_github_extract() {
+    struct DirnameReader { needs: bool, got: Vec<u8> }
+    impl ArchiveAppender for DirnameReader {
+        const HAS_ON_FIRST_DIRECTORY_NAME: bool = true;
+        fn needs_first_dirname(&self) -> bool { self.needs }
+        fn on_first_directory_name(&mut self, name: &[u8]) { self.needs = false; self.got = name.to_vec(); }
+    }
+    for (tag, tar) in [("gh-pax", PAX), ("gh-gnu", GNU)] {
+        let (p, dir) = tmpdir(tag);
+        let mut r = DirnameReader { needs: true, got: Vec::new() };
+        let res = Archiver::extract_to_dir(tar, fd(&dir), None, &mut r, ExtractOptions { depth_to_skip: 1, ..Default::default() });
+        assert!(res.is_ok(), "{tag}: {res:?}");
+        assert_eq!(r.got, b"package");
+        assert!(p.join("lib/index.js").exists());
+        let _ = std::fs::remove_dir_all(&p);
+    }
+}
+
+/// cli/create_command.rs: overwrite-list scan before extracting a template.
+#[test]
+fn bun_create_overwrite_list() {
+    let (p, _dir) = tmpdir("create");
+    std::fs::create_dir_all(p.join("lib")).unwrap();
+    std::fs::write(p.join("package.json"), b"{}").unwrap();
+    std::fs::write(p.join("lib/index.js"), b"x").unwrap();
+    // Same appender as create_command.rs: hands back a view of one reused buffer.
+    struct OverwriteListAppender { buf: Vec<u8> }
+    impl ArchiveAppender for OverwriteListAppender {
+        fn append(&mut self, path: &[u8]) -> Result<&[u8], bun_libarchive::Error> {
+            self.buf.clear();
+            self.buf.extend_from_slice(path);
+            Ok(&self.buf)
+        }
+    }
+    let mut ctx = Context { pluckers: Vec::new(), overwrite_list: Default::default() };
+    let root = p.to_str().unwrap().as_bytes().to_vec();
+    Archiver::get_overwriting_file_list::<OverwriteListAppender, 1>(PAX, &root, &mut ctx, &mut OverwriteListAppender { buf: Vec::new() }).expect("scan");
+    assert!(ctx.overwrite_list.count() >= 2, "{}", ctx.overwrite_list.count());
+    let _ = std::fs::remove_dir_all(&p);
+}
+
+/// cli/publish_command.rs / pm_diff_command.rs: iterate entries and read file data.
+#[test]
+fn bun_publish_iterate_and_read() {
+    for tar in [PAX, GNU, PAX_TGZ] {
+        let mut it = match ArchiveIterator::init(tar) {
+            IteratorResult::Result(it) => it,
+            IteratorResult::Err { message, .. } => panic!("{}", String::from_utf8_lossy(message)),
+        };
+        let mut files = 0;
+        loop {
+            let next = match it.next() {
+                IteratorResult::Result(Some(n)) => n,
+                IteratorResult::Result(None) => break,
+                IteratorResult::Err { message, .. } => panic!("{}", String::from_utf8_lossy(message)),
+            };
+            let name = next.entry().pathname().as_bytes().to_vec();
+            if next.kind == bun_sys::FileKind::File {
+                match it.read_entry_data(&next).unwrap() {
+                    IteratorResult::Result(data) => assert_eq!(data.len() as i64, next.entry().size(), "{}", String::from_utf8_lossy(&name)),
+                    IteratorResult::Err { message, .. } => panic!("{}", String::from_utf8_lossy(message)),
+                }
+                files += 1;
+            }
+        }
+        assert!(files >= 8, "{files}");
+        assert!(matches!(it.close(), IteratorResult::Result(())));
+    }
+}
+
+#[test]
+fn truncated_and_corrupt_archives() {
+    for (tag, tar) in [("trunc", TRUNC), ("corrupt", CORRUPT)] {
+        let (p, dir) = tmpdir(tag);
+        let _ = Archiver::extract_to_dir(tar, fd(&dir), None, &mut (), ExtractOptions { depth_to_skip: 1, npm: true, ..Default::default() });
+        let _ = std::fs::remove_dir_all(&p);
+        if let IteratorResult::Result(mut it) = ArchiveIterator::init(tar) {
+            loop {
+                match it.next() {
+                    IteratorResult::Result(Some(n)) => { if n.kind == bun_sys::FileKind::File { let _ = it.read_entry_data(&n); } }
+                    _ => break,
+                }
+            }
+            let _ = it.close();
+        }
+    }
+}
