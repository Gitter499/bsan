+    let mut position = expected.len() as i64;
+    let mut remaining = &consts[..];
+    let mut total = 0u64;
+    while !remaining.is_empty() {
+        let amt = sys::pwritev(fd, remaining, position).unwrap();
+        total += amt as u64;
+        position += amt as i64;
+        let cap: usize = remaining.iter().map(|v| v.len).sum();
+        if amt < cap {
+            break;
+        }
+        remaining = &remaining[remaining.len()..];
+    }
+    assert_eq!(total, 700);
+
+    let file_len = expected.len() + tail.len();
+    assert_eq!(sys::get_file_size(fd).unwrap() as usize, file_len);
+
+    // readv from the start into unevenly sized buffers that straddle the record boundaries.
+    sys::set_file_offset(fd, 0).unwrap();
+    let mut r1 = vec![0u8; 99];
+    let mut r2 = vec![0u8; 2];
+    let mut r3 = vec![0u8; 8000];
+    {
+        let vecs = [
+            sys::platform_iovec_create(&mut r1),
+            sys::platform_iovec_create(&mut r2),
+            sys::platform_iovec_create(&mut r3),
+        ];
+        assert_eq!(sys::readv(fd, &vecs).unwrap(), file_len);
+    }
+    let got: Vec<u8> = [&r1[..], &r2[..], &r3[..file_len - 101]].concat();
+    assert_eq!(&got[..expected.len()], &expected[..]);
+    assert_eq!(&got[expected.len()..], &tail[..]);
+    // readv at EOF.
+    {
+        let vecs = [sys::platform_iovec_create(&mut r1)];
+        assert_eq!(sys::readv(fd, &vecs).unwrap(), 0);
+    }
+
+    // preadv from the middle, short at EOF.
+    let mut p1 = vec![0u8; 10];
+    let mut p2 = vec![0u8; 4096];
+    {
+        let vecs = [
+            sys::platform_iovec_create(&mut p1),
+            sys::platform_iovec_create(&mut p2),
+        ];
+        let off = (file_len - 50) as i64;
+        assert_eq!(sys::preadv(fd, &vecs, off).unwrap(), 50);
+    }
+    assert_eq!(&p1[..], &got[file_len - 50..file_len - 40]);
+    assert_eq!(&p2[..40], &got[file_len - 40..]);
+
+    // EBADF on a closed descriptor carries the fd.
+    sys::close(fd).unwrap();
+    let mut x = [0u8; 4];
+    let vecs = [sys::platform_iovec_create(&mut x)];
+    let err = sys::readv(fd, &vecs).unwrap_err();
+    assert_eq!(err.get_errno(), E::EBADF);
+}
