+//! BorrowSanitizer drivers for bun_io. Each test mirrors a production caller (named in the
+//! comment above it) with the same API, parameters and call order, so the unsafe reader/writer
+//! machinery runs on real fds. Everything here works without a running event loop: readers are
+//! started non-pollable on regular files / memfds, writers on regular files. The two
+//! link-dispatched interfaces the reader needs are registered below for a test-side parent and
+//! loop context (the production impls live in `bun_runtime` / `bun_event_loop`, which this test
+//! binary cannot depend on); only the pieces a non-pollable read reaches are given real bodies.
+//! Each test works in its own temp directory. Not part of Bun's suite.
+use core::cell::Cell;
+use core::ffi::c_void;
+use core::ptr::NonNull;
+use std::os::unix::ffi::OsStrExt;
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicU32, Ordering};
+use std::sync::{Mutex, MutexGuard};
+
+use bun_io::max_buf::{MaxBuf, Owner as MaxBufOwner};
+use bun_io::pipe_writer::PosixPipeWriter as _;
+use bun_io::{
+    BufferedReader, BufferedWriter, Chunk, EventLoopCtx, EventLoopCtxKind, PipeReadScratch,
+    PosixFlags, ReadState, StreamingWriter, Write as _, WriteResult, WriteStatus,
+};
+use bun_sys::{self as sys, Fd, File, O};
+
+// ── harness ────────────────────────────────────────────────────────────────
+
+static LOCK: Mutex<()> = Mutex::new(());
+fn lock() -> MutexGuard<'static, ()> {
+    LOCK.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+static COUNTER: AtomicU32 = AtomicU32::new(0);
+
+struct TmpDir {
+    path: PathBuf,
+    fd: Fd,
+}
+impl TmpDir {
+    fn new(name: &str) -> TmpDir {
+        let n = COUNTER.fetch_add(1, Ordering::Relaxed);
+        let path = std::env::temp_dir().join(format!(
+            "bsan_io_{}_{}_{}",
+            name,
+            std::process::id(),
+            n
+        ));
+        let _ = std::fs::remove_dir_all(&path);
+        std::fs::create_dir(&path).expect("create temp dir");
+        let fd = sys::open_dir_at(Fd::cwd(), path.as_os_str().as_bytes()).expect("open temp dir");
+        TmpDir { path, fd }
+    }
+    fn abs(&self, rel: &str) -> Vec<u8> {
+        self.path.join(rel).as_os_str().as_bytes().to_vec()
+    }
+    fn write(&self, rel: &str, data: &[u8]) {
+        std::fs::write(self.path.join(rel), data).expect("std write");
+    }
+    fn read(&self, rel: &str) -> Vec<u8> {
+        std::fs::read(self.path.join(rel)).expect("std read")
+    }
+    fn open_ro(&self, rel: &str) -> Fd {
+        sys::openat_a(self.fd, rel.as_bytes(), O::RDONLY | O::CLOEXEC, 0).expect("open")
+    }
+}
+impl Drop for TmpDir {
+    fn drop(&mut self) {
+        let _ = sys::close(self.fd);
+        let _ = std::fs::remove_dir_all(&self.path);
+    }
+}
+
+fn pattern(n: usize, seed: u32) -> Vec<u8> {
+    let mut x = seed | 1;
+    (0..n)
+        .map(|_| {
+            x ^= x << 13;
+            x ^= x >> 17;
+            x ^= x << 5;
+            (x >> 7) as u8
+        })
+        .collect()
+}
+
+// ── event-loop context (MiniEventLoop stand-in: only the pipe-read scratch is real) ──
+
+/// event_loop/MiniEventLoop.rs:261 owns a boxed `PipeReadScratch`; a non-pollable read only
+/// ever reaches `pipe_read_scratch()` through this handle.
+struct TestLoop {
+    pipe_read_scratch: Box<PipeReadScratch>,
+}
+impl TestLoop {
+    fn new() -> Box<TestLoop> {
+        Box::new(TestLoop {
+            pipe_read_scratch: Box::new(PipeReadScratch::new()),
+        })
+    }
+}
+
+bun_io::link_impl_EventLoopCtx! {
+    Mini for TestLoop => |this| {
+        platform_event_loop_ptr() => panic!("non-pollable reads never touch the uws loop"),
+        file_polls_ptr() => panic!("non-pollable reads never allocate a FilePoll"),
+        increment_pending_unref_counter() => panic!("no FilePoll to unref"),
+        after_event_loop_callback() => None,
+        set_after_event_loop_callback(cb, ctx) => { let _ = (cb, ctx); },
+        pipe_read_scratch() => &raw const *(*this).pipe_read_scratch,
+    }
+}
+
+fn loop_ctx(lp: *mut TestLoop) -> EventLoopCtx {
+    // SAFETY: every test keeps its `TestLoop` alive for as long as the reader it serves.
+    unsafe { EventLoopCtx::new(EventLoopCtxKind::Mini, lp) }
+}
+
+// ── streaming reader parent (runtime/server/FileResponseStream.rs:622 shape) ──
+
+struct FileStream {
+    reader: BufferedReader,
+    lp: *mut TestLoop,
+    body: Vec<u8>,
+    chunks: Vec<(usize, bool)>,
+    done: Cell<u32>,
+    errors: Vec<sys::Error>,
+    refs: Cell<i32>,
+    max_ref_depth: Cell<i32>,
+    /// Return `false` from `on_read_chunk` after this many chunks (backpressure).
+    stop_after: Option<usize>,
+}
+
+impl FileStream {
+    fn new(lp: *mut TestLoop) -> *mut FileStream {
+        Box::into_raw(Box::new(FileStream {
+            reader: BufferedReader::init::<FileStream>(),
+            lp,
+            body: Vec::new(),
+            chunks: Vec::new(),
+            done: Cell::new(0),
+            errors: Vec::new(),
+            refs: Cell::new(0),
+            max_ref_depth: Cell::new(0),
+            stop_after: None,
+        }))
+    }
+    /// # Safety
+    /// `this` is live; the reader may be mid-call, so only sibling fields are touched.
+    unsafe fn on_read_chunk(this: *mut Self, chunk: Chunk<'_>, state: ReadState) -> bool {
+        // SAFETY: caller contract; disjoint field borrows.
+        unsafe {
+            let owned = chunk.is_owned();
+            (*this).body.extend_from_slice(&chunk);
+            (*this).chunks.push((chunk.len(), owned));
+            let _ = state;
+            match (*this).stop_after {
+                Some(n) => (*this).chunks.len() < n,
+                None => true,
+            }
+        }
+    }
+    /// # Safety
+    /// `this` is live.
+    unsafe fn on_reader_done(this: *mut Self) {
+        // SAFETY: caller contract.
+        unsafe { (*this).done.set((*this).done.get() + 1) };
+    }
+    /// # Safety
+    /// `this` is live.
+    unsafe fn on_reader_error(this: *mut Self, err: sys::Error) {
+        // SAFETY: caller contract.
+        unsafe { (*this).errors.push(err) };
+    }
+    /// # Safety
+    /// `this` is live.
+    unsafe fn ref_(this: *mut Self) {
+        // SAFETY: caller contract; `Cell` field.
+        let r = unsafe { &(*this).refs };
+        r.set(r.get() + 1);
+        // SAFETY: as above.
+        let m = unsafe { &(*this).max_ref_depth };
+        m.set(m.get().max(r.get()));
+    }
+    /// # Safety
+    /// `this` is live.
+    unsafe fn deref(this: *mut Self) {
+        // SAFETY: caller contract; `Cell` field.
+        let r = unsafe { &(*this).refs };
+        r.set(r.get() - 1);
+    }
+}
+
+bun_io::impl_buffered_reader_parent! {
+    FileResponseStream for FileStream;
+    has_on_read_chunk = true;
+    on_read_chunk   = |this, chunk, state| FileStream::on_read_chunk(this, chunk, state);
+    on_reader_done  = |this| FileStream::on_reader_done(this);
+    on_reader_error = |this, err| FileStream::on_reader_error(this, err);
+    loop_           = |this| { let _ = this; panic!("non-pollable reader asked for the loop") };
+    event_loop      = |this| loop_ctx((*this).lp);
+    ref_            = |this| FileStream::ref_(this);
+    deref           = |this| FileStream::deref(this);
+}
