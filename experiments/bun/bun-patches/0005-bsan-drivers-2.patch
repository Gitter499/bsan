+//! BorrowSanitizer drivers for bun_exe_format: the `bun build --compile`
+//! executable patchers (StandaloneModuleGraph.rs `inject`) for ELF, PE and
+//! Mach-O, plus the builtins-section reader. Each test mirrors a production
+//! call site named in the comment above it. Not part of Bun's suite.
+//!
+//! ELF inputs are real binaries (`/proc/self/exe`, `/bin/true`) copied to a
+//! temp dir first. No PE / Mach-O binary exists on this Linux host, so those
+//! templates are assembled here with the section/segment layout a linker
+//! produces for bun.exe / bun-darwin (small, so BSan stays fast).
+use bun_exe_format::builtins::{self, BuiltinsError};
+use bun_exe_format::elf::{ElfError, ElfFile};
+use bun_exe_format::macho::{MachoError, MachoFile};
+use bun_exe_format::pe::{self, PEFile};
+
+// ── byte helpers ──────────────────────────────────────────────────────────
+
+fn u16_at(b: &[u8], o: usize) -> u16 {
+    u16::from_le_bytes(b[o..o + 2].try_into().unwrap())
+}
+fn u32_at(b: &[u8], o: usize) -> u32 {
+    u32::from_le_bytes(b[o..o + 4].try_into().unwrap())
+}
+fn u64_at(b: &[u8], o: usize) -> u64 {
+    u64::from_le_bytes(b[o..o + 8].try_into().unwrap())
+}
+fn put16(b: &mut [u8], o: usize, v: u16) {
+    b[o..o + 2].copy_from_slice(&v.to_le_bytes());
+}
+fn put32(b: &mut [u8], o: usize, v: u32) {
+    b[o..o + 4].copy_from_slice(&v.to_le_bytes());
+}
+fn put64(b: &mut [u8], o: usize, v: u64) {
+    b[o..o + 8].copy_from_slice(&v.to_le_bytes());
+}
+
+fn temp_copy(src: &str, name: &str) -> std::path::PathBuf {
+    let dir = std::env::temp_dir().join(format!("bsan-exe-format-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let dst = dir.join(name);
+    std::fs::copy(src, &dst).unwrap_or_else(|e| panic!("copy {src}: {e}"));
+    dst
+}
+
+/// A standalone-module-graph-shaped payload: module sources, a table, and the
+/// `\n---- Bun! ----\n` trailer `StandaloneModuleGraph::to_bytes` appends.
+fn module_graph_payload(extra: usize) -> Vec<u8> {
+    let mut v = Vec::new();
+    v.extend_from_slice(b"// @bun\nimport { add } from \"./util.js\";\nconsole.log(add(1, 2));\n\0");
+    v.extend_from_slice(b"export function add(a, b) { return a + b; }\n\0");
+    v.extend(std::iter::repeat_n(0x5a, extra));
+    for x in [0u32, 64, 64, 46] {
+        v.extend_from_slice(&x.to_le_bytes());
+    }
+    v.extend_from_slice(b"\n---- Bun! ----\n");
+    v
+}
+
+// ── ELF ───────────────────────────────────────────────────────────────────
+
+// Mirrors c-bindings.cpp:1194 `BUN_COMPILED` (section ".bun", zero-initialized,
+// writable) so this test binary is a valid `--compile` template.
+#[used]
+#[unsafe(link_section = ".bun")]
+static mut BUN_COMPILED: [u64; 4] = [0; 4];
+
+struct Shdr {
+    offset: u64,
+    addr: u64,
+    size: u64,
+}
+
+fn elf_section(data: &[u8], want: &[u8]) -> Option<Shdr> {
+    let shoff = u64_at(data, 40) as usize;
+    let shnum = u16_at(data, 60) as usize;
+    let shstrndx = u16_at(data, 62) as usize;
+    let strtab_off = u64_at(data, shoff + shstrndx * 64 + 24) as usize;
+    for i in 0..shnum {
+        let sh = shoff + i * 64;
+        let name_off = strtab_off + u32_at(data, sh) as usize;
+        let name_end = name_off + data[name_off..].iter().position(|&c| c == 0)?;
+        if &data[name_off..name_end] == want {
+            return Some(Shdr { offset: u64_at(data, sh + 24), addr: u64_at(data, sh + 16), size: u64_at(data, sh + 32) });
+        }
+    }
+    None
+}
+
+// standalone_graph/StandaloneModuleGraph.rs:2443 (ElfFile::init), :2452
+// (normalize_interpreter), :2454 (write_bun_section), then writing `elf_file.data`.
+#[test]
+fn elf_write_bun_section_into_self_exe() {
+    // SAFETY: plain read of a zero-initialized static nobody writes.
+    let linked = unsafe { core::ptr::addr_of!(BUN_COMPILED).read_volatile() };
+    assert_eq!(linked, [0; 4]);
+
+    let path = temp_copy("/proc/self/exe", "template");
+    let input = std::fs::read(&path).unwrap();
+    let orig_bun = elf_section(&input, b".bun").expect("test binary has .bun");
+    let mut elf = ElfFile::init(input).unwrap_or_else(|e| panic!("init: {e}"));
+    elf.normalize_interpreter();
+    let payload = module_graph_payload(300);
+    elf.write_bun_section(&payload).unwrap_or_else(|e| panic!("write_bun_section: {e}"));
+    std::fs::write(&path, &elf.data).unwrap();
+
+    let out = std::fs::read(&path).unwrap();
+    let bun = elf_section(&out, b".bun").expect(".bun after patch");
+    assert_eq!(bun.size, 8 + payload.len() as u64);
+    assert_eq!(bun.addr % 0x1000, 0);
+    assert_eq!(u64_at(&out, bun.offset as usize), payload.len() as u64);
+    assert_eq!(&out[bun.offset as usize + 8..][..payload.len()], &payload[..]);
+    // BUN_COMPILED now holds the payload's vaddr.
+    assert_eq!(u64_at(&out, orig_bun.offset as usize), bun.addr);
+    // Non-ALLOC sections moved with the tail and still resolve.
+    assert!(elf_section(&out, b".shstrtab").is_some());
+
+    // `--compile-executable-path` pointing at an already-compiled binary: the
+    // payload is replaced in place.
+    let mut again = ElfFile::init(out).unwrap_or_else(|e| panic!("init: {e}"));
+    let smaller = module_graph_payload(10);
+    again.write_bun_section(&smaller).unwrap_or_else(|e| panic!("rewrite: {e}"));
+    let bun2 = elf_section(&again.data, b".bun").unwrap();
+    assert_eq!(bun2.addr, bun.addr);
+    assert_eq!(u64_at(&again.data, bun2.offset as usize), smaller.len() as u64);
+    assert_eq!(&again.data[bun2.offset as usize + 8..][..smaller.len()], &smaller[..]);
+    let _ = std::fs::remove_file(&path);
+}
+
+// standalone_graph/StandaloneModuleGraph.rs:2443-2454 on a binary that is not a bun template.
+#[test]
+fn elf_without_bun_section_and_bad_headers() {
+    let path = temp_copy("/bin/true", "true");
+    let input = std::fs::read(&path).unwrap();
+    let mut elf = ElfFile::init(input.clone()).unwrap_or_else(|e| panic!("init: {e}"));
+    elf.normalize_interpreter();
+    assert!(elf.data == input, "FHS interpreter is left alone");
+    assert!(matches!(elf.write_bun_section(b"x"), Err(ElfError::BunSectionNotFound)));
+
+    assert!(matches!(ElfFile::init(input[..40].to_vec()), Err(ElfError::InvalidElfFile)));
+    let mut b32 = input.clone();
+    b32[4] = 1;
+    assert!(matches!(ElfFile::init(b32), Err(ElfError::Not64Bit)));
+    let mut be = input.clone();
+    be[5] = 2;
+    assert!(matches!(ElfFile::init(be), Err(ElfError::NotLittleEndian)));
+    let mut not_elf = input.clone();
+    not_elf[..4].copy_from_slice(b"MZ\0\0");
+    assert!(matches!(ElfFile::init(not_elf), Err(ElfError::InvalidElfFile)));
+    // Corrupt program header table offset: normalize must not panic.
+    let mut corrupt = input;
+    put64(&mut corrupt, 32, u64::MAX / 2);
+    let mut elf = ElfFile::init(corrupt).unwrap();
+    elf.normalize_interpreter();
+    let _ = std::fs::remove_file(&path);
+}
