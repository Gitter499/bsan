+            assert_eq!(File::borrow(&fd).read_to_end().unwrap(), b"<html>root</html>");
+            sys::close(fd).unwrap();
+        }
+        Err(e) => assert_eq!(e.get_errno(), E::ENOENT),
+    }
+    let err = sys::openat2_in_root(t.fd, ZStr::from_slice_with_nul(b"missing\0"), flags, 0)
+        .unwrap_err();
+    assert_eq!(err.get_errno(), E::ENOENT);
+}
