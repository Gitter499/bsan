+const EMPTY: &[u8] = &[];
+
+/// spawn/static_pipe_writer.rs:72 shape (`borrow = mut`, raw `buffer` slice into owned `source`).
+struct StaticPipeWriter {
+    writer: BufferedWriter<StaticPipeWriter>,
+    source: Box<[u8]>,
+    buffer: *const [u8],
+    closed: u32,
+    writes: Vec<(usize, WriteStatus)>,
+}
+impl StaticPipeWriter {
+    fn on_write(&mut self, amount: usize, status: WriteStatus) {
+        self.writes.push((amount, status));
+        // SAFETY: `buffer` always points into `source`, which outlives it.
+        let cur = unsafe { &*self.buffer };
+        let len = cur.len();
+        self.buffer = core::ptr::from_ref(&cur[amount.min(len)..]);
+        if status == WriteStatus::EndOfFile {
+            return;
+        }
+        if self.buffer.is_empty() {
+            self.writer.close();
+        }
+    }
+    fn on_error(&mut self, err: &sys::Error) {
+        panic!("unexpected write error {err:?}");
+    }
+    fn on_close(&mut self) {
+        self.closed += 1;
+        self.buffer = core::ptr::from_ref(EMPTY);
+    }
+}
+
+bun_io::impl_buffered_writer_parent! {
+    StaticPipeWriter;
+    poll_tag   = bun_io::posix_event_loop::poll_tag::STATIC_PIPE_WRITER,
+    borrow     = mut,
+    on_write   = on_write,
+    on_error   = on_error,
+    on_close   = on_close,
+    get_buffer = |this| &*(*this).buffer,
+    event_loop = |this| { let _ = this; panic!("regular-file writer never needs the loop") },
+    uv_loop    = |this| panic!("windows only"),
+    ref_       = |this| {},
+    deref      = |this| {},
+}
+
+// spawn/static_pipe_writer.rs:151/186 (set_parent, start) + runtime/shell/IOWriter.rs:178 (writer.on_poll) on a non-pollable file fd
+#[test]
+fn static_pipe_writer_drains_source() {
+    let _g = lock();
+    let t = TmpDir::new("static_pipe");
+    for &n in &[1usize, 4096, 123_457] {
+        let source = pattern(n, n as u32).into_boxed_slice();
+        let fd = sys::openat_a(t.fd, b"stdin.bin", O::WRONLY | O::CREAT | O::TRUNC, 0o644).unwrap();
+        let this = Box::into_raw(Box::new(StaticPipeWriter {
+            writer: BufferedWriter::<StaticPipeWriter>::default(),
+            buffer: core::ptr::from_ref(EMPTY),
+            source,
+            closed: 0,
+            writes: Vec::new(),
+        }));
+        // SAFETY: `this` is live until `Box::from_raw`.
+        unsafe {
+            (*this).buffer = &raw const *(*this).source;
+            (*this).writer.set_parent(this);
+            (*this).writer.start(fd, false).unwrap();
+            assert_eq!((*this).writer.get_fd(), fd);
+            (*this).writer.on_poll(0, false);
+            assert_eq!((*this).closed, 1, "on_write emptied the buffer and closed");
+            assert_eq!((*this).writes.iter().map(|w| w.0).sum::<usize>(), n);
+            assert!((*this).writes.iter().all(|w| w.1 == WriteStatus::Drained));
+            // Nothing left: a second poll is a no-op.
+            (*this).writer.on_poll(0, false);
+            assert_eq!((*this).writes.len(), 1);
+            (*this).writer.end();
+            let s = Box::from_raw(this);
+            assert_eq!(t.read("stdin.bin"), &s.source[..]);
+        }
+    }
+}
