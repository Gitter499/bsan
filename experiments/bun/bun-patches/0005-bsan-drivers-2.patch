+// runtime/server/ServerConfig.rs:595 (arena.alloc_slice_copy(bytes)) and the other bumpalo-parity helpers
+#[test]
+fn arena_bumpalo_helpers() {
+    let arena = MimallocArena::new();
+    let src: Vec<u8> = (0..=255u8).collect();
+    let copy = arena.alloc_slice_copy(&src);
+    copy[0] = 9;
+    assert_eq!(copy[0], 9);
+    assert_eq!(&copy[1..], &src[1..]);
+    // runtime/bake/FrameworkRouter.rs:264 (arena.alloc_slice_fill_default::<u8>(len))
+    let zeroed = arena.alloc_slice_fill_default::<u8>(1000);
+    assert!(zeroed.iter().all(|b| *b == 0));
+    zeroed[999] = 1;
+    // js_parser/p.rs:5565 (arena.alloc_slice_fill_iter(..))
+    let parts: &mut [&[u8]] = arena.alloc_slice_fill_iter([&b"a"[..], &b"bc"[..], &b"def"[..]]);
+    assert_eq!(parts.iter().map(|p| p.len()).sum::<usize>(), 6);
+    let filled = arena.alloc_slice_fill_copy(33, 0xABu16);
+    assert!(filled.iter().all(|v| *v == 0xAB));
+    let with = arena.alloc_slice_fill_with(17, |i| i * i);
+    assert_eq!(with[16], 256);
+    // resolver/fs.rs:798 (arena.alloc_uninit_slice::<u8>(len) then fill)
+    let slot = arena.alloc_uninit_slice::<u8>(300);
+    for (i, b) in slot.iter_mut().enumerate() {
+        b.write(i as u8);
+    }
+    // SAFETY: every byte written above.
+    let slot: &[u8] = unsafe { &*(slot as *const [MaybeUninit<u8>] as *const [u8]) };
+    assert_eq!(slot[299], 299u16 as u8);
+    let one: &mut (u64, u32) = arena.alloc((7, 8));
+    one.1 += 1;
+    assert_eq!(*one, (7, 9));
+    let st = arena.alloc_str("hello arena");
+    st.make_ascii_uppercase();
+    assert_eq!(st, "HELLO ARENA");
+    assert!(arena.allocated_bytes() > 0);
+}
