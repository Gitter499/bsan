+// spawn_sys/spawn_process.rs:838 (socketpair AF_UNIX/SOCK_STREAM) + send_non_block / recv_non_block
+#[test]
+fn socketpair_send_recv_nonblock() {
+    let _g = lock();
+    let [a, b] = sys::socketpair(libc::AF_UNIX, libc::SOCK_STREAM, 0, false).unwrap();
+    let mut buf = [0u8; 512];
+    assert!(sys::recv_non_block(b, &mut buf).unwrap_err().is_retry());
+    let payload = pattern(1500, 3);
+    let mut sent = 0;
+    while sent < payload.len() {
+        sent += sys::send_non_block(a, &payload[sent..]).unwrap();
+    }
+    let mut got = Vec::new();
+    while got.len() < payload.len() {
+        let n = sys::recv_non_block(b, &mut buf).unwrap();
+        got.extend_from_slice(&buf[..n]);
+    }
+    assert_eq!(got, payload);
+    sys::close(a).unwrap();
+    assert_eq!(sys::recv_non_block(b, &mut buf).unwrap(), 0);
+    // Peer closed: send reports EPIPE (MSG_NOSIGNAL, no SIGPIPE).
+    let e = sys::send_non_block(b, b"x").unwrap_err();
+    assert_eq!(e.get_errno(), E::EPIPE);
+    sys::close(b).unwrap();
+    // Shell flavour.
+    let [c, d] = sys::socketpair_for_shell(libc::AF_UNIX, libc::SOCK_STREAM, 0, true).unwrap();
+    assert_eq!(sys::write(c, b"yes\n").unwrap(), 4);
+    assert_eq!(sys::read(d, &mut buf).unwrap(), 4);
+    sys::close(c).unwrap();
+    sys::close(d).unwrap();
+}
