+//! BorrowSanitizer drivers for bun_core (string/encoding, builders, vec spare-capacity
+//! helpers, ffi helpers). Each test mirrors a production call site elsewhere in Bun.
+//! Not part of Bun's suite.
+
+use bun_core::strings;
+use bun_core::{
+    BoundedArray, EncodedSlice, HashedString, MutableString, SmolStr, StringBuilder, WStr, ZBox,
+    ZStr,
+};
+use bun_simdutf_sys::simdutf;
+
+// ── shared inputs ──────────────────────────────────────────────────────────
+
+/// ASCII payloads straddling the 16/32/64-byte SIMD block boundaries.
+const ASCII_LENS: [usize; 9] = [15, 16, 17, 31, 32, 33, 63, 64, 65];
+
+fn ascii(n: usize) -> Vec<u8> {
+    (0..n).map(|i| b'a' + (i % 26) as u8).collect()
+}
+
+/// Mixed 1/2/3/4-byte UTF-8 ("héllo wörld ✓ 😀").
+const MULTI: &str = "h\u{e9}llo w\u{f6}rld \u{2713} \u{1F600}";
+
+/// ASCII prefix of length `n` followed by `tail` — puts the first non-ASCII byte
+/// right at / after a SIMD block boundary.
+fn ascii_then(n: usize, tail: &[u8]) -> Vec<u8> {
+    let mut v = ascii(n);
+    v.extend_from_slice(tail);
+    v
+}
+
+fn utf16(s: &str) -> Vec<u16> {
+    s.encode_utf16().collect()
+}
+
+// ── UTF-8 → UTF-16 ─────────────────────────────────────────────────────────
+
+// runtime/webcore/encoding.rs:367
+#[test]
+fn to_utf16_alloc_utf8_encoding() {
+    // Pure ASCII → None (caller keeps the 8-bit form), at every block boundary.
+    for n in ASCII_LENS {
+        assert!(strings::to_utf16_alloc(&ascii(n), false, false).unwrap().is_none());
+    }
+    // Valid multibyte, with the first non-ASCII byte placed at block boundaries.
+    for n in ASCII_LENS {
+        let input = ascii_then(n, MULTI.as_bytes());
+        let out = strings::to_utf16_alloc(&input, false, false).unwrap().unwrap();
+        let expect: Vec<u16> = String::from_utf8(input.clone()).unwrap().encode_utf16().collect();
+        assert_eq!(out, expect);
+        // sentinel variant appends a 0 unit
+        let z = strings::to_utf16_alloc(&input, false, true).unwrap().unwrap();
+        assert_eq!(&z[..z.len() - 1], &expect[..]);
+        assert_eq!(*z.last().unwrap(), 0);
+    }
+    // Invalid UTF-8: truncated lead, stray continuations, overlong, lone surrogate (WTF-8).
+    let invalids: [&[u8]; 6] = [
+        b"abc\xE2\x82",
+        b"\x80\x80",
+        b"x\xC0\xAFy",
+        b"\xED\xA0\x80z",
+        b"\xF0\x9F\x98",
+        b"ok \xFF\xFE end",
+    ];
+    for inv in invalids {
+        let out = strings::to_utf16_alloc(inv, false, false).unwrap().unwrap();
+        assert!(out.contains(&0xFFFD), "{inv:?} -> {out:x?}");
+        assert!(matches!(
+            strings::to_utf16_alloc(inv, true, false),
+            Err(strings::ToUTF16Error::InvalidByteSequence)
+        ));
+    }
+    // Invalid bytes after a long ASCII prefix (simdutf partial write then slow path).
+    for n in ASCII_LENS {
+        let input = ascii_then(n, b"\xE2\x28\xA1 tail \xC3\xA9");
+        let out = strings::to_utf16_alloc(&input, false, true).unwrap().unwrap();
+        assert_eq!(&out[..n], &ascii(n).iter().map(|&b| u16::from(b)).collect::<Vec<_>>()[..]);
+        assert_eq!(*out.last().unwrap(), 0);
+        assert_eq!(out[out.len() - 2], 0xE9);
+    }
+    assert!(strings::to_utf16_alloc(b"", false, false).unwrap().is_none());
+}
+
+// jsc/CachedBytecode.rs:49
+#[test]
+fn wtf8_to_utf16_alloc_slot_for_wtf8() {
+    assert!(strings::wtf8_to_utf16_alloc(b"plainName").is_none());
+    assert!(strings::wtf8_to_utf16_alloc(b"").is_none());
+    for n in ASCII_LENS {
+        // valid UTF-8 (simdutf fast path after the widened prefix)
+        let input = ascii_then(n, MULTI.as_bytes());
+        let out = strings::wtf8_to_utf16_alloc(&input).unwrap();
+        let expect: Vec<u16> = String::from_utf8(input.clone()).unwrap().encode_utf16().collect();
+        assert_eq!(out, expect);
+        // WTF-8 lone surrogate (U+D83D encoded as 3 bytes) — scalar loop keeps it.
+        let input = ascii_then(n, b"\xED\xA0\xBDx\xFFy");
+        let out = strings::wtf8_to_utf16_alloc(&input).unwrap();
+        assert_eq!(out.len(), n + 4);
+        assert_eq!(out[n], 0xD83D);
+        assert_eq!(out[n + 1], u16::from(b'x'));
+        assert_eq!(out[n + 2], 0xFFFD);
+        assert_eq!(out[n + 3], u16::from(b'y'));
+    }
+}
