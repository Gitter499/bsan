+// runtime/webcore/blob/Store.rs:172 (serialize via bun_io::Write) + runtime/webcore/Blob.rs:3845 (read_struct::<Fd>)
+#[test]
+fn fixed_buffer_stream_blob_roundtrip() {
+    let _g = lock();
+    let mut buf = [0u8; 64];
+    let fd = Fd::from_native(37);
+    let written = {
+        let mut writer = bun_io::FixedBufferStream::new(&mut buf[..]);
+        writer.write_int_le::<u64>(12345).unwrap();
+        writer.write_int_le::<u8>(0).unwrap(); // PathOrFileDescriptorSerializeTag::Fd
+        writer.write_all(&fd.0.to_ne_bytes()).unwrap();
+        writer.write_int_le::<u32>(5).unwrap();
+        writer.write_all(b"a.txt").unwrap();
+        writer.pos
+    };
+    let mut reader = bun_io::FixedBufferStream::new(&buf[..written]);
+    assert_eq!(reader.read_int_le::<u64>().unwrap(), 12345);
+    assert_eq!(reader.read_int_le::<u8>().unwrap(), 0);
+    let back: Fd = reader.read_struct().unwrap();
+    assert_eq!(back, fd);
+    let len = reader.read_int_le::<u32>().unwrap() as usize;
+    let mut name = vec![0u8; len];
+    reader.read_exact(&mut name).unwrap();
+    assert_eq!(name, b"a.txt");
+    // Truncated input: read_struct reports EndOfStream instead of reading past the end.
+    let mut short = bun_io::FixedBufferStream::new(&buf[..3]);
+    assert!(short.read_struct::<Fd>().is_err());
+    assert!(short.read_int_le::<u64>().is_err());
+    // Writing past the fixed buffer fails.
+    let mut tiny = [0u8; 4];
+    let mut w = bun_io::FixedBufferStream::new(&mut tiny[..]);
+    assert!(w.write_all(b"12345").is_err());
+    let mut count = bun_io::DiscardingWriter::new();
+    count.write_all(b"abc").unwrap();
+    count.splat_byte_all(b' ', 10).unwrap();
