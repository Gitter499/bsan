+    )
+    .unwrap();
+    let mut a = pattern(100, 1);
+    let mut b = pattern(0, 2);
+    let mut c = pattern(5000, 3);
+    let mut d = pattern(1, 4);
+    let expected: Vec<u8> = [&a[..], &b[..], &c[..], &d[..]].concat();
+    {
+        let vecs = [
+            sys::platform_iovec_create(&mut a),
+            sys::platform_iovec_create(&mut b),
+            sys::platform_iovec_create(&mut c),
+            sys::platform_iovec_create(&mut d),
+        ];
+        let total: usize = vecs.iter().map(sys::platform_iovec_len).sum();
+        assert_eq!(sys::writev(fd, &vecs).unwrap(), total);
+    }
+    // pwritev the same layout at an offset (libuv-style batched loop).
+    let tail = pattern(700, 9);
+    let consts = [
+        sys::platform_iovec_const_create(&tail[..300]),
+        sys::platform_iovec_const_create(&tail[300..]),
