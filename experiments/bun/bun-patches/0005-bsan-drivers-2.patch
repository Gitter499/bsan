+        // Grow a spill-sized u8 list (old.size() > BUMP_MAX → mi_expand attempt first).
+        let mut bytes: AstVec<u8> = AstAlloc::vec_with_capacity(600);
+        bytes.extend_from_slice(&[1u8; 600]);
+        bytes.extend_from_slice(&[2u8; 900]);
+        assert_eq!(bytes.len(), 1500);
+        assert!(bytes[..600].iter().all(|b| *b == 1) && bytes[600..].iter().all(|b| *b == 2));
+        // shrink keeps the slot.
+        bytes.truncate(10);
+        bytes.shrink_to_fit();
+        assert_eq!(&bytes[..], &[1u8; 10]);
+    }
+    // Exhaust the 16 KB inline chunk with 512-byte lists → later ones fall through to spill.
+    let mut lists: Vec<AstVec<u64>> = Vec::new();
+    for i in 0..40u64 {
