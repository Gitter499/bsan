+// runtime/shell/builtin/mv.rs:172 (e.msg()) + runtime/node/node_fs.rs:5573 (with_path_dest) + runtime/node/node_process.rs:471 (uv_code_label)
+#[test]
+fn error_decoration() {
+    let _g = lock();
+    let t = TmpDir::new("errors");
+    let missing = t.abs_z(b"missing.txt");
+    let err = sys::open(ZStr::from_slice_with_nul(&missing), O::RDONLY, 0).unwrap_err();
+    assert_eq!(err.get_errno(), E::ENOENT);
+    assert_eq!(err.name(), b"ENOENT");
+    assert!(err.msg().is_some());
+    assert_eq!(err.uv_code_label().unwrap().0, "ENOENT");
+    let with = err.with_path(b"other/path");
+    assert_eq!(with.get_errno(), E::ENOENT);
+    let without = with.without_path();
+    assert_eq!(without.get_errno(), E::ENOENT);
+    let dest = err.with_path_dest(b"from", b"to");
+    let rendered = format!("{dest}");
+    assert!(!rendered.is_empty());
+    let fd_err = sys::fstat(Fd::from_native(99_998)).err().expect("fstat on a closed fd");
+    assert_eq!(fd_err.get_errno(), E::EBADF);
+    let decorated = fd_err.with_fd(Fd::from_native(99_998));
+    assert_eq!(decorated.get_errno(), E::EBADF);
+    let code: bun_sys::SystemErrno = decorated.into();
+    assert_eq!(code, bun_sys::SystemErrno::EBADF);
+}
