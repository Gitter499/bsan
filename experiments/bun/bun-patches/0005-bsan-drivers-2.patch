+fn c_thunks_zlib_alloc_free() {
+    type AllocFunc = extern "C" fn(*mut c_void, u32, u32) -> *mut c_void;
+    type FreeFunc = unsafe extern "C" fn(*mut c_void, *mut c_void);
+    let alloc_func: AllocFunc = bun_alloc::c_thunks::mi_malloc_items;
+    let free_func: FreeFunc = bun_alloc::c_thunks::mi_free_opaque;
+    let opaque = core::ptr::null_mut();
+    // inflateInit: state + window allocations of various sizes.
+    let mut blocks = Vec::new();
+    for (items, size) in [(1u32, 7160u32), (1 << 10, 1), (64, 16), (3, 333)] {
+        let p = alloc_func(opaque, items, size).cast::<u8>();
+        assert!(!p.is_null());
+        let n = (items * size) as usize;
+        // SAFETY: fresh `n`-byte block.
+        unsafe { core::ptr::write_bytes(p, 0x5A, n) };
