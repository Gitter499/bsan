+// runtime/timer/mod.rs:276-320 (TimerHeap insert / remove (clearTimeout) / delete_min / find_max / count)
+#[test]
+fn timer_heap_insert_remove_drain() {
+    let _g = lock();
+    let mut nodes: Box<[Timer]> = (0..200u32)
+        .map(|i| Timer {
+            next: u64::from((i.wrapping_mul(2_654_435_761)) % 997),
+            id: i,
+            heap: Default::default(),
+        })
+        .collect();
+    let base: *mut Timer = nodes.as_mut_ptr();
+    let mut heap = bun_io::heap::Intrusive::<Timer, TimerHeapCtx>::default();
+    assert!(heap.peek().is_null());
+    // SAFETY: every pointer is `base + i` into `nodes`, which is not touched otherwise until
+    // the heap is drained; each node is in at most one heap.
+    unsafe {
+        for i in 0..200 {
+            heap.insert(base.add(i));
+        }
+        assert_eq!(heap.count(), 200);
+        let want_max = (0..200u32)
+            .map(|i| u64::from(i.wrapping_mul(2_654_435_761) % 997))
+            .max()
+            .unwrap();
+        assert_eq!((*heap.find_max()).next, want_max);
+        // clearTimeout on every third timer (root and non-root removals).
+        let mut removed = 0;
+        for i in (0..200).step_by(3) {
+            heap.remove(base.add(i));
+            removed += 1;
+        }
+        // Re-arm a few removed timers with new deadlines (setTimeout refresh).
+        for i in [0usize, 3, 6] {
+            (*base.add(i)).next = 5000 + i as u64;
+            heap.insert(base.add(i));
+            removed -= 1;
+        }
+        assert_eq!(heap.count(), 200 - removed);
+        let mut last = (0u64, 0u32);
+        let mut drained = 0;
+        loop {
+            let t = heap.delete_min();
+            if t.is_null() {
+                break;
+            }
+            let key = ((*t).next, (*t).id);
+            assert!(key >= last, "heap order");
+            last = key;
+            assert!((*t).heap.child.is_null() && (*t).heap.next.is_null() && (*t).heap.prev.is_null());
+            drained += 1;
+        }
+        assert_eq!(drained, 200 - removed);
+        assert_eq!(last.0, 5006);
+        assert!(heap.find_max().is_null());
+        assert_eq!(heap.count(), 0);
+    }
+    drop(nodes);
+}
