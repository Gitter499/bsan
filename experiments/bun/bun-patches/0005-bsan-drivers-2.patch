+// ── InternalSourceMap ─────────────────────────────────────────────────────
+
+/// Multi-source, multi-window VLQ (≥ 64 mappings) with line gaps, 1-field and
+/// 5-field segments.
+fn multi_window_vlq() -> (Vec<u8>, Vec<(i32, i32, i32, i32, i32)>) {
+    let mut out = Vec::new();
+    let mut expected = Vec::new();
+    let (mut src, mut ol, mut oc) = (0i32, 0i32, 0i32);
+    let mut gen_line = 0;
+    for i in 0..30 {
+        let semis = if i == 0 { 0 } else if i % 7 == 0 { 3 } else { 1 };
+        for _ in 0..semis {
+            out.push(b';');
+        }
+        gen_line += semis;
+        let mut gc = 0;
+        for k in 0..3 {
+            if k > 0 {
+                out.push(b',');
+            }
+            let col = k * 11 + (i % 3);
+            let new_src = if i >= 20 { 2 } else { i % 2 };
+            let new_ol = i * 2 + (k % 2);
+            let new_oc = if k == 1 { col } else { col + 4 };
+            for v in [col - gc, new_src - src, new_ol - ol, new_oc - oc] {
+                out.extend_from_slice(VLQ::encode(v).slice());
+            }
+            if k == 2 {
+                out.extend_from_slice(VLQ::encode(1).slice()); // name, dropped
+            }
+            gc = col;
+            src = new_src;
+            ol = new_ol;
+            oc = new_oc;
+            expected.push((gen_line, col, new_src, new_ol, new_oc));
+        }
+        // trailing 1-field segment (generated-only, ignored)
+        out.push(b',');
+        out.extend_from_slice(VLQ::encode(40 - gc).slice());
+    }
+    (out, expected)
+}
