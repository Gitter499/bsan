+// runtime/webcore/FileSink.rs:700 (open_for_writing) + :787 (writer.start(fd, pollable)) + :1172/:1216/:1233 (write / write_latin1 / write_utf16) + :1026 (flush) + :565 (end)
+#[test]
+fn file_sink_streaming_writer_to_regular_file() {
+    let _g = lock();
+    let t = TmpDir::new("filesink");
+    let path = t.abs("out.txt");
+    let io_path = bun_io::PathOrFileDescriptor::Path(&path);
+    let mut pollable = false;
+    let mut is_socket = false;
+    let mut nonblocking = false;
+    let mut is_tty = false;
+    let flags = O::NONBLOCK | O::CLOEXEC | O::CREAT | O::WRONLY | O::TRUNC;
+    let fd = bun_io::open_for_writing(
+        Fd::cwd(),
+        &io_path,
+        flags,
+        0o644,
+        &mut pollable,
+        &mut is_socket,
+        false,
+        &mut nonblocking,
+        &mut is_tty,
+        |tty: &mut bool| *tty = true,
+        is_pollable,
+    )
+    .unwrap();
+    assert!(!pollable && !is_socket && !is_tty);
+
+    let this = Box::into_raw(Box::new(Sink {
+        writer: StreamingWriter::<Sink>::default(),
+        written: Cell::new(0),
+        statuses: core::cell::RefCell::new(Vec::new()),
+        closed: Cell::new(0),
+        errors: Cell::new(0),
+    }));
+    let mut expected = Vec::new();
+    // SAFETY: `this` is live until `Box::from_raw`; writer calls are sequential.
+    unsafe {
+        (*this).writer.set_parent(this);
+        (*this).writer.start(fd, pollable).unwrap();
+        // Small writes are coalesced under the 4 KiB chunk size.
+        for i in 0..50 {
+            let piece = format!("line {i}\n").into_bytes();
+            match (*this).writer.write(&piece) {
+                WriteResult::Wrote(n) => assert_eq!(n, piece.len()),
+                _ => panic!("buffered write"),
+            }
+            expected.extend_from_slice(&piece);
+        }
+        assert!((*this).writer.has_pending_data());
+        // A large write goes straight to the fd, in order after the buffered data.
+        let big = pattern(100_000, 7);
+        assert!(matches!((*this).writer.write(&big), WriteResult::Wrote(_)));
+        expected.extend_from_slice(&big);
+        // Latin-1 with non-ASCII bytes is transcoded to UTF-8 into the buffer.
+        let latin1 = b"caf\xe9 \xff\n";
+        assert!(matches!((*this).writer.write_latin1(latin1), WriteResult::Wrote(_)));
+        expected.extend_from_slice("café ÿ\n".as_bytes());
+        // ASCII latin-1 takes the plain write path.
+        assert!(matches!((*this).writer.write_latin1(b"ascii\n"), WriteResult::Wrote(_)));
+        expected.extend_from_slice(b"ascii\n");
+        let utf16: Vec<u16> = "π≈3.14 😀\n".encode_utf16().collect();
+        assert!(matches!((*this).writer.write_utf16(&utf16), WriteResult::Wrote(_)));
+        expected.extend_from_slice("π≈3.14 😀\n".as_bytes());
+        // Big UTF-16 payload crossing the chunk size.
+        let long16: Vec<u16> = std::iter::repeat_n("ü€".encode_utf16(), 2000).flatten().collect();
+        assert!(matches!((*this).writer.write_utf16(&long16), WriteResult::Wrote(_)));
+        expected.extend_from_slice("ü€".repeat(2000).as_bytes());
+        match (*this).writer.flush() {
+            WriteResult::Wrote(_) => {}
+            _ => panic!("flush"),
+        }
+        assert!(!(*this).writer.has_pending_data());
+        assert_eq!((*this).writer.buffered_len(), 0);
+        assert!(!(*this).writer.is_backed_up());
+        // Empty flush.
+        assert!(matches!((*this).writer.flush(), WriteResult::Wrote(0)));
+        (*this).writer.end();
+        assert_eq!((*this).closed.get(), 1);
+        // Writes after end are dropped.
+        assert!(matches!((*this).writer.write(b"late"), WriteResult::Done(0)));
+        assert_eq!((*this).errors.get(), 0);
+        assert!((*this).statuses.borrow().iter().all(|s| *s != WriteStatus::Pending));
+        drop(Box::from_raw(this));
+    }
+    assert_eq!(t.read("out.txt"), expected);
+
+    // Missing parent dir: the open error surfaces (FileSink then mkdirp's and retries).
+    let missing = t.abs("no/such/dir/out.txt");
+    let e = bun_io::open_for_writing(
+        Fd::cwd(),
+        &bun_io::PathOrFileDescriptor::Path(&missing),
+        flags,
+        0o644,
+        &mut pollable,
+        &mut is_socket,
+        false,
+        &mut nonblocking,
+        &mut is_tty,
+        |tty: &mut bool| *tty = true,
+        is_pollable,
+    );
+    match e {
+        Ok(_) => panic!("expected ENOENT"),
