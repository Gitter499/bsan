+/// event_loop/EventLoopTimer.rs:58 node + runtime/timer/mod.rs:254 comparator shape.
+struct Timer {
+    next: u64,
+    id: u32,
+    heap: bun_io::heap::IntrusiveField<Timer>,
+}
+impl bun_io::heap::HeapNode for Timer {
+    fn heap(&mut self) -> &mut bun_io::heap::IntrusiveField<Self> {
+        &mut self.heap
+    }
+}
+#[derive(Default)]
+struct TimerHeapCtx;
+impl bun_io::heap::HeapContext<Timer> for TimerHeapCtx {
+    unsafe fn less(&self, a: *mut Timer, b: *mut Timer) -> bool {
+        // SAFETY: `Intrusive` only passes live member nodes.
+        let (a, b) = unsafe { (&*a, &*b) };
+        (a.next, a.id) < (b.next, b.id)
+    }
+}
