+// runtime/napi/napi_body.rs:894 (fmt::utf16 Display through the shared temp buffer)
+#[test]
+fn fmt_utf16_and_nested_shared_buffer() {
+    let units = utf16(MULTI);
+    let s = format!("napi_create_string_utf16: {} {}", units.len(), bun_core::fmt::utf16(&units[..units.len().min(512)]));
+    assert!(s.ends_with(MULTI));
+    // Nested borrow: the writer itself formats fmt::utf16 while the outer call still
+    // holds the thread-local temp buffer (inner allocates a fresh one; on drop the
+    // inner parks its buffer and the outer frees its own).
+    struct Nesting<'a> {
+        out: String,
+        inner: &'a [u16],
+    }
+    impl std::fmt::Write for Nesting<'_> {
+        fn write_str(&mut self, s: &str) -> std::fmt::Result {
+            self.out.push_str(s);
+            let x = format!("{}", bun_core::fmt::utf16(self.inner));
+            self.out.push_str(&x);
+            Ok(())
+        }
+    }
+    let mut nesting = Nesting {
+        out: String::new(),
+        inner: &units,
+    };
+    bun_core::fmt::format_utf16_type(&units, &mut nesting).unwrap();
+    assert_eq!(nesting.out, format!("{MULTI}{MULTI}"));
+    // and again, now that the cell holds a parked buffer
+    assert_eq!(format!("{}", bun_core::fmt::utf16(&units)), MULTI);
+    // lone surrogate → U+FFFD; long input spanning several 32 KiB chunks is avoided (BSan cost)
+    let lone = [0x41u16, 0xD800, 0x42];
+    assert_eq!(format!("{}", bun_core::fmt::utf16(&lone)), "A\u{FFFD}B");
+}
