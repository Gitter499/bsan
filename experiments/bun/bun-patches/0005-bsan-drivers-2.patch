+// bundler/LinkerContext.rs:1666 (generate per-file LineOffsetTable) + js_printer
+// add_source_mapping column remap over non-ASCII / CRLF / U+2028 input.
+#[test]
+fn line_offset_table_non_ascii() {
+    let src = "a = \"ü\";\r\nb = '🎉' + c;\u{2028}d;\n\nconst é = 1; x\n";
+    let table = LineOffsetTable::generate(src.as_bytes(), 2).expect("table");
+    let starts = table.items_byte_offset_to_start_of_line();
+    let first_na = table.items_byte_offset_to_first_non_ascii();
+    assert_eq!(starts.len(), 6);
+    assert_eq!(starts[0], 0);
+    assert_eq!(starts[1] as usize, src.find("b =").unwrap());
+    assert_eq!(starts[2] as usize, src.find("d;").unwrap());
+    assert_eq!(first_na[0], 5);
+    assert_eq!(first_na[3], i32::MAX as u32);
+    for (off, want) in [(0usize, Some(0usize)), (src.find("c;").unwrap(), Some(1)), (src.find("x").unwrap(), Some(4))] {
+        assert_eq!(LineOffsetTable::find_index(starts, Loc { start: off as i32 }), want);
+    }
+    drop(table);
+
+    // The same input through the printer's deferred-table path.
+    let lines: Vec<String> = vec!["a = \"ü\", f(a);".into(), "b = '🎉' + f(c, a);".into()];
+    let p = print_bundler(&lines);
+    let parsed = mapping::parse(&p.chunk.buffer.list, None, 1, 2, ParseOptions::default())
+        .unwrap_or_else(|f| panic!("{}", f.err));
+    for &(gl, gc, ol, oc) in &p.expected {
+        let m = parsed.find_mapping(ord(gl), ord(gc)).expect("m");
+        assert_eq!((m.original_line(), m.original_column()), (ol, oc));
+    }
+}
