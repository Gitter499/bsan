+// runtime/node/node_fs.rs:4772 (UninitBuf stack buffer filled by read(2))
+#[test]
+fn vec_uninit_buf_read_loop() {
+    let mut fds = [0 as libc::c_int; 2];
+    // SAFETY: `fds` is a valid out-array of two ints.
+    assert_eq!(unsafe { libc::pipe(fds.as_mut_ptr()) }, 0);
+    let payload = ascii_then(65, MULTI.as_bytes());
+    // SAFETY: `payload` is readable for its length; fds[1] is the pipe's write end.
+    let n = unsafe { libc::write(fds[1], payload.as_ptr().cast(), payload.len()) };
+    assert_eq!(n as usize, payload.len());
+    // SAFETY: closing our own fd.
+    unsafe { libc::close(fds[1]) };
+
+    const STACK_BUF_LEN: usize = 64;
+    let mut stack_buf = bun_core::vec::UninitBuf::<STACK_BUF_LEN>::uninit();
+    let mut got: Vec<u8> = Vec::new();
+    loop {
+        // SAFETY: `read` is the only writer of `buf`; we read back only `buf[..amt]`.
+        let buf: &mut [u8] = unsafe { stack_buf.as_bytes_mut() };
+        // SAFETY: `buf` is valid for `buf.len()` bytes of writes.
+        let amt = unsafe { libc::read(fds[0], buf.as_mut_ptr().cast(), buf.len()) };
+        assert!(amt >= 0);
+        if amt == 0 {
+            break;
+        }
+        // SAFETY: read(2) initialized the first `amt` bytes.
+        got.extend_from_slice(unsafe { stack_buf.filled(amt as usize) });
+    }
+    // SAFETY: closing our own fd.
+    unsafe { libc::close(fds[0]) };
+    assert_eq!(got, payload);
+}
