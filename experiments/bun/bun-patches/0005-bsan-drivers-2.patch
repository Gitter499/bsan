+// js_parser/parse/parse_entry.rs:2434 (parts.reserve; parts.prepend_from(&mut before); parts.append(&mut after))
+#[test]
+fn baby_vec_prepend_append() {
+    let arena = MimallocArena::new();
+    // js_parser/parse/parse_entry.rs:988-990
+    let mut before: ArenaVec<'_, String> = ArenaVec::new_in(&arena);
+    let mut after: ArenaVec<'_, String> = ArenaVec::new_in(&arena);
+    let mut parts: ArenaVec<'_, String> = ArenaVec::with_capacity_in(4 + 2, &arena);
+    for i in 0..4 {
+        parts.push(format!("part{i}"));
+    }
+    for i in 0..3 {
+        before.push(format!("before{i}"));
+    }
+    for i in 0..5 {
+        after.push(format!("after{i}"));
+    }
+    parts.reserve(before.len() + after.len());
+    parts.prepend_from(&mut before);
+    parts.append(&mut after);
+    assert!(before.is_empty() && after.is_empty());
+    let got: Vec<&str> = parts.iter().map(|s| s.as_str()).collect();
+    assert_eq!(
+        got,
+        [
+            "before0", "before1", "before2", "part0", "part1", "part2", "part3", "after0",
+            "after1", "after2", "after3", "after4"
+        ]
+    );
+    // insert/remove (order-preserving) with owning elements to exercise drop glue.
+    parts.insert(0, "head".to_string());
+    parts.insert(parts.len(), "tail".to_string());
+    parts.insert(5, "mid".to_string());
+    assert_eq!(parts.remove(5), "mid");
+    assert_eq!(parts[0], "head");
+    assert_eq!(parts[parts.len() - 1], "tail");
+    parts.truncate(3);
+    assert_eq!(parts.len(), 3);
+    parts.clear();
+    assert!(parts.is_empty());
+}
