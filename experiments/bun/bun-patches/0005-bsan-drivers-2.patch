+        bun_core::zstr!("old"),
+    )
+    .unwrap();
+    assert_eq!(std::fs::read(t.std_path(b"tmpdir/old")).unwrap(), b"v2");
+    // File::close_and_move_to (cwd-relative, absolute paths here).
+    let src = t.abs_z(b"tmpdir/old");
+    let dst = t.abs_z(b"moved");
+    let f = File::open(ZStr::from_slice_with_nul(&src), O::RDONLY, 0).unwrap();
+    f.close_and_move_to(ZStr::from_slice_with_nul(&src), ZStr::from_slice_with_nul(&dst))
+        .unwrap();
+    assert_eq!(std::fs::read(t.std_path(b"moved")).unwrap(), b"v2");
+}
