+// BUMP_MAX into the spill heap (grow slow path + mi_expand gate); driven by
+// runtime/jsc_hooks.rs:2301 (ScopedAstAlloc::with_spill(arena_heap)) for a synchronous transpile.
+#[test]
+fn ast_vec_grow_across_bump_max() {
+    let arena = MimallocArena::new();
+    let scope = ScopedAstAlloc::with_spill(arena.heap_ptr());
+    {
+        let mut items: AstVec<u64> = AstAlloc::vec();
+        for i in 0..300u64 {
+            items.push(i * 7);
+        }
