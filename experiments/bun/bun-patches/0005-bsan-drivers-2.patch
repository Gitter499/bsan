+// ── chunk::Builder (js_printer) ───────────────────────────────────────────
+
+struct Printed {
+    source: String,
+    output: Vec<u8>,
+    chunk: Chunk,
+    /// (gen_line, gen_col_utf16, orig_line, orig_col_utf16)
+    expected: Vec<(i32, i32, i32, i32)>,
+}
+
+fn utf16_col(line: &str, byte: usize) -> i32 {
+    line[..byte].encode_utf16().count() as i32
+}
+
+/// Drive the builder exactly as js_printer does: `add_source_mapping(loc,
+/// written_so_far)` before each token, then `generate_chunk(full_output)`.
+fn print_with_builder(mut builder: Builder<'_>, source: &str, lines: &[String], blank_every: usize) -> (Vec<u8>, Chunk, Vec<(i32, i32, i32, i32)>) {
+    let mut output = Vec::new();
+    let mut expected = Vec::new();
+    let mut gen_line = 0;
+    let mut src_off = 0usize;
+    for (i, line) in lines.iter().enumerate() {
+        if blank_every != 0 && i % blank_every == blank_every - 1 {
+            output.extend_from_slice(b"\r\n");
+            gen_line += 1;
+        }
+        let mut tokens: Vec<usize> = [Some(0), line.find("f"), line.find("a")].into_iter().flatten().collect();
+        tokens.sort_unstable();
+        tokens.dedup();
+        let mut last = 0;
+        for &t in &tokens {
+            output.extend_from_slice(&line.as_bytes()[last..t]);
+            builder.add_source_mapping(Loc { start: (src_off + t) as i32 }, &output);
+            // duplicate loc is ignored
+            builder.add_source_mapping(Loc { start: (src_off + t) as i32 }, &output);
+            let col = utf16_col(line, t);
+            expected.push((gen_line, col, i as i32, col));
+            last = t;
+        }
+        output.extend_from_slice(&line.as_bytes()[last..]);
+        output.push(b'\n');
+        gen_line += 1;
+        src_off += line.len() + 1;
+        // generated-only code: Loc::EMPTY is skipped
+        builder.add_source_mapping(Loc::EMPTY, &output);
+    }
+    assert_eq!(src_off, source.len());
+    let chunk = builder.generate_chunk(&output);
+    (output, chunk, expected)
+}
+
+fn source_lines(n: usize) -> Vec<String> {
+    (0..n)
+        .map(|i| if i % 3 == 0 { format!("let v{i} = \"é🎉\", w = f{i}(a{i});") } else { format!("let v{i} = f{i}(a{i}, \"ü\");") })
+        .collect()
+}
+
+/// js_printer/lib.rs:7661 `get_source_map_builder::<IS_BUN_PLATFORM = true>` with
+/// `GenerateSourceMap::Lazy` (runtime transpiler: InternalSourceMap output).
+fn print_runtime(n: usize) -> Printed {
+    let lines = source_lines(n);
+    let source = lines.iter().map(|l| format!("{l}\n")).collect::<String>();
+    let builder = Builder {
+        source_map: SourceMapFormat::init(true),
+        cover_lines_without_mappings: true,
+        approximate_input_line_count: n,
+        prepend_count: true,
+        line_offset_tables: LineOffsetTables::Deferred { contents: source.as_bytes(), approximate_line_count: n as i32 },
+        ..Default::default()
+    };
+    let (output, chunk, expected) = print_with_builder(builder, &source, &lines, 9);
+    Printed { source, output, chunk, expected }
+}
