+// ───────────────────────────── hashbrown_bridge ─────────────────────────────
+
+/// One hashbrown table allocation the way `RawTableInner::new_uninitialized`
+/// lays it out (buckets * size_of::<T>() data + buckets + Group::WIDTH ctrl
+/// bytes, aligned to max(align_of::<T>(), Group::WIDTH)), filled, read back,
+/// and freed through the polyfill trait.
+fn hashbrown_table_cycle<A: HashbrownAllocator>(alloc: &A, buckets: usize, elem: usize) {
+    const GROUP: usize = 16;
+    let size = buckets * elem + buckets + GROUP;
+    let layout = Layout::from_size_align(size, GROUP).unwrap();
+    let p = alloc.allocate(layout).expect("table alloc").cast::<u8>();
+    // SAFETY: fresh `size`-byte block.
+    unsafe {
+        let ctrl = p.as_ptr().add(buckets * elem);
+        core::ptr::write_bytes(ctrl, 0xFF, buckets + GROUP); // EMPTY
+        for b in 0..buckets {
+            let slot = p.as_ptr().add(b * elem);
+            core::ptr::write_bytes(slot, b as u8, elem);
+            *ctrl.add(b) = (b & 0x7F) as u8;
+        }
+        for b in 0..buckets {
+            assert_eq!(*p.as_ptr().add(b * elem + elem - 1), b as u8);
+            assert_eq!(*ctrl.add(b), (b & 0x7F) as u8);
+        }
+        alloc.deallocate(p, layout);
+    }
+}
