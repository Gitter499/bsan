+// sourcemap_jsc/CodeCoverage.rs:849 (internal_cursor) + :865 (LineOffsetTable::find_index)
+// over the table from :1041 (LineOffsetTable::generate)
+#[test]
+fn coverage_cursor_over_internal_map() {
+    let p = print_runtime(24);
+    let blob_ptr: *mut [u8] = Box::into_raw(p.chunk.buffer.list.clone().into_boxed_slice());
+    let map = ParsedSourceMap::from_internal(InternalSourceMap { data: blob_ptr.cast::<u8>().cast_const() });
+
+    let table = LineOffsetTable::generate(&p.output, 0).expect("table");
+    let line_starts = table.items_byte_offset_to_start_of_line();
+    assert_eq!(line_starts.len(), bun_core::strings::count_char(&p.output, b'\n') + 1);
+
+    let mut cur = map.internal_cursor().expect("cursor");
+    let mut hits = 0;
+    // Coverage walks byte offsets of executed blocks in order.
+    for byte_offset in (0..p.output.len()).step_by(3) {
+        let Some(line) = LineOffsetTable::find_index(line_starts, Loc { start: byte_offset as i32 }) else { continue };
+        let start = line_starts[line] as usize;
+        if start >= byte_offset {
+            continue;
+        }
+        let col = byte_offset - start;
+        let a = cur.move_to(ord(line as i32), ord(col as i32));
+        let b = map.find_mapping(ord(line as i32), ord(col as i32));
+        assert_eq!(a.map(|m| (m.original_line(), m.original_column())), b.map(|m| (m.original_line(), m.original_column())));
+        hits += a.is_some() as usize;
+    }
+    assert!(hits > 0);
+    // Backwards seek forces reseek.
+    let (gl, gc, ol, _) = p.expected[2];
+    assert_eq!(cur.move_to(ord(gl), ord(gc)).unwrap().original_line(), ol);
+}
