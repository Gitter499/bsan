+    // .text raw data immediately after the section table: no room for a 4th header.
+    let mut b = good.clone();
+    put32(&mut b, SECT + 20, 0x200);
+    let mut tight = PEFile::init(&b).unwrap();
+    assert_eq!(tight.add_bun_section(b"x").err(), Some(pe::Error::InsufficientHeaderSpace));
