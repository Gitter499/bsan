+// runtime/webcore/TextEncoderStreamEncoder.rs:75 (Latin-1 → UTF-8 through fill_spare loop)
+#[test]
+fn text_encoder_stream_encode_latin1() {
+    for n in ASCII_LENS {
+        // Latin-1 high bytes (é, ÿ, ©) after a block-boundary ASCII run, then more ASCII.
+        let mut input = ascii_then(n, &[0xE9, 0xFF, 0xA9]);
+        input.extend_from_slice(&ascii(n));
+        let prepend_replacement_len = 0usize;
+        let mut buffer: Vec<u8> = Vec::new();
+        buffer.try_reserve(input.len() + prepend_replacement_len).unwrap();
+        let mut remain: &[u8] = &input;
+        while !remain.is_empty() {
+            // SAFETY: copy_latin1_into_utf8 writes initialized bytes into the spare capacity and
+            // returns the number written; fill_spare commits exactly that many.
+            let result = unsafe {
+                bun_core::vec::fill_spare(&mut buffer, 0, |spare| {
+                    let r = strings::copy_latin1_into_utf8(spare, remain);
+                    (r.written as usize, r)
+                })
+            };
+            remain = &remain[result.read as usize..];
+            if result.written == 0 && result.read == 0 {
+                buffer.try_reserve(2).unwrap();
+            } else if buffer.len() == buffer.capacity() && !remain.is_empty() {
+                buffer.try_reserve(remain.len() + 1).unwrap();
+            }
+        }
+        assert_eq!(buffer.len(), simdutf::length::utf8::from::latin1(&input));
+        assert_eq!(buffer.len(), strings::element_length_latin1_into_utf8(&input));
+        let expect: String = input.iter().map(|&b| b as char).collect();
+        assert_eq!(buffer, expect.as_bytes());
+    }
+}
