+/// runtime/api/bun/subprocess.rs:158 slot shape.
+struct SubprocessLike {
+    stdout_maxbuf: Cell<Option<NonNull<MaxBuf>>>,
+    exited_due_to_maxbuf: Cell<bool>,
+}
+/// runtime/api/bun/subprocess.rs:689 shape.
+///
+/// # Safety
+/// `sp` is the live `SubprocessLike` registered with `create_for_subprocess`.
+unsafe fn on_max_buffer_overflow(sp: NonNull<()>, maxbuf: NonNull<MaxBuf>) {
+    // SAFETY: caller contract; all accessed fields are `Cell<_>`.
+    let sp = unsafe { sp.cast::<SubprocessLike>().as_ref() };
+    assert_eq!(sp.stdout_maxbuf.get(), Some(maxbuf));
+    let mut mb = sp.stdout_maxbuf.get();
+    MaxBuf::remove_from_subprocess(&mut mb);
+    sp.stdout_maxbuf.set(mb);
+    sp.exited_due_to_maxbuf.set(true);
+}
+
+// runtime/api/bun/js_bun_spawn_bindings.rs:1328 (create_for_subprocess) + subprocess/SubprocessPipeReader.rs:118 (add_to_pipereader) + subprocess.rs:689 (overflow callback)
+#[test]
+fn maxbuf_overflow_stops_reader() {
+    let _g = lock();
+    let t = TmpDir::new("maxbuf");
+    let data = pattern(200_000, 6);
+    t.write("stdout", &data);
+    for &(max_buffer, expect_overflow) in &[(1000i64, true), (300_000, false)] {
+        let fd = t.open_ro("stdout");
+        let subprocess = Box::new(SubprocessLike {
+            stdout_maxbuf: Cell::new(None),
+            exited_due_to_maxbuf: Cell::new(false),
+        });
+        let owner = MaxBufOwner {
+            ptr: NonNull::from(&*subprocess).cast::<()>(),
+            on_overflow: on_max_buffer_overflow,
+        };
+        let mut mb = None;
+        MaxBuf::create_for_subprocess(&mut mb, Some(max_buffer), owner);
+        subprocess.stdout_maxbuf.set(mb);
+
+        let mut lp = TestLoop::new();
+        let this = FileStream::new(&raw mut *lp);
+        // SAFETY: `this` is live; field write before reading.
+        unsafe { MaxBuf::add_to_pipereader(mb, &mut (*this).reader.maxbuf) };
+        file_response_stream_start(this, fd, 0, None);
+        let s = free_stream(this);
+        assert_eq!(subprocess.exited_due_to_maxbuf.get(), expect_overflow);
+        assert_eq!(s.done.get(), 1);
+        if expect_overflow {
+            // Overread is bounded to one 64 KiB read past the budget.
+            assert!(s.body.len() > 1000 && s.body.len() <= 1000 + 64 * 1024);
+            assert_eq!(&s.body[..], &data[..s.body.len()]);
+            assert!(subprocess.stdout_maxbuf.get().is_none());
+        } else {
+            assert_eq!(s.body, data);
+            // Subprocess finalize (subprocess.rs:1354) drops its claim.
+            let mut mb = subprocess.stdout_maxbuf.get();
+            MaxBuf::remove_from_subprocess(&mut mb);
+            subprocess.stdout_maxbuf.set(mb);
+        }
+        // Dropping the reader releases the last claim and frees the MaxBuf.
+        drop(s);
+        sys::close(fd).unwrap();
+    }
+    // No limit → no allocation.
+    let mut none = None;
+    let dummy = SubprocessLike {
+        stdout_maxbuf: Cell::new(None),
+        exited_due_to_maxbuf: Cell::new(false),
+    };
+    MaxBuf::create_for_subprocess(
+        &mut none,
+        None,
+        MaxBufOwner {
+            ptr: NonNull::from(&dummy).cast::<()>(),
+            on_overflow: on_max_buffer_overflow,
+        },
+    );
+    assert!(none.is_none());
+}
