+// ast/ast_memory_allocator.rs:289 (push: acquire_state + set_spill_heap + swap_state),
+// :314 (re-arming push: set_active_spill_heap), :320 (pop), :258 (reset), :190 (release_ast_state)
+#[test]
+fn ast_memory_allocator_push_pop_reset() {
+    let mut arena = MimallocArena::new();
+    let mut ast_state: Option<Box<AstAllocState>> = None;
+    for round in 0..3u32 {
+        // push()
+        let spill = arena.heap_ptr();
+        let mut state = ast_state.take().unwrap_or_else(ast_alloc::acquire_state);
+        state.set_spill_heap(spill);
+        let previous_ast_state = ast_alloc::swap_state(Some(state));
+        assert!(!ast_alloc::active_state_id().is_null());
+
+        // Parse: many small lists (bump chunk), each fully written before the next
+        // allocation; then lists > BUMP_MAX that land on the spill heap.
+        let mut small: Vec<AstVec<u32>> = Vec::new();
+        for i in 0..40u32 {
+            small.push(AstAlloc::vec_from_slice(&[round, i, i + 1, i + 2]));
+        }
+        let mut big: AstVec<u64> = AstAlloc::vec_with_capacity(100); // 800 B → spill
+        for i in 0..100u64 {
+            big.push(i ^ round as u64);
+        }
+        // Re-arming push (MiniStore): re-point the spill heap at the arena.
+        ast_alloc::set_active_spill_heap(arena.heap_ptr());
+        let mut big2: AstVec<u64> = AstAlloc::vec_with_capacity(80);
+        big2.extend(0..80u64);
+        // Spill blocks never alias the state, so writing them back is fine.
+        big[0] = 1234;
+
+        // pop()
+        ast_state = ast_alloc::swap_state(previous_ast_state);
+        assert!(ast_state.is_some());
+        assert!(ast_alloc::active_state_id().is_null());
+
+        // The AST is read after pop, while the state is still owned.
+        for (i, v) in small.iter().enumerate() {
+            assert_eq!(&v[..], &[round, i as u32, i as u32 + 1, i as u32 + 2]);
+        }
+        assert_eq!(big[0], 1234);
+        assert_eq!(big[99], 99 ^ round as u64);
+        assert_eq!(big2.iter().sum::<u64>(), 79 * 80 / 2);
+        drop(small);
+        drop(big);
+        drop(big2);
+
+        // reset(): reset_ast_state() then arena.reset()
+        if let Some(state) = ast_state.as_deref_mut() {
+            state.reset();
+        }
+        arena.reset();
+    }
+    // release_ast_state()
+    if let Some(state) = ast_state.take() {
+        ast_alloc::release_state(state);
+    }
+}
