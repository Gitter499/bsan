+// runtime/bake/FrameworkRouter.rs:1605 (per-entry reset_retain_with_limit(8 MiB)) +
+// runtime/api.rs:248 (Recycle: reset_retain_with_limit(2 MiB) then park)
+#[test]
+fn arena_reset_retain_with_limit() {
+    let mut arena = MimallocArena::new();
+    for round in 0..20usize {
+        {
+            let mut v: Vec<u8, &MimallocArena> = Vec::new_in(&arena);
+            v.extend_from_slice(&[round as u8; 700]);
+            let leaked = v.into_bump_slice();
+            assert_eq!(leaked.len(), 700);
+            let s = arena.alloc_slice_fill_default::<u8>(64);
+            s[0] = round as u8;
+        }
+        // Tight limit every 4th round forces the full reset() (mi_heap_destroy + mi_heap_new).
+        let limit = if round % 4 == 3 { 0 } else { 8 * 1024 * 1024 };
+        let retained = arena.reset_retain_with_limit(limit);
+        assert_eq!(retained, limit != 0);
+    }
+    // ast/ast_memory_allocator.rs:258 (ASTMemoryAllocator::reset → arena.reset())
+    let p = arena.alloc_slice_copy(b"before reset");
+    assert_eq!(p, b"before reset");
+    arena.reset();
+    let q = arena.alloc_slice_copy(b"after reset");
+    assert_eq!(q, b"after reset");
+    // runtime/api.rs:248
+    assert!(arena.reset_retain_with_limit(2 * 1024 * 1024));
+}
