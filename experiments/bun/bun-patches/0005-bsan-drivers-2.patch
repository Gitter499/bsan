+// runtime/cli/init_command.rs:543 (open_dir_at + iterate_dir + kind filter + name.slice_u8())
+#[test]
+fn iterate_dir_many_entries() {
+    let _g = lock();
+    let t = TmpDir::new("iterate");
+    let names = iteration_names();
+    for n in &names {
+        write_std(&t.std_path(n), n);
+    }
+    for i in 0..10 {
+        std::fs::create_dir(t.std_path(format!("dir_{i}").as_bytes())).unwrap();
+    }
+    std::os::unix::fs::symlink("file_000.js", t.std_path(b"sym")).unwrap();
+
+    let dir = sys::open_dir_at(Fd::cwd(), t.bytes()).unwrap();
+    let mut it = sys::iterate_dir(dir);
+    let mut files: Vec<Vec<u8>> = Vec::new();
+    let mut dirs = 0;
+    let mut syms = 0;
+    while let Some(entry) = it.next().unwrap() {
+        let name = entry.name.slice_u8();
+        assert_ne!(name, b".");
+        assert_ne!(name, b"..");
+        // The name is NUL-terminated in place; use it as a path straight from the dirent buffer.
+        let zname = entry.name.as_zstr();
+        assert_eq!(zname.as_bytes(), name);
+        let st = sys::lstatat(it.dir(), zname).unwrap();
+        match entry.kind {
+            EntryKind::File => {
+                assert!(bun_sys::S::ISREG(st.st_mode as _));
+                files.push(name.to_vec());
+            }
+            EntryKind::Directory => {
+                assert!(bun_sys::S::ISDIR(st.st_mode as _));
+                dirs += 1;
+            }
+            EntryKind::SymLink => {
+                assert!(bun_sys::S::ISLNK(st.st_mode as _));
+                syms += 1;
+            }
+            // Some filesystems report DT_UNKNOWN.
+            EntryKind::Unknown => files.push(name.to_vec()),
+            _ => panic!("unexpected kind"),
+        }
+    }
+    // Exhausted iterator keeps returning None.
+    assert!(it.next().unwrap().is_none());
+    sys::close(dir).unwrap();
+    files.sort();
+    let mut want = names.clone();
+    want.sort();
+    assert_eq!(files, want);
+    assert_eq!(files.len() + dirs + syms, names.len() + 11);
+    assert_eq!(dirs, 10);
+    assert_eq!(syms, 1);
+
+    // Empty directory: no entries.
+    std::fs::create_dir(t.std_path(b"empty")).unwrap();
+    let empty = sys::open_dir_for_iteration(t.fd, b"empty").unwrap();
+    let mut it = sys::iterate_dir(empty);
+    assert!(it.next().unwrap().is_none());
+    sys::close(empty).unwrap();
+
+    // Iterating a regular-file fd fails with ENOTDIR from getdents64.
+    let f = sys::openat_a(t.fd, b"x", O::RDONLY, 0).unwrap();
+    let mut it = sys::iterate_dir(f);
+    assert_eq!(it.next().errno_of(), E::ENOTDIR);
+    sys::close(f).unwrap();
+}
