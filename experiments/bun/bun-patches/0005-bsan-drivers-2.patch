+// standalone_graph/StandaloneModuleGraph.rs:2452 on a patchelf'd (NixOS autoPatchelfHook) binary.
+#[test]
+fn elf_normalize_nix_store_interpreter() {
+    let path = temp_copy("/bin/true", "true-nix");
+    let mut data = std::fs::read(&path).unwrap();
+    let phoff = u64_at(&data, 32) as usize;
+    let phnum = u16_at(&data, 56) as usize;
+    let interp_ph = (0..phnum).map(|i| phoff + i * 56).find(|&ph| u32_at(&data, ph) == 3).expect("PT_INTERP");
+    let old_off = u64_at(&data, interp_ph + 8) as usize;
+    let old_sz = u64_at(&data, interp_ph + 32) as usize;
+    let old = data[old_off..old_off + old_sz].split(|&c| c == 0).next().unwrap().to_vec();
+    let basename = old.rsplit(|&c| c == b'/').next().unwrap().to_vec();
+    // patchelf appends the new interpreter string and repoints PT_INTERP at it.
+    let mut nix = b"/nix/store/0c7c4l4f5n4a6m6yb1m7v8p0c6rzxk2a-glibc-2.40-66/lib/".to_vec();
+    nix.extend_from_slice(&basename);
+    nix.push(0);
+    let new_off = data.len();
+    data.extend_from_slice(&nix);
+    put64(&mut data, interp_ph + 8, new_off as u64);
+    put64(&mut data, interp_ph + 32, nix.len() as u64);
+    put64(&mut data, interp_ph + 40, nix.len() as u64);
+
+    let mut elf = ElfFile::init(data).unwrap_or_else(|e| panic!("init: {e}"));
+    elf.normalize_interpreter();
+    let new_sz = u64_at(&elf.data, interp_ph + 32) as usize;
+    let rewritten = &elf.data[new_off..new_off + new_sz];
+    let known: [&[u8]; 4] = [
+        b"/lib64/ld-linux-x86-64.so.2\0",
+        b"/lib/ld-linux-aarch64.so.1\0",
+        b"/lib/ld-musl-x86_64.so.1\0",
+        b"/lib/ld-musl-aarch64.so.1\0",
+    ];
+    if known.iter().any(|k| k.ends_with(&[&basename[..], b"\0"].concat())) {
+        assert!(known.contains(&rewritten), "{:?}", bstr::BStr::new(rewritten));
+        assert_eq!(u64_at(&elf.data, interp_ph + 40) as usize, new_sz);
+        assert!(elf.data[new_off + new_sz..new_off + nix.len()].iter().all(|&c| c == 0));
+    }
+    let _ = std::fs::remove_file(&path);
+}
