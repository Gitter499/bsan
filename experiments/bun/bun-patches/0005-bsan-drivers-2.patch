+// runtime/shell/states/Pipeline.rs:161 (pipe) + runtime/bin_entry/mod.rs:221 (dup_at_least) + nonblocking reads
+#[test]
+fn pipe_dup_nonblocking_eof() {
+    let _g = lock();
+    let [r, w] = sys::pipe().unwrap();
+    sys::set_close_on_exec(r).unwrap();
+    // Plain pipe: no O_NONBLOCK until we set it.
+    assert_eq!(sys::get_fcntl_flags(r).unwrap() as i32 & O::NONBLOCK, 0);
+    sys::set_nonblocking(r).unwrap();
+    assert_ne!(sys::get_fcntl_flags(r).unwrap() as i32 & O::NONBLOCK, 0);
+    let mut buf = vec![0u8; 1000];
+    let err = sys::read(r, &mut buf).unwrap_err();
+    assert!(err.is_retry());
+    assert_eq!(err.get_errno(), E::EAGAIN);
+    // Many small writes, then reads crossing write boundaries.
+    let msg = pattern(300, 1);
+    for chunk in msg.chunks(7) {
+        assert_eq!(sys::write(w, chunk).unwrap(), chunk.len());
+    }
+    let mut got = Vec::new();
+    let mut small = [0u8; 64];
+    while got.len() < msg.len() {
+        let n = sys::read(r, &mut small).unwrap();
+        got.extend_from_slice(&small[..n]);
+    }
+    assert_eq!(got, msg);
+    // dup keeps both ends usable; dup_at_least picks a high fd.
+    let w2 = sys::dup(w).unwrap();
+    let hi = sys::dup_at_least(w2, 200).unwrap();
+    assert!(hi.native() >= 200);
+    assert_eq!(sys::write(hi, b"hi").unwrap(), 2);
+    assert_eq!(sys::read(r, &mut small).unwrap(), 2);
+    sys::update_nonblocking(r, false).unwrap();
+    assert_eq!(sys::get_fcntl_flags(r).unwrap() as i32 & O::NONBLOCK, 0);
+    sys::close(hi).unwrap();
+    sys::close(w2).unwrap();
+    sys::close(w).unwrap();
+    // All writers gone: EOF.
+    assert_eq!(sys::read(r, &mut small).unwrap(), 0);
+    assert!(!sys::isatty(r));
+    sys::close(r).unwrap();
+    // Double close reports EBADF.
+    assert_eq!(sys::close(r).errno_of(), E::EBADF);
+    if let Ok(fd) = sys::dup_at_least(Fd::stdin(), 1023) {
+        let _ = sys::close(fd);
+    }
+}
