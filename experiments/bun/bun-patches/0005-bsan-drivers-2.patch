+// shell_parser/parse.rs:4189 (SmolList::promote: Vec::with_capacity_in(n + 1, &Bump) + push)
+#[test]
+fn arena_vec_alloc_grow_free() {
+    let arena = MimallocArena::new();
+    // promote(): exact-capacity alloc, push past capacity (grow → mi_heap_realloc_aligned).
+    let mut list: Vec<u32, &MimallocArena> = Vec::with_capacity_in(5, &arena);
+    for i in 0..300u32 {
+        list.push(i * 3);
+    }
+    assert_eq!(list.len(), 300);
+    assert!(list.iter().enumerate().all(|(i, v)| *v == i as u32 * 3));
+    // shell_parser/parse.rs:4226 (init_with_slice: with_capacity_in + extend_from_slice)
+    let vals: Vec<u64> = (0..200).collect();
+    let mut heap: Vec<u64, &MimallocArena> = Vec::with_capacity_in(vals.len(), &arena);
+    heap.extend_from_slice(&vals);
+    assert_eq!(&heap[..], &vals[..]);
+    // Allocator::shrink path (mi_heap_realloc_aligned to a smaller size).
+    list.truncate(10);
+    list.shrink_to_fit();
+    assert_eq!(&list[..3], &[0, 3, 6]);
+    assert_eq!(list.bump() as *const _, &arena as *const _);
+    drop(list); // Allocator::deallocate → mi_free_checked
+    drop(heap);
+    // Over-aligned element types route through mi_heap_malloc_aligned.
+    #[repr(align(64))]
+    #[derive(Clone, Copy)]
+    struct Wide([u8; 64]);
+    let mut wide: Vec<Wide, &MimallocArena> = Vec::new_in(&arena);
+    for i in 0..40u8 {
+        wide.push(Wide([i; 64]));
+    }
+    for (i, w) in wide.iter().enumerate() {
+        assert_eq!((w as *const Wide as usize) % 64, 0);
+        assert!(w.0.iter().all(|b| *b == i as u8));
+    }
+    // Many sizes / alignments through the raw Allocator trait.
+    let mut blocks = Vec::new();
+    for (i, &(size, align)) in [
+        (1usize, 1usize),
+        (7, 1),
+        (16, 8),
+        (24, 16),
+        (100, 32),
+        (513, 64),
+        (4096, 128),
+        (8192, 4096),
+        (65536, 16),
+    ]
+    .iter()
+    .enumerate()
+    {
+        let layout = Layout::from_size_align(size, align).unwrap();
+        let p = (&arena).allocate(layout).expect("alloc");
+        let base = p.cast::<u8>();
+        assert_eq!(base.as_ptr() as usize % align, 0);
+        // SAFETY: `p` is a fresh `size`-byte block.
+        unsafe { core::ptr::write_bytes(base.as_ptr(), i as u8 + 1, size) };
+        blocks.push((base, layout, i as u8 + 1));
+    }
+    for (base, layout, tag) in &blocks {
+        // SAFETY: block is live and fully initialised above.
+        let s = unsafe { core::slice::from_raw_parts(base.as_ptr(), layout.size()) };
+        assert!(s.iter().all(|b| b == tag));
+    }
+    // Free half individually, leave the rest for `mi_heap_destroy` on Drop.
+    for (base, layout, _) in blocks.iter().step_by(2) {
+        // SAFETY: allocated above by this arena with `layout`.
+        unsafe { (&arena).deallocate(*base, *layout) };
+    }
+}
