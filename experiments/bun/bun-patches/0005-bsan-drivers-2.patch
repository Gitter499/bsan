+// bundler/LinkerGraph.rs:903 (bun_alloc::transfer_arena(v, heap)) then linker-side pushes
+#[test]
+fn baby_vec_transfer_arena() {
+    let worker = MimallocArena::new();
+    let bundle = MimallocArena::new();
+    let mut records: Vec<ArenaVec<'_, u32>> = Vec::new();
+    for f in 0..8u32 {
+        let mut v = ArenaVec::new_in(&worker);
