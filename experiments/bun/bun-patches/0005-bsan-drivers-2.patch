+// runtime/shell/builtin/mv.rs:510-530 (lstatat, readlinkat into a pooled PathBuffer, symlinkat, unlinkat)
+#[test]
+fn mv_symlink_via_readlinkat() {
+    let _g = lock();
+    let t = TmpDir::new("mv_symlink");
+    // Target close to NAME_MAX, plus a non-UTF-8 one.
+    let mut long_target = vec![b'T'; 250];
+    long_target.extend_from_slice(b".txt");
+    let targets: [&[u8]; 3] = [b"target.txt", &long_target, b"\xff\xfe-not-utf8"];
+    for (i, target) in targets.iter().enumerate() {
+        let src = z(format!("src{i}").as_bytes());
+        let dst = z(format!("dst{i}").as_bytes());
+        let src = ZStr::from_slice_with_nul(&src);
+        let dst = ZStr::from_slice_with_nul(&dst);
+        let tz = z(target);
+        sys::symlinkat(ZStr::from_slice_with_nul(&tz), t.fd, src).unwrap();
+
+        let st = sys::lstatat(t.fd, src).unwrap();
+        let mode = st.st_mode as bun_core::Mode;
+        assert!(bun_sys::S::ISLNK(mode));
+        let mut buf = bun_paths::path_buffer_pool::get();
+        let n = sys::readlinkat(t.fd, src, &mut buf[..]).unwrap();
+        assert!(n < bun_paths::MAX_PATH_BYTES);
+        buf[n] = 0;
+        assert_eq!(&buf[..n], *target);
+        let _ = sys::unlinkat(t.fd, dst);
+        sys::symlinkat(ZStr::from_slice_with_nul(&buf[..n + 1]), t.fd, dst).unwrap();
+        sys::unlinkat(t.fd, src).unwrap();
+        assert_eq!(
+            std::fs::read_link(t.std_path(dst.as_bytes()))
+                .unwrap()
+                .as_os_str()
+                .as_bytes(),
+            *target
+        );
+        assert_eq!(
+            sys::lstatat(t.fd, src).errno_of(),
+            E::ENOENT
+        );
+    }
+    // readlink with a buffer that is exactly the target length: truncation guard trips.
+    let link = t.abs_z(b"dst0");
+    let lz = ZStr::from_slice_with_nul(&link);
+    let mut small = [0u8; 10];
+    assert_eq!(
+        sys::readlink(lz, &mut small).errno_of(),
+        E::ENAMETOOLONG
+    );
+    let mut ok = [0u8; 11];
+    assert_eq!(sys::readlink(lz, &mut ok).unwrap(), 10);
+    assert_eq!(&ok[..11], b"target.txt\0");
+    // readlink of a regular file: EINVAL.
+    write_std(&t.std_path(b"plain"), b"p");
+    let plain = t.abs_z(b"plain");
+    assert_eq!(
+        sys::readlink(ZStr::from_slice_with_nul(&plain), &mut ok)
+            .errno_of(),
+        E::EINVAL
+    );
+    // symlinkat over an existing name: EEXIST.
+    assert_eq!(
+        sys::symlinkat(
+            ZStr::from_slice_with_nul(b"x\0"),
+            t.fd,
+            ZStr::from_slice_with_nul(b"plain\0")
+        )
+        .errno_of(),
+        E::EEXIST
+    );
+}
