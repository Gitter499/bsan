+//! BorrowSanitizer drivers for bun_sys. Each test mirrors a production caller's use of the
+//! wrapper (API, parameters and call order copied from the call site named in the comment
+//! above it) so the unsafe syscall paths run with real buffers, paths and fds. Every test
+//! works inside its own fresh temp directory and removes it afterwards. Not part of Bun's suite.
+use std::ffi::OsStr;
+use std::os::unix::ffi::OsStrExt;
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicU32, Ordering};
+use std::sync::{Mutex, MutexGuard};
+
+use bun_core::ZStr;
+use bun_sys::{self as sys, Dir, E, EntryKind, Fd, FdDirExt, File, O};
+
+// ── harness ────────────────────────────────────────────────────────────────
+
+/// Serialize fd-touching tests (the harness runs them as threads of one process).
+static LOCK: Mutex<()> = Mutex::new(());
+fn lock() -> MutexGuard<'static, ()> {
+    LOCK.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+static COUNTER: AtomicU32 = AtomicU32::new(0);
+
+/// Fresh directory under `std::env::temp_dir()`, opened as a dir fd; removed on drop.
+struct TmpDir {
+    path: PathBuf,
+    fd: Fd,
+}
+impl TmpDir {
+    fn new(name: &str) -> TmpDir {
+        let n = COUNTER.fetch_add(1, Ordering::Relaxed);
+        let path = std::env::temp_dir().join(format!(
+            "bsan_sys_{}_{}_{}",
+            name,
+            std::process::id(),
+            n
+        ));
+        let _ = std::fs::remove_dir_all(&path);
+        std::fs::create_dir(&path).expect("create temp dir");
+        let fd = sys::open_dir_at(Fd::cwd(), path.as_os_str().as_bytes()).expect("open temp dir");
+        TmpDir { path, fd }
+    }
+    fn bytes(&self) -> &[u8] {
+        self.path.as_os_str().as_bytes()
+    }
+    /// Absolute path of `rel` inside the temp dir, NUL-terminated.
+    fn abs_z(&self, rel: &[u8]) -> Vec<u8> {
+        let mut v = self.bytes().to_vec();
+        v.push(b'/');
+        v.extend_from_slice(rel);
+        v.push(0);
+        v
+    }
+    fn std_path(&self, rel: &[u8]) -> PathBuf {
+        self.path.join(OsStr::from_bytes(rel))
+    }
+}
+impl Drop for TmpDir {
+    fn drop(&mut self) {
+        let _ = sys::close(self.fd);
+        let _ = std::fs::remove_dir_all(&self.path);
+    }
+}
+
+/// Errno of an expected failure (no `Debug` bound on the success type).
+trait ErrnoOf {
+    fn errno_of(self) -> E;
+}
+impl<T> ErrnoOf for sys::Maybe<T> {
+    fn errno_of(self) -> E {
+        match self {
+            Ok(_) => panic!("expected an error"),
+            Err(e) => e.get_errno(),
+        }
+    }
+}
+
+/// `bytes` + NUL, for `ZStr::from_slice_with_nul`.
+fn z(bytes: &[u8]) -> Vec<u8> {
+    let mut v = bytes.to_vec();
+    v.push(0);
+    v
+}
+
+/// Deterministic non-trivial content.
+fn pattern(n: usize, seed: u32) -> Vec<u8> {
+    let mut x = seed | 1;
+    (0..n)
+        .map(|_| {
+            x ^= x << 13;
+            x ^= x >> 17;
+            x ^= x << 5;
+            (x >> 7) as u8
+        })
+        .collect()
+}
+
+fn write_std(path: &std::path::Path, data: &[u8]) {
+    std::fs::write(path, data).expect("std write");
+}
