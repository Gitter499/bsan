+// runtime/shell/builtin/mv.rs:595-612 (fstat, unlinkat dest, File::openat NOFOLLOW, preallocate_file, copy_file)
+#[test]
+fn copy_file_sizes_and_pipe_source() {
+    let _g = lock();
+    let t = TmpDir::new("copy_file");
+    for &n in &[0usize, 1, 32 * 1024 - 1, 32 * 1024 + 1, 200_000] {
+        let data = pattern(n, n as u32 + 1);
+        write_std(&t.std_path(b"src"), &data);
+        let in_ = File::openat(t.fd, b"src", O::RDONLY | O::CLOEXEC, 0).unwrap();
+        let st = sys::fstat(in_.fd()).unwrap();
+        let dst = ZStr::from_slice_with_nul(b"dst\0");
+        let _ = sys::unlinkat(t.fd, dst);
+        let out = File::openat(
+            t.fd,
+            dst.as_bytes(),
+            O::WRONLY | O::CREAT | O::TRUNC | O::CLOEXEC | O::NOFOLLOW,
+            (st.st_mode as bun_core::Mode) & 0o7777,
+        )
+        .unwrap();
+        let _ = sys::preallocate_file(out.fd().native(), 0, st.st_size as _);
+        sys::copy_file(in_.fd(), out.fd()).unwrap();
+        drop(out);
+        assert_eq!(std::fs::read(t.std_path(b"dst")).unwrap(), data);
+    }
+    // Pipe as the source: copy_file_range/sendfile refuse it, the read/write loop runs.
+    let [r, w] = sys::pipe().unwrap();
+    let payload = pattern(40_000, 5);
+    let writer = std::thread::spawn({
+        let payload = payload.clone();
+        move || {
+            File::borrow(&w).write_all(&payload).unwrap();
+            sys::close(w).unwrap();
+        }
+    });
+    let out = File::openat(t.fd, b"from_pipe", O::WRONLY | O::CREAT | O::TRUNC, 0o644).unwrap();
+    sys::copy_file(r, out.fd()).unwrap();
+    writer.join().unwrap();
+    drop(out);
+    sys::close(r).unwrap();
+    assert_eq!(std::fs::read(t.std_path(b"from_pipe")).unwrap(), payload);
+    // Bad output fd.
+    let in_ = File::openat(t.fd, b"src", O::RDONLY, 0).unwrap();
+    assert!(sys::copy_file(in_.fd(), Fd::from_native(99_999)).is_err());
+}
