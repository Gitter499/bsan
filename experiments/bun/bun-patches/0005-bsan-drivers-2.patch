+// runtime/node/node_fs.rs:7099 (claim the per-loop scratch and read a file into it before stat)
+#[test]
+fn pipe_read_scratch_read_file() {
+    let _g = lock();
+    let t = TmpDir::new("scratch");
+    let data = pattern(300_000, 2);
+    t.write("data", &data);
+    let rare = Box::new(PipeReadScratch::new());
+    for &max in &[100usize, 256 * 1024] {
+        let fd = t.open_ro("data");
+        let mut scratch = rare.claim();
+        assert!(rare.claim().is_none());
+        let pre_stat_buf: &mut [u8] = &mut scratch.as_mut().unwrap()[..];
+        assert_eq!(pre_stat_buf.len(), bun_io::pipe_read_scratch::PIPE_READ_BUFFER_SIZE);
+        let pre_stat_len = pre_stat_buf.len().min(max);
+        let pre_stat_buf = &mut pre_stat_buf[..pre_stat_len];
+        let mut total = 0;
+        let mut available: &mut [u8] = &mut pre_stat_buf[..];
+        while !available.is_empty() {
+            let amt = sys::read(fd, available).unwrap();
+            if amt == 0 {
+                break;
+            }
+            total += amt;
+            available = &mut available[amt..];
+        }
+        assert_eq!(total, pre_stat_len);
+        assert_eq!(&pre_stat_buf[..total], &data[..total]);
+        drop(scratch);
+        // Released: claimable again, and the buffer is reused (same contents).
+        let again = rare.claim().unwrap();
+        assert_eq!(&again[..total], &data[..total]);
+        drop(again);
+        sys::close(fd).unwrap();
+    }
+}
