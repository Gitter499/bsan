+// ── PE ────────────────────────────────────────────────────────────────────
+
+const OPT: usize = 0x98; // optional header (e_lfanew 0x80 + 24)
+const SECT: usize = OPT + 240; // section table
+
+/// x64 console bun.exe-shaped image: .text/.rdata/.data, 0x200 file alignment,
+/// 0x1000 section alignment, optionally an Authenticode certificate appended
+/// (Security directory points at its file offset) and FORCE_INTEGRITY set.
+fn pe_template(signed: bool) -> Vec<u8> {
+    let mut b = vec![0u8; 0xA00];
+    b[0..2].copy_from_slice(b"MZ");
+    put16(&mut b, 2, 0x90);
+    put16(&mut b, 4, 3);
+    put16(&mut b, 8, 4);
+    put16(&mut b, 0x10, 0xFFFF);
+    put16(&mut b, 0x18, 0x40);
+    put32(&mut b, 0x3C, 0x80);
+    b[0x40..0x4E].copy_from_slice(&[0x0E, 0x1F, 0xBA, 0x0E, 0x00, 0xB4, 0x09, 0xCD, 0x21, 0xB8, 0x01, 0x4C, 0xCD, 0x21]);
+    b[0x4E..0x4E + 39].copy_from_slice(b"This program cannot be run in DOS mode.");
+    // COFF header
+    b[0x80..0x84].copy_from_slice(b"PE\0\0");
+    put16(&mut b, 0x84, 0x8664);
+    put16(&mut b, 0x86, 3);
+    put32(&mut b, 0x88, 0x6650_1d2a);
+    put16(&mut b, 0x94, 240);
+    put16(&mut b, 0x96, 0x0022);
+    // Optional header (PE32+)
+    put16(&mut b, OPT, 0x20B);
+    b[OPT + 2] = 14;
+    b[OPT + 3] = 38;
+    put32(&mut b, OPT + 4, 0x200);
+    put32(&mut b, OPT + 8, 0x400);
+    put32(&mut b, OPT + 16, 0x1000);
+    put32(&mut b, OPT + 20, 0x1000);
+    put64(&mut b, OPT + 24, 0x1_4000_0000);
+    put32(&mut b, OPT + 32, 0x1000);
+    put32(&mut b, OPT + 36, 0x200);
+    put16(&mut b, OPT + 40, 6);
+    put16(&mut b, OPT + 48, 6);
+    put32(&mut b, OPT + 56, 0x4000);
+    put32(&mut b, OPT + 60, 0x400);
+    put16(&mut b, OPT + 68, 3); // IMAGE_SUBSYSTEM_WINDOWS_CUI
+    put16(&mut b, OPT + 70, 0x8160 | if signed { 0x80 } else { 0 });
+    put64(&mut b, OPT + 72, 0x100000);
+    put64(&mut b, OPT + 80, 0x1000);
+    put64(&mut b, OPT + 88, 0x100000);
+    put64(&mut b, OPT + 96, 0x1000);
+    put32(&mut b, OPT + 108, 16);
+    let dd = OPT + 112;
+    put32(&mut b, dd + 8, 0x2000); // import directory → .rdata
+    put32(&mut b, dd + 12, 0x28);
+    // Section table
+    let sections: [(&[u8; 8], u32, u32, u32, u32, u32); 3] = [
+        (b".text\0\0\0", 0x10, 0x1000, 0x200, 0x400, 0x6000_0020),
+        (b".rdata\0\0", 0x40, 0x2000, 0x200, 0x600, 0x4000_0040),
+        (b".data\0\0\0", 0x80, 0x3000, 0x200, 0x800, 0xC000_0040),
+    ];
+    for (i, (name, vs, va, raw, ptr, ch)) in sections.into_iter().enumerate() {
+        let s = SECT + i * 40;
+        b[s..s + 8].copy_from_slice(name);
+        put32(&mut b, s + 8, vs);
+        put32(&mut b, s + 12, va);
+        put32(&mut b, s + 16, raw);
+        put32(&mut b, s + 20, ptr);
+        put32(&mut b, s + 36, ch);
+    }
+    // main: sub rsp,28h; xor ecx,ecx; call [ExitProcess]; int3
+    b[0x400..0x40E].copy_from_slice(&[0x48, 0x83, 0xEC, 0x28, 0x31, 0xC9, 0xFF, 0x15, 0xF2, 0x0F, 0x00, 0x00, 0xCC, 0xCC]);
+    b[0x640..0x650].copy_from_slice(b"KERNEL32.dll\0\0\0\0");
+    b[0x800..0x80C].copy_from_slice(b"hello, bun\r\n");
+    if signed {
+        // WIN_CERTIFICATE { dwLength, wRevision = 0x0200, wCertificateType = PKCS_SIGNED_DATA } + DER
+        let cert_off = b.len();
+        let mut cert = vec![0u8; 0x28];
+        put32(&mut cert, 0, 0x28);
+        put16(&mut cert, 4, 0x0200);
+        put16(&mut cert, 6, 0x0002);
+        cert[8..20].copy_from_slice(&[0x30, 0x82, 0x1A, 0x2B, 0x06, 0x09, 0x2A, 0x86, 0x48, 0x86, 0xF7, 0x0D]);
+        b.extend_from_slice(&cert);
+        put32(&mut b, dd + 4 * 8, cert_off as u32);
+        put32(&mut b, dd + 4 * 8 + 4, 0x28);
+    }
+    b
+}
+
+// standalone_graph/StandaloneModuleGraph.rs:2375 (PEFile::init), :2384 (set_subsystem
+// for --windows-hide-console), :2391 (add_bun_section), :2405 (write)
+#[test]
+fn pe_add_bun_section_to_signed_image() {
+    let input = pe_template(true);
+    let payload = module_graph_payload(700);
+    let mut pe_file = PEFile::init(&input).unwrap_or_else(|e| panic!("init: {e}"));
+    pe_file.set_subsystem(pe::IMAGE_SUBSYSTEM_WINDOWS_GUI).unwrap();
+    pe_file.add_bun_section(&payload).unwrap_or_else(|e| panic!("add_bun_section: {e}"));
+    let mut out = Vec::new();
+    pe_file.write(&mut out).unwrap_or_else(|e| panic!("write: {e}"));
+    assert_eq!(out.len(), pe_file.len());
+
+    assert_eq!(u16_at(&out, 0x86), 4);
+    assert_eq!(u16_at(&out, OPT + 68), pe::IMAGE_SUBSYSTEM_WINDOWS_GUI);
+    assert_eq!(u16_at(&out, OPT + 70) & 0x80, 0, "FORCE_INTEGRITY cleared");
+    assert_eq!((u32_at(&out, OPT + 112 + 32), u32_at(&out, OPT + 112 + 36)), (0, 0));
+    assert_ne!(u32_at(&out, OPT + 64), 0, "checksum recomputed");
+    let s = SECT + 3 * 40;
+    assert_eq!(&out[s..s + 8], b".bun\0\0\0\0");
+    let (va, raw_size, raw_ptr) = (u32_at(&out, s + 12), u32_at(&out, s + 16) as usize, u32_at(&out, s + 20) as usize);
+    assert_eq!(va, 0x4000);
+    assert_eq!(raw_ptr, 0xA00, "certificate stripped before appending");
+    assert_eq!(out.len(), raw_ptr + raw_size);
+    assert_eq!(u64_at(&out, raw_ptr), payload.len() as u64);
+    assert_eq!(&out[raw_ptr + 8..][..payload.len()], &payload[..]);
+    assert_eq!(u32_at(&out, OPT + 56), 0x4000 + ((8 + payload.len() as u32 + 0xFFF) & !0xFFF));
+    assert_eq!(&out[0x400..0x404], &input[0x400..0x404]);
+
+    // Compiling an already-compiled executable again is rejected.
+    let mut again = PEFile::init(&out).unwrap();
+    assert_eq!(again.add_bun_section(b"x").err(), Some(pe::Error::SectionExists));
+}
