+/// Mirrors the pretty_format string-quoting loop over an EncodedSlice.
+fn pretty_quote(str: EncodedSlice<'_>) -> String {
+    const BACKSLASH: u16 = b'\\' as u16;
+    const CR: u16 = b'\r' as u16;
+    const LF: u16 = b'\n' as u16;
+    let mut out = String::new();
+    use std::fmt::Write as _;
+    out.push('"');
+    let mut remaining = str;
+    while let Some(i) = remaining.index_of_any(b"\\\r") {
+        match remaining.char_at(i) {
+            BACKSLASH => {
+                write!(out, "{}\\", remaining.substring_with_len(0, i)).unwrap();
+                remaining = remaining.substring(i + 1);
+            }
+            CR => {
+                if i + 1 < remaining.len && remaining.char_at(i + 1) == LF {
+                    write!(out, "{}", remaining.substring_with_len(0, i)).unwrap();
+                } else {
+                    write!(out, "{}\n", remaining.substring_with_len(0, i)).unwrap();
+                }
+                remaining = remaining.substring(i + 1);
+            }
+            _ => unreachable!(),
+        }
+    }
+    write!(out, "{}", remaining).unwrap();
+    out.push('"');
+    out
+}
