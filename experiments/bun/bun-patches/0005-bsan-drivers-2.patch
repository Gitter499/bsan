+// standalone_graph/StandaloneModuleGraph.rs:2375 / :2391 with malformed `--compile-executable-path` inputs.
+#[test]
+fn pe_rejects_malformed_images() {
+    let good = pe_template(false);
+    let mut pe_file = PEFile::init(&good).unwrap();
+    pe_file.add_bun_section(&module_graph_payload(0)).unwrap();
+    assert_eq!(pe_file.len(), 0xA00 + 0x200);
+
+    let init_err = |b: &[u8]| PEFile::init(b).err();
+    assert_eq!(init_err(&good[..32]), Some(pe::Error::InvalidPEFile));
+    let mut b = good.clone();
+    b[0] = b'Z';
+    assert_eq!(init_err(&b), Some(pe::Error::InvalidDOSSignature));
+    let mut b = good.clone();
+    b[0x80] = b'X';
+    assert_eq!(init_err(&b), Some(pe::Error::InvalidPESignature));
+    let mut b = good.clone();
+    put16(&mut b, OPT, 0x10B);
+    assert_eq!(init_err(&b), Some(pe::Error::UnsupportedPEFormat));
+    let mut b = good.clone();
+    put32(&mut b, OPT + 36, 0x300);
+    assert_eq!(init_err(&b), Some(pe::Error::BadAlignment));
+    let mut b = good.clone();
+    put16(&mut b, 0x86, 200);
+    assert_eq!(init_err(&b), Some(pe::Error::TooManySections));
+    let mut b = good.clone();
+    put32(&mut b, 0x3C, 0xFFFF_FF00);
+    assert_eq!(init_err(&b), Some(pe::Error::InvalidPEFile));
