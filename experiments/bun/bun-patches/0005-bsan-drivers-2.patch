+/// js_printer/lib.rs:7661 `get_source_map_builder::<IS_BUN_PLATFORM = false>` with
+/// `GenerateSourceMap::Lazy` (VLQ text output, deferred line offset table).
+fn print_bundler(lines: &[String]) -> Printed {
+    let source = lines.iter().map(|l| format!("{l}\n")).collect::<String>();
+    let mut builder = Builder {
+        source_map: SourceMapFormat::init(false),
+        cover_lines_without_mappings: true,
+        approximate_input_line_count: lines.len(),
+        prepend_count: false,
+        line_offset_tables: LineOffsetTables::Deferred { contents: source.as_bytes(), approximate_line_count: lines.len() as i32 },
+        ..Default::default()
+    };
+    let _ = builder.source_map.ctx.data.grow_if_needed(source.len() / 4);
+    let (output, chunk, expected) = print_with_builder(builder, &source, lines, 4);
+    Printed { source, output, chunk, expected }
+}
