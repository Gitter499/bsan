+// js_parser/lexer.rs:935 (lexer step: ASCII fast path, then next_codepoint_multibyte)
+#[test]
+fn lexer_next_codepoint_multibyte() {
+    fn lex_all(contents: &[u8]) -> Vec<i32> {
+        let mut current = 0usize;
+        let mut out = Vec::new();
+        while current < contents.len() {
+            let first = contents[current];
+            if first < 0x80 {
+                current += 1;
+                out.push(i32::from(first));
+                continue;
+            }
+            out.push(strings::lexer_step::next_codepoint_multibyte(contents, &mut current, first));
+        }
+        out
+    }
+    let src = "let \u{e9} = '\u{2713}\u{1F600}';";
+    let cps: Vec<i32> = src.chars().map(|c| c as i32).collect();
+    assert_eq!(lex_all(src.as_bytes()), cps);
+    // invalid lead (0xFF) yields the raw byte; stray continuation yields raw byte
+    assert_eq!(lex_all(b"a\xFFb"), vec![0x61, 0xFF, 0x62]);
+    // truncated multibyte at EOF → -1 sentinel
+    let mut current = 1usize;
+    assert_eq!(strings::lexer_step::next_codepoint_multibyte(b"a\xF0\x9F", &mut current, 0xF0), -1);
+    // malformed continuation → replacement, advance 1
+    let mut current = 0usize;
+    let cp = strings::lexer_step::next_codepoint_multibyte(b"\xE2\x28\xA1", &mut current, 0xE2);
+    assert_eq!(cp, 0xFFFD);
+    assert_eq!(current, 1);
+}
