+    // Signed image with an overlay after the certificate: stripped, then rejected.
+    let mut b = pe_template(true);
+    b.extend_from_slice(&[0xEE; 24]);
+    let mut overlay = PEFile::init(&b).unwrap();
+    assert_eq!(overlay.add_bun_section(b"x").err(), Some(pe::Error::UnexpectedOverlayPresent));
+
+    // Security directory pointing inside the image.
+    let mut b = pe_template(true);
+    put32(&mut b, OPT + 112 + 32, 0x600);
+    let mut inside = PEFile::init(&b).unwrap();
