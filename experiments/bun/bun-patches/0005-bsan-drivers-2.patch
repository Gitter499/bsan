+// runtime/webcore/TextDecoder.rs:398 (streaming decode: FLUSH=false buffers a split sequence)
+#[test]
+fn to_utf16_alloc_maybe_buffered_text_decoder_stream() {
+    // Chunk 1 ends in the first two bytes of '€' (E2 82 AC).
+    for n in [0usize, 15, 16, 31, 32, 63, 64] {
+        let mut chunk1 = ascii_then(n, "\u{e9}".as_bytes());
+        chunk1.extend_from_slice(b"\xE2\x82");
+        let (units, buffered, buffered_len) =
+            strings::to_utf16_alloc_maybe_buffered::<false, false>(&chunk1)
+                .unwrap()
+                .unwrap();
+        assert_eq!(units.len(), n + 1);
+        assert_eq!(units[n], 0xE9);
+        assert_eq!(buffered_len, 2);
+        assert_eq!(&buffered[..2], b"\xE2\x82");
+
+        // Chunk 2: TextDecoder joins the buffered bytes with the next input.
+        let mut joined = buffered[..buffered_len as usize].to_vec();
+        joined.extend_from_slice(b"\xAC and \xF0\x9F\x98\x80");
+        let (units2, _, len2) = strings::to_utf16_alloc_maybe_buffered::<false, true>(&joined)
+            .unwrap()
+            .unwrap();
+        assert_eq!(len2, 0);
+        assert_eq!(units2, utf16("\u{20AC} and \u{1F600}"));
+    }
+    // fatal=true rejects invalid bytes on flush.
+    assert!(matches!(
+        strings::to_utf16_alloc_maybe_buffered::<true, true>(b"abc\xFFdef"),
+        Err(strings::ToUTF16Error::InvalidByteSequence)
+    ));
+    // fatal=false replaces.
+    let (u, _, _) = strings::to_utf16_alloc_maybe_buffered::<false, true>(b"abc\xFFdef\xC3")
+        .unwrap()
+        .unwrap();
+    assert_eq!(u, utf16("abc\u{FFFD}def\u{FFFD}"));
+    assert!(strings::to_utf16_alloc_maybe_buffered::<false, true>(b"all ascii").unwrap().is_none());
+}
