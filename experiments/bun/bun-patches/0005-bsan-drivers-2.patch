+// http_jsc/websocket_client.rs:2189 (exact-size payload) and runtime/webcore/encoding.rs:612 (Buffer#fill partial)
+#[test]
+fn copy_utf16_into_utf8_impl_websocket_and_buffer_fill() {
+    // websocket: payload sized to element_length_utf16_into_utf8
+    for n in ASCII_LENS {
+        let s = format!("{}{}", MULTI, String::from_utf8(ascii(n)).unwrap());
+        let u = utf16(&s);
+        let content_byte_len = strings::element_length_utf16_into_utf8(&u);
+        let mut payload = vec![0u8; content_byte_len];
+        let encoded = strings::copy_utf16_into_utf8_impl::<true>(&mut payload, &u);
+        assert_eq!(encoded.written as usize, content_byte_len);
+        assert_eq!(encoded.read as usize, u.len());
+        assert_eq!(payload, s.as_bytes());
+    }
+    // Buffer.allocUnsafe(1).fill("Ȣ") → 0xC8 (truncated sequence allowed)
+    let mut one = [0u8; 1];
+    let r = strings::copy_utf16_into_utf8_impl::<true>(&mut one, &utf16("\u{0222}"));
+    assert_eq!(one[0], 0xC8);
+    assert_eq!(r.written, 1);
+    // 3- and 4-byte sequences into short buffers, with/without truncation
+    for cap in 1..4usize {
+        let mut b = vec![0u8; cap];
+        let r = strings::copy_utf16_into_utf8_impl::<true>(&mut b, &utf16("\u{1F600}"));
+        assert_eq!(r.written as usize, cap);
+        assert_eq!(&b[..], &"\u{1F600}".as_bytes()[..cap]);
+        let mut b = vec![0u8; cap];
+        let r = strings::copy_utf16_into_utf8_impl::<false>(&mut b, &utf16("\u{1F600}"));
