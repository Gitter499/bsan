+#[test]
+fn renameat_concurrently_replaces_existing() {
+    let _g = lock();
+    let t = TmpDir::new("renameat_conc");
+    std::fs::create_dir_all(t.std_path(b"tmp/pkg-abc/lib")).unwrap();
+    write_std(&t.std_path(b"tmp/pkg-abc/lib/index.js"), b"new");
+    std::fs::create_dir_all(t.std_path(b"cache/pkg@1/old")).unwrap();
+    write_std(&t.std_path(b"cache/pkg@1/old/stale.js"), b"old");
+    let system_tmpdir = sys::open_dir_at(t.fd, b"tmp").unwrap();
+    let cache_dir = sys::open_dir_at(t.fd, b"cache").unwrap();
+    sys::renameat_concurrently(
+        system_tmpdir,
+        ZStr::from_slice_with_nul(b"pkg-abc\0"),
+        cache_dir,
+        ZStr::from_slice_with_nul(b"pkg@1\0"),
+        sys::RenameOptions {
+            move_fallback: true,
+        },
+    )
+    .unwrap();
+    assert_eq!(std::fs::read(t.std_path(b"cache/pkg@1/lib/index.js")).unwrap(), b"new");
+    // RENAME_EXCHANGE leaves the old tree at the source; the delete-tree fallback leaves nothing.
+    if t.std_path(b"tmp/pkg-abc").exists() {
+        assert_eq!(std::fs::read(t.std_path(b"tmp/pkg-abc/old/stale.js")).unwrap(), b"old");
+        std::fs::remove_dir_all(t.std_path(b"tmp/pkg-abc")).unwrap();
+    }
+    // Missing source: ENOENT is returned immediately.
+    let err = sys::renameat_concurrently(
+        system_tmpdir,
+        ZStr::from_slice_with_nul(b"pkg-abc\0"),
+        cache_dir,
+        ZStr::from_slice_with_nul(b"pkg@1\0"),
+        sys::RenameOptions::default(),
+    )
+    .unwrap_err();
+    assert_eq!(err.get_errno(), E::ENOENT);
+    // renameat2(NoReplace) onto an existing name: EEXIST (install/npm.rs:1219 checks for it).
+    write_std(&t.std_path(b"tmp/a"), b"a");
+    write_std(&t.std_path(b"cache/a"), b"b");
+    let e = sys::renameat2(
+        system_tmpdir,
+        ZStr::from_slice_with_nul(b"a\0"),
+        cache_dir,
+        ZStr::from_slice_with_nul(b"a\0"),
+        sys::RenameMode::NoReplace,
+    )
+    .unwrap_err();
+    assert_eq!(e.get_errno(), E::EEXIST);
+    match sys::renameat2(
+        system_tmpdir,
+        ZStr::from_slice_with_nul(b"a\0"),
+        cache_dir,
+        ZStr::from_slice_with_nul(b"a\0"),
+        sys::RenameMode::Exchange,
+    ) {
+        Ok(()) => {
+            assert_eq!(std::fs::read(t.std_path(b"tmp/a")).unwrap(), b"b");
+            assert_eq!(std::fs::read(t.std_path(b"cache/a")).unwrap(), b"a");
+        }
+        Err(e) => assert!(matches!(e.get_errno(), E::EINVAL | E::EOPNOTSUPP)),
+    }
+    sys::close(system_tmpdir).unwrap();
+    sys::close(cache_dir).unwrap();
+}
