+// runtime/node/node_fs.rs:7793 (statx) / :5600 (lstatx) / :5462 (fstatx) with STATX_MASK_FOR_STATS
+#[test]
+fn statx_family_matches_stat() {
+    let _g = lock();
+    let t = TmpDir::new("statx");
+    let data = pattern(4321, 1);
+    write_std(&t.std_path(b"f"), &data);
+    std::os::unix::fs::symlink("f", t.std_path(b"link")).unwrap();
+    let f = t.abs_z(b"f");
+    let link = t.abs_z(b"link");
+    let fz = ZStr::from_slice_with_nul(&f);
+    let lz = ZStr::from_slice_with_nul(&link);
+
+    let sx = sys::statx(fz, sys::STATX_MASK_FOR_STATS).unwrap();
+    let st = sys::stat(fz).unwrap();
+    assert_eq!(sx.size, data.len() as u64);
+    assert_eq!(sx.ino, st.st_ino);
+    assert_eq!(sx.mode, st.st_mode as u64);
+
+    let via_link = sys::statx(lz, sys::STATX_MASK_FOR_STATS).unwrap();
+    assert_eq!(via_link.ino, sx.ino);
+    let lx = sys::lstatx(lz, sys::STATX_MASK_FOR_STATS).unwrap();
+    assert!(bun_sys::S::ISLNK(lx.mode as _));
+    let ls = sys::lstat(lz).unwrap();
+    assert_eq!(ls.st_ino, lx.ino);
+
+    let fd = sys::open(fz, O::RDONLY, 0).unwrap();
+    let fx = sys::fstatx(fd, sys::STATX_MASK_FOR_STATS).unwrap();
+    assert_eq!(fx.ino, sx.ino);
+    assert_eq!(sys::fstat(fd).unwrap().st_size as usize, data.len());
+    sys::close(fd).unwrap();
+
+    let missing = t.abs_z(b"missing");
+    let mz = ZStr::from_slice_with_nul(&missing);
+    assert_eq!(
+        sys::statx(mz, sys::STATX_MASK_FOR_STATS).errno_of(),
+        E::ENOENT
+    );
+    assert_eq!(sys::stat(mz).errno_of(), E::ENOENT);
+    assert_eq!(sys::lstat(mz).errno_of(), E::ENOENT);
+    // ENOTDIR: a path component is a regular file.
+    let nd = t.abs_z(b"f/child");
+    assert_eq!(
+        sys::lstatx(ZStr::from_slice_with_nul(&nd), sys::STATX_MASK_FOR_STATS)
+            .errno_of(),
+        E::ENOTDIR
+    );
+    // fstatat / lstatat relative to the dir fd.
+    assert_eq!(
+        sys::fstatat(t.fd, ZStr::from_slice_with_nul(b"link\0"))
+            .unwrap()
+            .st_ino,
+        st.st_ino
+    );
+    assert!(bun_sys::S::ISLNK(
+        sys::lstatat(t.fd, ZStr::from_slice_with_nul(b"link\0"))
+            .unwrap()
+            .st_mode as _
+    ));
+}
