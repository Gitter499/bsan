+// jsc/RuntimeTranspilerCache.rs:367 (Tmpfile + preallocate_file + pwritev loop) + runtime/jsc_hooks.rs:4594 (Tmpfile::create_with_mode / write_all / finish)
+#[test]
+fn tmpfile_pwritev_and_finish() {
+    let _g = lock();
+    let t = TmpDir::new("tmpfile");
+    let metadata = pattern(64, 1);
+    let output = pattern(10_000, 2);
+    let sourcemap = pattern(3000, 3);
+    let scratch = z(b"cache.tmp-1234");
+    let scratch_z = ZStr::from_slice_with_nul(&scratch);
+    let mut tmpfile = sys::Tmpfile::create_with_mode(t.fd, scratch_z, 0o600).unwrap();
+    // O_EXCL: a second create of the same scratch name fails.
+    assert_eq!(
+        sys::Tmpfile::create(t.fd, scratch_z).errno_of(),
+        E::EEXIST
+    );
+    let vecs_buf = [
+        sys::platform_iovec_const_create(&metadata),
+        sys::platform_iovec_const_create(&output),
+        sys::platform_iovec_const_create(&sourcemap),
+    ];
+    let vecs = &vecs_buf[..];
+    let file_len = metadata.len() + output.len() + sourcemap.len();
+    let end_position = i64::try_from(file_len).unwrap();
+    let _ = sys::preallocate_file(tmpfile.fd.native(), 0, end_position);
+    let mut position: i64 = 0;
+    while position < end_position {
+        let written = sys::pwritev(tmpfile.fd, vecs, position).unwrap();
+        assert!(written > 0);
+        position += i64::try_from(written).unwrap();
+    }
+    let canonical = z(b"cache.bin");
+    tmpfile.finish(ZStr::from_slice_with_nul(&canonical)).expect("finish");
+    let _ = sys::close(tmpfile.fd);
+    let all = std::fs::read(t.std_path(b"cache.bin")).unwrap();
+    assert_eq!(all, [&metadata[..], &output[..], &sourcemap[..]].concat());
+    assert!(!t.std_path(b"cache.tmp-1234").exists());
+
+    // jsc_hooks flavour: write_all through File::borrow, then rename into place.
+    let scratch2 = z(b"addon.node.tmp");
+    let mut tf = sys::Tmpfile::create_with_mode(t.fd, ZStr::from_slice_with_nul(&scratch2), 0o600)
+        .unwrap();
+    let _close = sys::CloseOnDrop::new(tf.fd);
+    File::borrow(&tf.fd).write_all(&output).unwrap();
+    tf.finish(ZStr::from_slice_with_nul(b"addon.node\0")).unwrap();
+    assert_eq!(std::fs::read(t.std_path(b"addon.node")).unwrap(), output);
+}
