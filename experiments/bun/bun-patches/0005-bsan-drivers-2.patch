+#[derive(Clone, Copy)]
+struct Brace {
+    open_brace_idx: u32,
+    branch_idx: u32,
+}
+
+// glob/matcher.rs:519 (BraceStack push/pop) and sql/mysql/protocol/EncodeInt.rs:39 (from_slice)
+#[test]
+fn bounded_array_brace_stack_and_length_int() {
+    let mut brace_stack = BoundedArray::<Brace, 10>::default();
+    for i in 0..10u32 {
+        brace_stack
+            .push(Brace {
+                open_brace_idx: i,
+                branch_idx: i * 2,
+            })
+            .unwrap();
+    }
+    assert!(brace_stack
+        .push(Brace {
+            open_brace_idx: 99,
+            branch_idx: 99
+        })
+        .is_err());
+    let depth = u8::try_from(brace_stack.len()).unwrap();
+    assert_eq!(depth, 10);
+    let sum: u32 = brace_stack.as_slice().iter().map(|b| b.open_brace_idx + b.branch_idx).sum();
+    assert_eq!(sum, 45 * 3);
+    while let Some(b) = brace_stack.pop() {
+        assert_eq!(b.branch_idx, b.open_brace_idx * 2);
+    }
+    assert_eq!(brace_stack.len(), 0);
+
+    let buf = [0xfdu8, 0x01, 0x02, 0x03];
+    let mut enc = BoundedArray::<u8, 9>::from_slice(&buf).unwrap();
+    assert_eq!(enc.const_slice(), &buf);
+    enc.slice()[0] = 0xfe;
+    assert_eq!(enc.as_slice()[0], 0xfe);
+    assert!(BoundedArray::<u8, 9>::from_slice(&[0u8; 10]).is_err());
+
+    // Drop of non-Copy elements goes through clear() → drop_in_place.
+    let mut owned = BoundedArray::<Vec<u8>, 4>::default();
+    owned.push(ascii(17)).unwrap();
+    owned.push(MULTI.as_bytes().to_vec()).unwrap();
+    assert_eq!(owned.pop().unwrap(), MULTI.as_bytes());
+    drop(owned);
+}
