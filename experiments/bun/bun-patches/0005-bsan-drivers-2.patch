+// ast/ast_memory_allocator.rs:182 (reset_ast_state while pushed → reset_active_state)
+#[test]
+fn ast_reset_active_state_while_pushed() {
+    let arena = MimallocArena::new();
+    let mut state = ast_alloc::acquire_state();
+    state.set_spill_heap(arena.heap_ptr());
+    let previous = ast_alloc::swap_state(Some(state));
+    for round in 0..4u8 {
+        let v: AstVec<u8> = AstAlloc::vec_from_slice(&[round; 200]);
+        let big: AstVec<u8> = AstAlloc::vec_from_slice(&[round; 2000]);
+        assert!(v.iter().all(|b| *b == round));
+        assert!(big.iter().all(|b| *b == round));
+        drop(v);
+        drop(big);
+        ast_alloc::reset_active_state();
+        // Spill pointer was nulled by reset; ASTMemoryAllocator::push re-points it.
