+        E::ENOENT
+    );
+    write_std(&t.std_path(b"a"), b"A");
+    sys::rename(ZStr::from_slice_with_nul(&a), ZStr::from_slice_with_nul(&b)).unwrap();
+    sys::renameat(
+        t.fd,
+        ZStr::from_slice_with_nul(b"b\0"),
+        t.fd,
+        ZStr::from_slice_with_nul(b"c\0"),
+    )
+    .unwrap();
+    assert_eq!(std::fs::read(t.std_path(b"c")).unwrap(), b"A");
+}
