+#[test]
+fn walker_skips_and_recurses() {
+    let _g = lock();
+    let t = TmpDir::new("walker");
+    const SKIP_DIRS: &[&[u8]] = &[b"node_modules", b".git"];
+    const SKIP_FILES: &[&[u8]] = &[b"package-lock.json", b"yarn.lock", b"pnpm-lock.yaml"];
+    for d in [
+        &b"src"[..],
+        b"src/components",
+        b"src/components/deep",
+        b"node_modules",
+        b"node_modules/react",
+        b".git",
+        b"assets",
+    ] {
+        std::fs::create_dir(t.std_path(d)).unwrap();
+    }
+    let files: &[&[u8]] = &[
+        b"package.json",
+        b"package-lock.json",
+        b"yarn.lock",
+        b"src/index.ts",
+        b"src/components/App.tsx",
+        b"src/components/deep/x\xff.bin",
+        b"node_modules/react/index.js",
+        b".git/HEAD",
+        b"assets/logo.svg",
+    ];
+    for f in files {
+        write_std(&t.std_path(f), f);
+    }
+    let template_dir = Dir::open(t.bytes()).unwrap();
+    let mut walker =
+        sys::walker_skippable::walk(Fd::from_std_dir(&template_dir), SKIP_FILES, SKIP_DIRS).unwrap();
+    let mut got_files = Vec::new();
+    let mut got_dirs = Vec::new();
+    while let Some(entry) = walker.next().unwrap() {
+        let path = entry.path.as_bytes().to_vec();
+        assert!(path.ends_with(entry.basename.as_bytes()));
+        match entry.kind {
+            EntryKind::File => {
+                // Read through the entry's dir fd + basename, as file_copier_copy does.
+                let body = File::read_from(entry.dir, entry.basename.as_bytes()).unwrap();
+                assert_eq!(body, path);
+                got_files.push(path);
+            }
+            EntryKind::Directory => got_dirs.push(path),
+            _ => {}
+        }
+    }
+    drop(walker);
+    got_files.sort();
+    got_dirs.sort();
+    let mut want_files: Vec<Vec<u8>> = vec![
+        b"package.json".to_vec(),
+        b"src/index.ts".to_vec(),
+        b"src/components/App.tsx".to_vec(),
+        b"src/components/deep/x\xff.bin".to_vec(),
+        b"assets/logo.svg".to_vec(),
+    ];
+    want_files.sort();
+    assert_eq!(got_files, want_files);
+    assert_eq!(
+        got_dirs,
+        vec![
+            b"assets".to_vec(),
+            b"src".to_vec(),
+            b"src/components".to_vec(),
+            b"src/components/deep".to_vec()
+        ]
+    );
+    // The root fd is borrowed: still open after the walker is gone.
+    assert!(sys::fstat(template_dir.fd()).is_ok());
+}
