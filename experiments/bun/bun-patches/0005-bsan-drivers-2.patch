+// http/h2_client/encode.rs:416 (allocated_bytes_mut over the whole allocation, write at `len`, commit_spare)
+#[test]
+fn vec_allocated_bytes_hpack_encode() {
+    let mut encoded: Vec<u8> = b"\x82\x86".to_vec();
+    for (name, value) in [(&b":path"[..], &b"/caf\xC3\xA9"[..]), (b"user-agent", b"bun"), (b"x", b"")] {
+        let required = encoded.len() + name.len() + value.len() + 32;
+        encoded.reserve(required.saturating_sub(encoded.len()));
+        let len = encoded.len();
+        // SAFETY: we write only into `[len..len+written]`, inside the reserved capacity.
+        let buf = unsafe { bun_core::vec::allocated_bytes_mut(&mut encoded) };
+        // literal header without indexing: 0x00, name len, name, value len, value
+        let mut w = len;
+        buf[w] = 0;
+        w += 1;
+        buf[w] = name.len() as u8;
+        w += 1;
+        buf[w..w + name.len()].copy_from_slice(name);
+        w += name.len();
+        buf[w] = value.len() as u8;
+        w += 1;
+        buf[w..w + value.len()].copy_from_slice(value);
+        w += value.len();
+        let written = w - len;
+        // SAFETY: wrote `written` bytes at offset `len`; new_len <= capacity.
+        unsafe { bun_core::vec::commit_spare(&mut encoded, written) };
+    }
+    assert_eq!(&encoded[..2], b"\x82\x86");
+    assert_eq!(&encoded[2..10], b"\x00\x05:path\x06");
+    assert_eq!(encoded.len(), 2 + (3 + 5 + 6) + (3 + 10 + 3) + (3 + 1));
+}
