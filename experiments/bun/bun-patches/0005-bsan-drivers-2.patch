+#[test]
+fn ip_address_to_ip_address() {
+    use std::net::{IpAddr, Ipv4Addr};
+    let v4 = |a, b, c, d| Some(IpAddr::V4(Ipv4Addr::new(a, b, c, d)));
+    assert_eq!(bun_core::ip_address::to_ip_address(b"127.0.0.1"), v4(127, 0, 0, 1));
+    assert_eq!(bun_core::ip_address::to_ip_address(b"127.1"), v4(127, 0, 0, 1));
+    assert_eq!(bun_core::ip_address::to_ip_address(b"0x7f000001"), v4(127, 0, 0, 1));
+    assert!(bun_core::ip_address::to_ip_address(b"::1").is_some_and(|ip| ip.is_ipv6()));
+    assert!(bun_core::ip_address::to_ip_address(b"fe80::1%eth0").is_some_and(|ip| ip.is_ipv6()));
+    assert!(bun_core::ip_address::to_ip_address(b"localhost").is_none());
+    assert!(bun_core::ip_address::to_ip_address(b"1.2.3.4 ").is_none());
+    assert!(bun_core::ip_address::to_ip_address(b"").is_none());
+    assert!(bun_core::ip_address::to_ip_address(&[b'1'; 600]).is_none());
+    assert_eq!(bun_core::ip_address::strip_ipv6_brackets(b"[::1]"), b"::1");
+    assert!(bun_core::ip_address::is_ip_address(b"10.0.0.1"));
+}
