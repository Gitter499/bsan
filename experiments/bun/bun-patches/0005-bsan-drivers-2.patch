+// patch/lib.rs:115 (mkdir_recursive_at_mode) at and past the MAX_PATH_BYTES path-buffer limit
+#[test]
+fn mkdir_recursive_near_path_limit() {
+    let _g = lock();
+    let t = TmpDir::new("mkdirp_long");
+    // 15 components of 255 bytes + separators = 15*256 - 1 = 3839 bytes.
+    let comp = vec![b'x'; 255];
+    let mut deep = Vec::new();
+    for i in 0..15 {
+        if i > 0 {
+            deep.push(b'/');
+        }
+        deep.extend_from_slice(&comp);
+    }
+    sys::mkdir_recursive_at_mode(t.fd, &deep, 0o755).unwrap();
+    // Idempotent: every component already exists.
+    sys::mkdir_recursive_at_mode(t.fd, &deep, 0o755).unwrap();
+    // Grow to exactly MAX_PATH_BYTES - 1 = 4095 bytes (the largest that fits with its NUL).
+    let mut at_limit = deep.clone();
+    at_limit.push(b'/');
+    let fill = bun_core::MAX_PATH_BYTES - 1 - at_limit.len();
+    at_limit.extend(std::iter::repeat_n(b'y', fill));
+    assert_eq!(at_limit.len(), bun_core::MAX_PATH_BYTES - 1);
+    sys::mkdir_recursive_at_mode(t.fd, &at_limit, 0o755).unwrap();
+    let st = sys::fstatat(t.fd, ZStr::from_slice_with_nul(&z(&at_limit))).unwrap();
+    assert!(bun_sys::S::ISDIR(st.st_mode as _));
+    // One more byte: rejected by the buffer guard, not the kernel.
+    let mut over = at_limit.clone();
+    over.push(b'z');
+    assert_eq!(
+        sys::mkdir_recursive_at_mode(t.fd, &over, 0o755)
+            .errno_of(),
+        E::ENAMETOOLONG
+    );
+    assert_eq!(
+        sys::openat_a(t.fd, &over, O::RDONLY, 0).errno_of(),
+        E::ENAMETOOLONG
+    );
+    assert_eq!(
+        sys::open_dir_at(t.fd, &over).errno_of(),
+        E::ENAMETOOLONG
+    );
+    // At the limit the kernel still opens it.
+    let fd = sys::open_dir_at(t.fd, &at_limit).unwrap();
+    sys::close(fd).unwrap();
+    // A component longer than NAME_MAX: kernel ENAMETOOLONG.
+    let too_long_comp = vec![b'n'; 256];
+    assert_eq!(
+        sys::mkdir_recursive_at_mode(t.fd, &too_long_comp, 0o755)
+            .errno_of(),
+        E::ENAMETOOLONG
+    );
+    // File in the middle of the chain: ENOTDIR.
+    write_std(&t.std_path(b"blocker"), b"b");
+    assert_eq!(
+        sys::mkdir_recursive_at_mode(t.fd, b"blocker/a/b", 0o755)
+            .errno_of(),
+        E::ENOTDIR
+    );
+    // Dir::delete_tree tears the deep tree down relative to the dir fd.
+    Dir::borrow(&t.fd).delete_tree(&comp).unwrap();
+    assert!(!t.std_path(&comp).exists());
+}
