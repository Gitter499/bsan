+// runtime/node/node_fs_binding.rs:519 (memfd_create NonExecutable + ftruncate) + spawn_sys/spawn_process.rs:816 (CrossProcess)
+#[test]
+fn memfd_roundtrip() {
+    let _g = lock();
+    if !sys::can_use_memfd() {
+        return;
+    }
+    let fd = match sys::memfd_create(c"my_memfd", sys::MemfdFlags::NonExecutable) {
+        Ok(fd) => fd,
+        Err(_) => return,
+    };
+    sys::ftruncate(fd, 4096).unwrap();
+    assert_eq!(sys::get_file_size(fd).unwrap(), 4096);
+    sys::close(fd).unwrap();
+
+    let fd = sys::memfd_create(c"spawn_stdio_generic", sys::MemfdFlags::CrossProcess).unwrap();
+    let out = pattern(70_000, 12);
+    File::borrow(&fd).write_all(&out).unwrap();
+    // Read back the way a memfd stdout reader does: fstat-presized, pread from 0.
+    let mut list = Vec::new();
+    let n = File::borrow(&fd)
+        .read_to_end_with_array_list(&mut list, sys::SizeHint::UnknownSize)
+        .unwrap();
+    assert_eq!(n, out.len());
+    assert_eq!(list, out);
+    let mut small = Vec::new();
+    File::borrow(&fd)
+        .read_to_end_with_array_list(&mut small, sys::SizeHint::ProbablySmall)
+        .unwrap();
+    assert_eq!(small, out);
+    sys::close(fd).unwrap();
+}
