+        // FileReader keeps CLOSE_HANDLE: the reader closes the fd at EOF.
+        reader.set_parent(this.cast::<c_void>());
+        reader.start_file_offset(fd, false, 0).unwrap();
+        let mut buffer = vec![0u8; 999];
