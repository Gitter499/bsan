+// runtime/webcore/TextEncoderStreamEncoder.rs:186 (fill_spare + simdutf, slow path to_utf8_list_with_type_bun)
+#[test]
+fn text_encoder_stream_encode_utf16_into() {
+    let cases: [Vec<u16>; 4] = [
+        utf16(MULTI),
+        [0x61, 0xD800, 0x62].to_vec(),
+        [0x61, 0x62, 0xD83D].to_vec(), // dangling lead at the end → pending
+        [0xDC00, 0x41, 0x42, 0x43].to_vec(),
+    ];
+    for remain in &cases {
+        let mut buf: Vec<u8> = Vec::new();
+        let length = simdutf::length::utf8::from::utf16::le(remain);
+        buf.try_reserve(length).unwrap();
+        // SAFETY: simdutf writes initialized bytes into the spare capacity and returns the
+        // count; on non-SUCCESS we commit 0 and fall through to the slow path.
+        let result = unsafe {
+            bun_core::vec::fill_spare(&mut buf, 0, |spare| {
+                let r = simdutf::convert::utf16::to::utf8::with_errors::le(remain, spare);
+                (
+                    if r.status == simdutf::Status::SUCCESS {
+                        r.count
+                    } else {
+                        0
+                    },
+                    r,
+                )
+            })
+        };
+        let mut pending = None;
+        if result.status != simdutf::Status::SUCCESS {
+            pending = strings::to_utf8_list_with_type_bun::<true>(&mut buf, remain).unwrap();
+        }
+        match remain.as_slice() {
+            [0x61, 0x62, 0xD83D] => {
+                assert_eq!(pending, Some(0xD83D));
+                assert_eq!(buf, b"ab");
+            }
+            _ => {
+                assert!(pending.is_none());
+                let expect: String = char::decode_utf16(remain.iter().copied())
+                    .map(|r| r.unwrap_or('\u{FFFD}'))
+                    .collect();
+                assert_eq!(buf, expect.as_bytes());
+            }
+        }
+    }
+}
