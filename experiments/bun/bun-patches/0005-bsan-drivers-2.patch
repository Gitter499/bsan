+#[test]
+fn file_reader_read_into_until_eof() {
+    let _g = lock();
+    let t = TmpDir::new("read_into");
+    let data = pattern(10_007, 4);
+    t.write("blob.txt", &data);
+    let fd = t.open_ro("blob.txt");
+    let mut lp = TestLoop::new();
+    let this = FileStream::new(&raw mut *lp);
