+// runtime/cli/pm_licenses_command.rs:606 (iterate_dir(dir.fd()) over a Dir with a large directory, multiple getdents batches)
+#[test]
+fn iterate_dir_multiple_getdents_batches() {
+    let _g = lock();
+    let t = TmpDir::new("iterate_batches");
+    // 8 KiB getdents buffer; ~40 entries with 200-byte names need several refills.
+    let mut names = Vec::new();
+    for i in 0..40 {
+        let mut n = format!("{i:02}_").into_bytes();
+        n.extend(std::iter::repeat_n(b'q', 200));
+        std::fs::create_dir(t.std_path(&n)).unwrap();
+        names.push(n);
+    }
+    let dir = Dir::open(t.bytes()).unwrap();
+    let mut iter = sys::iterate_dir(dir.fd());
+    let mut seen = Vec::new();
+    while let Some(entry) = iter.next().unwrap() {
+        let name = entry.name.slice_u8().to_vec();
+        if entry.kind == EntryKind::Directory || entry.kind == EntryKind::Unknown {
+            // Open each child by the borrowed name before the next getdents refill.
+            let child = sys::open_dir_for_iteration_os_path(iter.dir(), entry.name.slice()).unwrap();
+            sys::close(child).unwrap();
+        }
+        seen.push(name);
+    }
+    seen.sort();
+    names.sort();
+    assert_eq!(seen, names);
+}
