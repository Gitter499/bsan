+// bundler/LinkerContext.rs:1339 (append_source_map_chunk per file, offsets from
+// bundler/linker_context/postProcessJSChunk.rs:653 line_offset.advance, chunk aliased at :666)
+// then SourceMapPieces::finalize at bundler/linker_context/generateChunksInParallel.rs:763
+#[test]
+fn bundler_join_chunks_and_finalize_shifts() {
+    let a = print_bundler(&source_lines(6));
+    let b_lines: Vec<String> = (0..5).map(|i| format!("const b{i} = f(a{i}) ?? \"ñ\";")).collect();
+    let b = print_bundler(&b_lines);
+    assert!(!a.chunk.should_ignore && !b.chunk.should_ignore);
+
+    // The chunk joined from a printed module-wrapper prefix plus both files.
+    let prefix: &[u8] = b"// @bun\nimport \"./chunk-XXXXXXXX.js\";\n";
+    let mut line_offset = LineColumnOffsetOptional::Value(LineColumnOffset::default());
+    line_offset.advance(prefix);
+    let mut offsets = Vec::new();
+    let mut code = prefix.to_vec();
+    for (i, out) in [&a.output, &b.output].into_iter().enumerate() {
+        if i > 0 {
+            // per-file comment the linker prints between modules
+            let comment: &[u8] = b"\n// src/b.ts\n";
+            line_offset.advance(comment);
+            code.extend_from_slice(comment);
+        }
+        let LineColumnOffsetOptional::Value(v) = line_offset else { unreachable!() };
+        offsets.push(v);
+        code.extend_from_slice(out);
+        // the result's own lines are carried by its VLQ chunk
+        line_offset.reset();
+    }
+    let line0 = offsets[0].lines.zero_based();
+    let line1 = line0 + bun_core::strings::count_char(&a.output, b'\n') as i32 + offsets[1].lines.zero_based();
+    assert_eq!(line1, bun_core::strings::count_char(&code[..code.len() - b.output.len()], b'\n') as i32);
+    // SAFETY: the alias is never dropped (ManuallyDrop), as in postProcessJSChunk.rs.
+    let a_alias = core::mem::ManuallyDrop::new(unsafe { a.chunk.alias() });
+    let chunks: [&Chunk; 2] = [&a_alias, &b.chunk];
+
+    let mut j = StringJoiner::default();
+    j.push_static(b"{\n  \"version\": 3,\n  \"sources\": [\"a.ts\", \"b.ts\"],\n  \"sourcesContent\": [null, null],\n  \"mappings\": \"");
+    let mapping_start = j.len;
+    let mut prev_end_state = SourceMapState::default();
+    let mut prev_column_offset = 0;
+    for (idx, (chunk, offset)) in chunks.iter().zip(&offsets).enumerate() {
+        let mut start_state = SourceMapState {
+            source_index: idx as i32,
+            generated_line: offset.lines.zero_based(),
+            generated_column: offset.columns.zero_based(),
+            ..Default::default()
+        };
+        if offset.lines.zero_based() == 0 {
+            start_state.generated_column += prev_column_offset;
+        }
+        bun_sourcemap::append_source_map_chunk(&mut j, prev_end_state, start_state, &chunk.buffer.list)
+            .unwrap_or_else(|e| panic!("{e}"));
+        prev_end_state = chunk.end_state;
+        prev_end_state.source_index = idx as i32;
+        prev_column_offset = chunk.final_generated_column;
+        if prev_end_state.generated_line == 0 {
+            prev_end_state.generated_column += start_state.generated_column;
+            prev_column_offset += start_state.generated_column;
+        }
+    }
+    let mapping_end = j.len;
+    j.push_static(b"\",\n  \"names\": []\n}");
+    let done = j.done().expect("join");
+    let joined_mappings = done[mapping_start..mapping_end].to_vec();
+
+    let joined = mapping::parse(&joined_mappings, None, 2, 0, ParseOptions { allow_names: false, sort: true })
+        .unwrap_or_else(|f| panic!("{}", f.err));
+    for &(gl, gc, ol, oc) in &a.expected {
+        let m = joined.find_mapping(ord(gl + line0), ord(gc)).expect("a");
+        assert_eq!((m.source_index, m.original_line(), m.original_column()), (0, ol, oc));
+    }
+    for &(gl, gc, ol, oc) in &b.expected {
+        let m = joined.find_mapping(ord(gl + line1), ord(gc)).expect("b");
+        assert_eq!((m.source_index, m.original_line(), m.original_column()), (1, ol, oc));
+    }
+
+    // A placeholder at line `line0` col 1 is substituted with a string 8 bytes longer.
+    let mut pieces = SourceMapPieces::init();
+    pieces.prefix.extend_from_slice(&done[..mapping_start]);
+    pieces.mappings.extend_from_slice(&joined_mappings);
+    pieces.suffix.extend_from_slice(&done[mapping_end..]);
+    let at = |l, c| LineColumnOffset { lines: ord(l), columns: ord(c) };
+    let shifts = [
+        SourceMapShifts { before: LineColumnOffset::default(), after: LineColumnOffset::default() },
+        SourceMapShifts { before: at(line0, 1), after: at(line0, 9) },
+    ];
+    let finalized = pieces.finalize(&shifts).expect("finalize");
+    assert_eq!(finalized[0], b'{');
+    let start = bun_core::strings::index_of(&finalized, b"\"mappings\": \"").unwrap() + 13;
+    let end = start + bun_core::strings::index_of_char_usize(&finalized[start..], b'"').unwrap();
+    let shifted = mapping::parse(&finalized[start..end], None, 2, 0, ParseOptions::default())
+        .unwrap_or_else(|f| panic!("{}", f.err));
+    assert_eq!(shifted.mappings.generated().len(), joined.mappings.generated().len());
+    for (s, o) in shifted.mappings.generated().iter().zip(joined.mappings.generated()) {
+        assert_eq!(s.lines.zero_based(), o.lines.zero_based());
+        let delta = if o.lines.zero_based() == line0 && o.columns.zero_based() > 1 { 8 } else { 0 };
+        assert_eq!(s.columns.zero_based(), o.columns.zero_based() + delta);
+    }
+
+    // No shifts and no mappings: prefix returned verbatim.
+    let mut verbatim = SourceMapPieces::init();
+    verbatim.prefix = done.into_vec();
+    let out = verbatim.finalize(&[]).expect("finalize");
+    assert!(out.ends_with(b"}"));
+    assert!(code.len() > prefix.len());
+    let _ = (&a.source, &b.source);
+}
