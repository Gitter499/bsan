+// runtime/webcore/TextEncoder.rs:68 (encode16 small stack buffer) and :275 (encodeInto)
+#[test]
+fn copy_utf16_into_utf8_text_encoder() {
+    const SMALL_BUF_LEN: usize = 192;
+    // encode16_impl small path
+    for s in ["", "a", MULTI, "\u{1F600}\u{1F600}\u{1F600}"] {
+        let slice = utf16(s);
+        let mut buf = [0u8; SMALL_BUF_LEN];
+        let result = strings::copy_utf16_into_utf8(&mut buf, &slice);
+        assert_eq!(result.read as usize, slice.len());
+        assert_eq!(&buf[..result.written as usize], s.as_bytes());
+    }
+    // encode16_impl large path: need = element_length_utf16_into_utf8, exact-size output
+    for n in ASCII_LENS {
+        let s = format!("{}{}", String::from_utf8(ascii(n * 2)).unwrap(), MULTI);
+        let slice = utf16(&s);
+        let need = strings::element_length_utf16_into_utf8(&slice);
+        assert_eq!(need, s.len());
+        let mut out = vec![0u8; need];
+        let r = strings::copy_utf16_into_utf8(&mut out, &slice);
+        assert_eq!(r.written as usize, need);
+        assert_eq!(out, s.as_bytes());
+    }
+    // encodeInto with too-small destination and lone surrogates (scalar partial path)
+    let mut input = utf16("ab\u{20AC}");
+    input.push(0xD800);
+    input.extend(utf16("\u{1F600}z"));
+    for cap in 0..12usize {
+        let mut output = vec![0u8; cap];
+        let result = strings::copy_utf16_into_utf8(&mut output, &input);
+        assert!(result.written as usize <= cap);
+        assert!(result.read as usize <= input.len());
+        let written = &output[..result.written as usize];
+        assert!(strings::is_valid_utf8(written), "cap={cap}: {written:?}");
+    }
+    // element length charges 3 bytes per unpaired surrogate
+    assert_eq!(strings::element_length_utf16_into_utf8(&[0xD800, 0x41]), 4);
+}
