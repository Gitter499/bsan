+// runtime/node/node_fs.rs:4899 (sendfile loop until 0 with i32::MAX - 1 chunk)
+#[test]
+fn sendfile_loop() {
+    let _g = lock();
+    let t = TmpDir::new("sendfile");
+    let data = pattern(150_000, 9);
+    write_std(&t.std_path(b"src"), &data);
+    let src_fd = sys::openat_a(t.fd, b"src", O::RDONLY, 0).unwrap();
+    let dest_fd = sys::openat_a(t.fd, b"dst", O::WRONLY | O::CREAT | O::TRUNC, 0o644).unwrap();
+    let mut wrote = 0u64;
+    loop {
+        let amt = sys::sendfile(src_fd, dest_fd, i32::MAX as usize - 1).unwrap();
+        wrote += amt as u64;
+        if amt == 0 {
+            break;
+        }
+    }
+    assert_eq!(wrote as usize, data.len());
+    sys::close(src_fd).unwrap();
+    sys::close(dest_fd).unwrap();
+    assert_eq!(std::fs::read(t.std_path(b"dst")).unwrap(), data);
+    // sendfile from a directory fd fails (node_fs then falls back to the read/write loop).
+    let sink = sys::openat_a(t.fd, b"sink", O::WRONLY | O::CREAT | O::TRUNC, 0o644).unwrap();
+    let e = sys::sendfile(t.fd, sink, 10).unwrap_err();
+    assert!(matches!(e.get_errno(), E::EINVAL | E::EISDIR | E::EBADF));
+    sys::close(sink).unwrap();
+}
