+// runtime/api/BunObject.rs:1651 (mmap_file with offset/size, munmap from the page-rounded base)
+#[test]
+fn mmap_file_offsets() {
+    let _g = lock();
+    let t = TmpDir::new("mmap");
+    let page = sys::page_size();
+    let data = pattern(3 * page + 123, 4);
+    write_std(&t.std_path(b"m.bin"), &data);
+    let p = t.abs_z(b"m.bin");
+    let buf_z = ZStr::from_slice_with_nul(&p);
+    for &(map_size, offset) in &[
+        (None, 0usize),
+        (Some(10usize), 0),
+        (None, 100),
+        (Some(page), page + 7),
+        (None, data.len() - 1),
+    ] {
+        let (map, delta) = sys::mmap_file(buf_z, libc::MAP_SHARED, map_size, offset).unwrap();
+        assert_eq!(delta, offset % page);
+        let want_len = map_size.map_or(data.len() - offset, |s| s.min(data.len() - offset));
+        assert_eq!(map.len(), want_len + delta);
+        assert_eq!(&map[delta..], &data[offset..offset + want_len]);
+        // Write through the shared mapping.
+        map[delta] ^= 0xFF;
+        let ptr = map[delta..].as_mut_ptr();
+        let addr = ptr as usize;
+        let len = map.len();
+        sys::munmap((addr - addr % page) as *mut u8, len).unwrap();
+        let after = std::fs::read(t.std_path(b"m.bin")).unwrap();
+        assert_eq!(after[offset], data[offset] ^ 0xFF);
+        write_std(&t.std_path(b"m.bin"), &data);
+    }
+    // Offset at EOF maps 0 bytes: EINVAL.
+    assert_eq!(
+        sys::mmap_file(buf_z, libc::MAP_SHARED, None, data.len())
+            .errno_of(),
+        E::EINVAL
+    );
+    // Empty file.
+    write_std(&t.std_path(b"empty"), b"");
+    let e = t.abs_z(b"empty");
+    assert!(sys::mmap_file(ZStr::from_slice_with_nul(&e), libc::MAP_SHARED, None, 0).is_err());
+    let missing = t.abs_z(b"missing");
+    assert_eq!(
+        sys::mmap_file(ZStr::from_slice_with_nul(&missing), libc::MAP_SHARED, None, 0)
+            .errno_of(),
+        E::ENOENT
+    );
+}
