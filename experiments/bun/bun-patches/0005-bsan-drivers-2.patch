+            .unwrap();
+    let parts: &[&[u8]] = &[b"/home/user", b"/", b"node_modules"];
+    let b: &'static [u8] =
+        unsafe { BSSStringList::append(dirname_store_backing(), &parts) }.unwrap();
+    let c: &'static [u8] = unsafe {
+        BSSStringList::print(
+            dirname_store_backing(),
+            format_args!("https://registry.npmjs.org/{}/-/{}-{}.tgz", "react", "react", "18.2.0"),
+        )
+    }
+    .unwrap();
+    let d: &'static [u8] =
+        unsafe { BSSStringList::append_lower_case(dirname_store_backing(), b"/Users/ME/Src") }
+            .unwrap();
+    // > 256 bytes: append_lower_case's mi_malloc scratch path.
+    let long_upper = "ABCDEFGHIJ".repeat(30);
+    let e: &'static [u8] = unsafe {
+        BSSStringList::append_lower_case(dirname_store_backing(), long_upper.as_bytes())
+    }
+    .unwrap();
+    // > 512 bytes formatted: print's count-then-reserve path.
+    let long = "x".repeat(600);
+    let f: &'static [u8] =
+        unsafe { BSSStringList::print(dirname_store_backing(), format_args!("{long}/{}", 7)) }
+            .unwrap();
+    // Fill past COUNT so slice_buf overflows into the OverflowList.
+    let mut extra = Vec::new();
+    for i in 0..20 {
+        let s = format!("/dir/{i}");
+        let s: &[u8] = s.as_bytes();
+        extra.push(unsafe { BSSStringList::append(dirname_store_backing(), &s) }.unwrap());
+    }
+    assert_eq!(a, b"/home/user/project");
+    assert_eq!(b, b"/home/user/node_modules");
+    assert_eq!(c, b"https://registry.npmjs.org/react/-/react-18.2.0.tgz");
+    assert_eq!(d, b"/users/me/src");
+    assert_eq!(e, long_upper.to_ascii_lowercase().as_bytes());
+    assert_eq!(f.len(), 602);
+    assert!(f.starts_with(b"xxx") && f.ends_with(b"/7"));
+    for (i, s) in extra.iter().enumerate() {
+        assert_eq!(*s, format!("/dir/{i}").as_bytes());
+    }
+}
+
+/// Stand-in for `resolver::fs::Entry`: plain fields written once at
+/// construction, plus the `Cell`-backed `cache` the resolver updates later.
+struct Entry {
+    base: [u8; 16],
+    base_len: u8,
+    cache: Cell<u32>,
+}
+
+// resolver/fs.rs:339 (EntryStore::append_uninit → BSSList::append_uninit(instance()))
+// + resolver/fs.rs:222 (Entry::kind → self.cache.set(c) on an already-stored entry)
+#[test]
+fn bss_list_entry_store() {
+    let mut entries: Vec<*mut Entry> = Vec::new();
+    // 4 inline + 256 in the inline tail block + 2 heap overflow blocks.
+    for i in 0..(4 + 256 * 2 + 40) {
+        let name = format!("e{i}");
+        let mut base = [0u8; 16];
+        base[..name.len()].copy_from_slice(name.as_bytes());
+        // SAFETY: live process-lifetime singleton.
+        let slot = unsafe { BSSList::append_uninit(entry_store_backing()) }.expect("append");
+        // SAFETY: fresh reserved slot; fully initialised before any other access.
+        let e = unsafe {
+            (*slot).write(Entry {
+                base,
+                base_len: name.len() as u8,
+                cache: Cell::new(0),
+            })
+        };
+        entries.push(e);
+    }
+    // Later lookups update the stat cache through `&Entry`.
+    for (i, e) in entries.iter().enumerate() {
+        // SAFETY: slot initialised above; singleton never frees it.
+        let e: &Entry = unsafe { &**e };
+        e.cache.set(i as u32 + 1);
+    }
+    for (i, e) in entries.iter().enumerate() {
+        // SAFETY: as above.
+        let e: &Entry = unsafe { &**e };
+        let name = format!("e{i}");
+        assert_eq!(&e.base[..e.base_len as usize], name.as_bytes());
+        assert_eq!(e.cache.get(), i as u32 + 1);
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Debug)]
+struct DirEntryStub {
+    id: u64,
+    generation: u64,
+}
+
+fn entries_map() -> &'static mut BSSMapInner<DirEntryStub, 4, true> {
+    // SAFETY: mirrors `EntriesMap::inner` (resolver/lib.rs:1006): the process-static
+    // singleton, accessed from one thread at a time.
+    unsafe { &mut *entries_option_map() }
+}
+
+// resolver/lib.rs:1242 (read_directory: get_or_put → at_index → put), :1188 (mark_not_found),
+// :1358 (bust_entries_cache → remove), resolver/resolver.rs:4320 (entries.get(top))
+#[test]
+fn bss_map_inner_dir_cache() {
+    let dirs: Vec<String> = (0..10).map(|i| format!("/project/src/dir{i}/")).collect();
+    for (i, dir) in dirs.iter().enumerate() {
+        let mut cache_result = entries_map().get_or_put(dir.as_bytes()).unwrap();
+        assert!(cache_result.status == ItemStatus::Unknown);
+        assert!(!cache_result.has_checked_if_exists());
+        assert!(entries_map().at_index(cache_result.index).is_none());
+        let out = entries_map()
+            .put(
+                &mut cache_result,
+                DirEntryStub {
+                    id: i as u64,
+                    generation: 0,
+                },
+            )
+            .unwrap();
+        assert_eq!(out.id, i as u64);
+    }
+    // Cached lookups (trailing slash trimmed by REMOVE_TRAILING_SLASHES).
+    for (i, dir) in dirs.iter().enumerate() {
+        let r = entries_map().get_or_put(dir.trim_end_matches('/').as_bytes()).unwrap();
+        assert!(r.status == ItemStatus::Exists);
+        let cached = entries_map().at_index(r.index).expect("cached");
+        assert_eq!(cached.id, i as u64);
+        cached.generation += 1;
+    }
+    // Re-put over an existing (backing and overflow) slot.
+    for (i, dir) in dirs.iter().enumerate().take(6) {
+        let mut r = entries_map().get_or_put(dir.as_bytes()).unwrap();
+        let out = entries_map()
+            .put(
+                &mut r,
+                DirEntryStub {
+                    id: i as u64 + 100,
+                    generation: 5,
+                },
+            )
+            .unwrap();
+        assert_eq!(out.id, i as u64 + 100);
+    }
+    let top = entries_map().get(dirs[7].as_bytes()).expect("get");
+    assert_eq!(*top, DirEntryStub { id: 7, generation: 1 });
+    // Mutate a cached overflow slot through `get` and observe it on the next lookup.
+    entries_map().get(dirs[9].as_bytes()).unwrap().generation = 42;
+    assert_eq!(entries_map().get(dirs[9].as_bytes()).unwrap().generation, 42);
+    // ENOENT: mark_not_found.
+    let missing = entries_map().get_or_put(b"/does/not/exist").unwrap();
+    entries_map().mark_not_found(missing);
+    let again = entries_map().get_or_put(b"/does/not/exist").unwrap();
+    assert!(again.status == ItemStatus::NotFound);
+    assert!(entries_map().at_index(again.index).is_none());
+    // bust_entries_cache
+    assert!(entries_map().remove(dirs[0].as_bytes()));
+    assert!(!entries_map().remove(dirs[0].as_bytes()));
+    assert!(entries_map().get(dirs[0].as_bytes()).is_none());
+}
