+// BorrowSanitizer driver tests for `bun_alloc`.
+//
+// Each test replays the call sequence of one production call site (named in
+// the comment above it as `path:line`, relative to `src/`) against the real
+// `bun_alloc` API, so the crate's unsafe code runs the way Bun drives it.
+// Inputs are kept small (BSan is ~100x slower than native).
+#![feature(allocator_api)]
+#![feature(allocator_ext)]
+#![allow(stable_features, unused_features)]
+
+use core::alloc::{Allocator, GlobalAlloc, Layout};
+use core::cell::Cell;
