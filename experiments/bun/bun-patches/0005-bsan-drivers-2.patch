+// runtime/node/path.rs:3003 (convert into a fixed u16 buffer, then NUL-terminate)
+#[test]
+fn convert_utf8_to_utf16_in_buffer_path_key() {
+    let mut u16_buf = vec![0u16; 256];
+    for n in ASCII_LENS {
+        let key8 = ascii_then(n, MULTI.as_bytes());
+        let n_out = strings::convert_utf8_to_utf16_in_buffer(&mut u16_buf[..], &key8).len();
+        u16_buf[n_out] = 0;
+        let expect: Vec<u16> = String::from_utf8(key8).unwrap().encode_utf16().collect();
+        assert_eq!(&u16_buf[..n_out], &expect[..]);
+    }
+    // invalid input: WTF-8 fallback writes U+FFFD
+    let n_out = strings::convert_utf8_to_utf16_in_buffer(&mut u16_buf[..], b"PATH\xFF\xED\xA0\x80").len();
+    assert_eq!(&u16_buf[..n_out], &[0x50, 0x41, 0x54, 0x48, 0xFFFD, 0xD800]);
+    // checked variant refuses when it does not fit
+    let mut small = [0u16; 4];
+    assert!(strings::try_convert_utf8_to_utf16_in_buffer(&mut small, b"abcdefgh").is_none());
+}
