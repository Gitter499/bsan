+//! BorrowSanitizer drivers for bun_sourcemap: the runtime (SavedSourceMap / stack
+//! remapping / coverage), bundler (chunk join + shift finalize) and dev-server
+//! paths over esbuild/tsc-style source maps. Each test mirrors a production
+//! call site named in the comment above it. Not part of Bun's suite.
+use std::sync::Arc;
+
+use bun_ast::Loc;
+use bun_core::{EncodedSlice, MutableString, StringJoiner, StringView};
+use bun_sourcemap::chunk::{Builder, LineOffsetTables, SourceMapFormat};
+use bun_sourcemap::internal_source_map::{self, InternalSourceMap};
+use bun_sourcemap::mapping::{self, Lookup, ParseOptions};
+use bun_sourcemap::parsed_source_map::AnySourceProvider;
+use bun_sourcemap::{
+    Chunk, LineColumnOffset, LineColumnOffsetOptional, LineOffsetTable, LineOffsetTableColumns,
+    Ordinal, ParseUrlResultHint, ParsedSourceMap, SourceContentPtr, SourceMapLoadHint,
+    SourceMapPieces, SourceMapShifts, SourceMapState, SourceProvider, VLQ,
+};
+
+fn ord(n: i32) -> Ordinal {
+    Ordinal::from_zero_based(n)
+}
+
+// ── realistic inputs ──────────────────────────────────────────────────────
+
+const UTIL_TS: &str = "export function add(a: number, b: number): number {\n  return a + b;\n}\n";
+const INDEX_TS: &str = "import { add } from \"./util\";\nconsole.log(add(1, 2));\n";
+
+/// esbuild `--bundle --sourcemap` output for util.ts + index.ts (two sources,
+/// a leading empty generated line, sourcesContent, empty `names`).
+fn esbuild_two_source_map() -> String {
+    format!(
+        concat!(
+            "{{\"version\":3,\"sources\":[\"../src/util.ts\",\"../src/index.ts\"],",
+            "\"sourcesContent\":[{},{}],",
+            "\"mappings\":\";AAAO,SAAS,IAAI,GAAW,GAAmB;AAChD,SAAO,IAAI;AACb;;;ACDA,QAAQ,IAAI,IAAI,GAAG,CAAC,CAAC;\",",
+            "\"names\":[]}}"
+        ),
+        json_quote(UTIL_TS),
+        json_quote(INDEX_TS)
+    )
+}
+
+fn json_quote(s: &str) -> String {
+    let mut out = String::from("\"");
+    for c in s.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            '\n' => out.push_str("\\n"),
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+    out
+}
+
+/// esbuild `--minify --sourcemap` style mappings with a names column (5-field
+/// segments), long enough (>= 128 bytes) to take the Highway SIMD pre-pass,
+/// with one backwards generated-column delta per few lines to force the sort.
+fn minified_mappings_with_names(lines: i32) -> (Vec<u8>, Vec<(i32, i32, i32, i32, i32)>) {
+    let mut out = Vec::new();
+    // (gen_line, gen_col, orig_line, orig_col, name)
+    let mut expected = Vec::new();
+    let (mut src, mut ol, mut oc, mut name) = (0i32, 0i32, 0i32, 0i32);
+    for line in 0..lines {
+        if line > 0 {
+            out.push(b';');
+        }
+        let mut gc = 0i32;
+        let cols: &[i32] = if line % 4 == 3 { &[0, 12, 7, 20] } else { &[0, 9, 17] };
+        for (k, &col) in cols.iter().enumerate() {
+            if k > 0 {
+                out.push(b',');
+            }
+            let new_src = (line / 5) % 2;
+            let new_ol = line;
+            let new_oc = col / 2 + 2;
+            let new_name = (line * 3 + k as i32) % 5;
+            for v in [col - gc, new_src - src, new_ol - ol, new_oc - oc, new_name - name] {
+                out.extend_from_slice(VLQ::encode(v).slice());
+            }
+            gc = col;
+            src = new_src;
+            ol = new_ol;
+            oc = new_oc;
+            name = new_name;
+            expected.push((line, col, new_ol, new_oc, new_name));
+        }
+    }
+    (out, expected)
+}
+
+// ── providers (the trait impls the runtime registers with SavedSourceMap) ──
+
+/// Rust-side stand-in for the JSC `ZigSourceProvider` (`SourceProviderMap`):
+/// the transpiled source text, whose trailing `//# sourceMappingURL=` is
+/// searched for an inline map, falling back to `<file>.map` on disk.
+struct TranspiledSource {
+    code: Vec<u8>,
+}
+
+impl SourceProvider for TranspiledSource {
+    fn get_source_slice(&self) -> StringView<'_> {
+        StringView::from_bytes(&self.code)
+    }
+    fn to_source_content_ptr(&self) -> SourceContentPtr {
+        SourceContentPtr::from_source_provider::<Self>(self)
+    }
+}
+
+/// UTF-16 backed source (JSC strings that are not 8-bit).
+struct TranspiledSource16 {
+    code: Vec<u16>,
+}
+
+impl SourceProvider for TranspiledSource16 {
+    fn get_source_slice(&self) -> StringView<'_> {
+        StringView::from_encoded(EncodedSlice::utf16(&self.code))
+    }
+    fn to_source_content_ptr(&self) -> SourceContentPtr {
+        SourceContentPtr::from_source_provider::<Self>(self)
+    }
+}
+
+/// Mirrors runtime/bake/source_provider_exports.rs:100 (`DevServerSourceProvider`):
+/// carries its own authoritative source map JSON.
+struct DevServerSource {
+    code: Vec<u8>,
+    json: Vec<u8>,
+}
+
+impl SourceProvider for DevServerSource {
+    const HAS_SOURCE_MAP_JSON: bool = true;
+    fn get_source_slice(&self) -> StringView<'_> {
+        StringView::from_bytes(&self.code)
+    }
+    fn to_source_content_ptr(&self) -> SourceContentPtr {
+        SourceContentPtr::from_source_provider::<Self>(self)
+    }
+    fn get_source_map_json(&self) -> Option<&[u8]> {
+        if self.json.is_empty() { None } else { Some(&self.json) }
+    }
+}
+
+fn inline_source(json: &str) -> Vec<u8> {
+    let mut code = b"// out.js\nfunction add(a, b) {\n  return a + b;\n}\nconsole.log(add(1, 2));\n".to_vec();
+    code.extend_from_slice(b"//# sourceMappingURL=data:application/json;base64,");
+    code.extend_from_slice(&bun_base64::encode_alloc(json.as_bytes()));
+    code.extend_from_slice(b"  \r\n");
+    code
+}
