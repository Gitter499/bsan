+// runtime/shell/shell_body.rs:635 (reserve exact length then convert_utf16_to_utf8_append)
+#[test]
+fn convert_utf16_to_utf8_append_shell_outbuf() {
+    for n in ASCII_LENS {
+        let s = format!("{}{}", String::from_utf8(ascii(n)).unwrap(), MULTI);
+        let u = utf16(&s);
+        let mut outbuf: Vec<u8> = b"echo ".to_vec();
+        let size = simdutf::length::utf8::from::utf16::le(&u);
+        outbuf.reserve(size);
+        strings::convert_utf16_to_utf8_append(&mut outbuf, &u);
+        assert_eq!(&outbuf[5..], s.as_bytes());
+    }
+    // Lone surrogates: simdutf reports SURROGATE, WTF-8 fallback replaces with U+FFFD.
+    let mut u = utf16("ab");
+    u.push(0xD800);
+    u.extend(utf16("cd"));
+    u.push(0xDC00);
+    let mut outbuf: Vec<u8> = Vec::new();
+    outbuf.reserve(simdutf::length::utf8::from::utf16::le(&u));
+    strings::convert_utf16_to_utf8_append(&mut outbuf, &u);
+    assert_eq!(outbuf, "ab\u{FFFD}cd\u{FFFD}".as_bytes());
+}
