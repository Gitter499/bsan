+// sourcemap_jsc/internal_jsc.rs:15 (fromVLQ), :33 (toVLQ), :53 (find)
+#[test]
+fn internal_source_map_from_vlq_find_and_reencode() {
+    let (vlq, expected) = multi_window_vlq();
+    let blob = internal_source_map::from_vlq(&vlq, 0).unwrap_or_else(|_| panic!("from_vlq"));
+    assert!(internal_source_map::is_valid_blob(&blob));
+    let ism = InternalSourceMap { data: blob.as_ptr() };
+    assert_eq!(ism.mapping_count(), expected.len());
+    for &(gl, gc, src, ol, oc) in &expected {
+        let m = ism.find(ord(gl), ord(gc)).unwrap_or_else(|| panic!("find {gl}:{gc}"));
+        assert_eq!((m.source_index, m.original_line(), m.original_column()), (src, ol, oc), "{gl}:{gc}");
+        // Column past the 1-field segment still resolves to the last 4-field one on the line.
+        assert!(ism.find(ord(gl), ord(gc + 1)).is_some());
+    }
+    assert!(ism.find(ord(1), ord(0)).is_none()); // line 1 starts at column 1
+    assert!(ism.find(ord(1), ord(5)).is_some());
+    assert!(ism.find(ord(9999), ord(0)).is_none());
+
+    // Round trip: append_vlq_to → mapping::parse sees the same mappings.
+    let mut out = MutableString::init_empty();
+    ism.append_vlq_to(&mut out);
+    let reparsed = mapping::parse(out.list.as_slice(), None, 3, 0, ParseOptions::default())
+        .unwrap_or_else(|f| panic!("{}", f.err));
+    assert_eq!(reparsed.mappings.generated().len(), expected.len());
+    let blob2 = internal_source_map::from_vlq(out.list.as_slice(), 0).unwrap_or_else(|_| panic!("again"));
+    assert_eq!(&*blob2, &*blob);
+
+    // Invalid inputs are rejected.
+    assert!(internal_source_map::from_vlq(b"AAAA,D", 0).is_err()); // gen col goes negative
+    assert!(internal_source_map::from_vlq(b"AAAA;AADA", 0).is_err());
+    assert!(internal_source_map::from_vlq(b"AAAA,!", 0).is_err());
+    assert!(InternalSourceMap::from_vlq(b"", 0).is_ok());
+}
