+/// runtime/server/FileResponseStream.rs:226-279: configure flags, set_limit, set_parent,
+/// start / start_file_offset (non-pollable regular file), update_ref(true), BufferedReader::read.
+fn file_response_stream_start(this: *mut FileStream, fd: Fd, offset: usize, length: Option<usize>) {
+    // SAFETY: `this` is the live boxed parent; borrows of the reader end before `read`.
+    unsafe {
+        let reader = &mut (*this).reader;
+        reader.flags.remove(PosixFlags::CLOSE_HANDLE); // we own fd via auto_close
+        reader.flags.set(PosixFlags::POLLABLE, false);
+        reader.flags.set(PosixFlags::NONBLOCKING, false);
+        reader.set_limit(length);
+        reader.set_parent(this.cast::<c_void>());
+        let start_result = if offset > 0 {
+            reader.start_file_offset(fd, false, offset)
+        } else {
+            reader.start(fd, false)
+        };
+        start_result.expect("start");
+        (*this).reader.update_ref(true);
+        BufferedReader::read(&raw mut (*this).reader);
+    }
+}
+
+fn free_stream(this: *mut FileStream) -> Box<FileStream> {
+    // SAFETY: allocated by `FileStream::new`; no reader call is in flight.
+    unsafe { Box::from_raw(this) }
+}
