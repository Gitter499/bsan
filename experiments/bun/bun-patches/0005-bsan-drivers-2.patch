+// runtime/server/DirectoryRoute.rs:305 (openat2_in_root with RDONLY|CLOEXEC|NONBLOCK)
+#[test]
+fn openat2_in_root_resolves_inside_root() {
+    let _g = lock();
+    let t = TmpDir::new("openat2");
+    std::fs::create_dir(t.std_path(b"sub")).unwrap();
+    write_std(&t.std_path(b"index.html"), b"<html>root</html>");
+    let flags = O::RDONLY | O::CLOEXEC | O::NONBLOCK;
+    let fd = sys::openat2_in_root(t.fd, ZStr::from_slice_with_nul(b"sub/../index.html\0"), flags, 0)
+        .unwrap();
+    assert_eq!(File::borrow(&fd).read_to_end().unwrap(), b"<html>root</html>");
+    sys::close(fd).unwrap();
+    // `..` past the root is clamped to the root (or, on the openat fallback, escapes to a
+    // path that does not exist): either way no file outside is opened.
+    match sys::openat2_in_root(
