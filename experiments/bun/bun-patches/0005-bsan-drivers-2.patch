+#[test]
+fn walker_resolve_unknown_types_owned() {
+    let _g = lock();
+    let t = TmpDir::new("walker_owned");
+    std::fs::create_dir(t.std_path(b"public")).unwrap();
+    std::fs::create_dir(t.std_path(b"public/img")).unwrap();
+    for i in 0..20 {
+        write_std(&t.std_path(format!("public/img/{i}.png").as_bytes()), &pattern(i * 13, i as u32));
+    }
+    write_std(&t.std_path(b"public/index.html"), b"<html/>");
+    let dir = sys::open_dir_for_iteration(t.fd, b"public").unwrap();
+    let mut walker = sys::walker_skippable::walk(dir, &[], &[]).unwrap();
+    walker.resolve_unknown_entry_types = true;
+    let mut count = 0;
+    let mut total = 0usize;
+    loop {
+        let entry = match walker.next() {
+            Ok(Some(e)) => e,
+            Ok(None) => break,
+            Err(e) => panic!("walk: {e:?}"),
+        };
+        if entry.kind != EntryKind::File {
+            continue;
+        }
+        let st = sys::fstatat(entry.dir, entry.basename).unwrap();
+        total += st.st_size as usize;
+        count += 1;
+    }
+    assert_eq!(count, 21);
+    assert_eq!(total, (0..20).map(|i| i * 13).sum::<usize>() + 7);
+    drop(walker);
+    sys::close(dir).unwrap();
+
+    // walk_owned closes the root itself.
+    let owned = Dir::open(t.bytes()).unwrap();
+    let mut w = sys::walker_skippable::walk_owned(owned, &[], &[&b"img"[..]]).unwrap();
+    let mut n = 0;
+    while let Some(e) = w.next().unwrap() {
+        assert!(!e.path.as_bytes().starts_with(b"public/img/"));
+        n += 1;
+    }
+    // `public` and `public/index.html`; `img` is skipped as a directory name.
+    assert_eq!(n, 2);
+}
