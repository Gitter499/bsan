+            v.push(f as u32 * 100 + i);
+        }
+    }
+    for (f, v) in records.iter().enumerate() {
+        assert!(v.iter().enumerate().all(|(i, x)| *x == f as u32 * 100 + i as u32));
+    }
+    drop(records);
