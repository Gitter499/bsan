+        E::EEXIST
+    );
+    // rmdir of a non-empty dir; then of the emptied one.
+    assert_eq!(
+        sys::rmdirat(t.fd, ZStr::from_slice_with_nul(b"@scope\0"))
+            .errno_of(),
+        E::ENOTEMPTY
+    );
+    sys::rmdirat(t.fd, ZStr::from_slice_with_nul(b"@scope/pkg\0")).unwrap();
+    sys::rmdirat(t.fd, ZStr::from_slice_with_nul(b"@scope\0")).unwrap();
+    sys::rmdir(ZStr::from_slice_with_nul(&abs)).unwrap();
+    assert_eq!(
+        sys::rmdir(ZStr::from_slice_with_nul(&abs))
+            .errno_of(),
+        E::ENOENT
+    );
+    // unlink of a directory: EISDIR on Linux; unlink of a missing file: ENOENT.
+    std::fs::create_dir(t.std_path(b"d")).unwrap();
+    let d = t.abs_z(b"d");
+    assert_eq!(
+        sys::unlink(ZStr::from_slice_with_nul(&d))
+            .errno_of(),
+        E::EISDIR
+    );
+    let f = t.abs_z(b"file");
+    sys::unlink(ZStr::from_slice_with_nul(&f)).unwrap();
+    assert_eq!(
+        sys::unlink(ZStr::from_slice_with_nul(&f))
+            .errno_of(),
+        E::ENOENT
+    );
