+// base64/lib.rs:112 (spare_bytes_mut → decoder → commit_spare) and runtime/webcore/encoding.rs:728
+#[test]
+fn vec_spare_bytes_base64_decode() {
+    for n in [0usize, 1, 2, 3, 15, 16, 17, 47, 48, 49] {
+        let raw: Vec<u8> = (0..n as u8).map(|i| i.wrapping_mul(37)).collect();
+        let mut enc = vec![0u8; bun_core::base64::encode_len(&raw)];
+        let wrote = bun_core::base64::encode(&mut enc, &raw);
+        enc.truncate(wrote);
+
+        // decode_alloc shape
+        let len = n + 3;
+        let mut dest: Vec<u8> = Vec::with_capacity(len);
+        // SAFETY: the decoder only writes the destination, never reads it.
+        let destination = unsafe { bun_core::vec::spare_bytes_mut(&mut dest) };
+        let result = simdutf::base64::decode(&enc, &mut destination[..len], false);
+        assert!(result.is_successful());
+        // SAFETY: on success the decoder wrote the first `result.count` (<= len) bytes.
+        unsafe { bun_core::vec::commit_spare(&mut dest, result.count) };
+        assert_eq!(dest, raw);
+
+        // Buffer.from(str, "base64") shape: reserve_spare_bytes + lenient decode
+        let outlen = enc.len().div_ceil(4) * 3;
+        let mut to: Vec<u8> = Vec::new();
+        // SAFETY: the returned spare bytes are write-only until committed.
+        let dest = unsafe { bun_core::vec::reserve_spare_bytes(&mut to, outlen) };
+        let r = simdutf::base64::decode_lenient(&enc, &mut dest[..outlen]);
+        if r.count > 0 {
+            // SAFETY: the decoder initialized the first `r.count` bytes.
+            unsafe { bun_core::vec::commit_spare(&mut to, r.count) };
+        }
+        assert_eq!(to, raw);
+    }
+}
